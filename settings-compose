#!/usr/bin/env python3
"""Write a profile's native settings.json: canonical settings plus its own layer.

Claude Code reads exactly one user settings file, CLAUDE_CONFIG_DIR/settings.json,
for every entry point -- a session, a subcommand, a session Remote Control spawns.
So the file a profile runs with is generated here instead of being handed over as a
per-launch `--settings` argument:

    settings.json = canonical (~/.claude/settings.json)
                    + settings.policy.json    (optional shared policy, usually a symlink)
                    + settings.profile.json   (this profile's own differences)
                    + ccproteus's saved model defaults

Claude Code also WRITES settings.json (/config, plugin installs, "always allow").
Before each rewrite those edits are recovered by comparing the file with the copy
last written (cache/settings.base.json) and folded into settings.profile.json, so
they stay with the profile exactly as they did when settings.json was the layer.
Keys ccproteus renders from <profile>.conf are not folded: an in-session /model or
effort choice stays session-local, as before.

Credentials never land here. Every variable the launch passes in the process
environment is left out of the `env` block, because Claude Code lets that block
override the process environment.
"""
from __future__ import annotations

import argparse
import contextlib
import copy
import fcntl
import json
import os
from pathlib import Path
import sys
import tempfile
import time

LAYER = "settings.profile.json"
# A policy several profiles share (e.g. one sandbox deny list kept in ~/.agents),
# linked into each profile that wants it. It counts as canonical: its keys are never
# folded into the layer, and an edit to one in settings.json overrides it for that
# profile just as an edit to a canonical key does (a deletion leaves a tombstone).
POLICY = "settings.policy.json"
# Deny rules only ever accumulate: a profile or policy adds them and never drops one.
PERMISSION_LISTS = {("permissions", "deny")}
# The exact bytes of settings.json as last generated or folded. A launch skips the
# fold without spawning anything when settings.json still matches it byte for byte.
BASE = "cache/settings.base.json"
# Written before settings.json and promoted after it, so an interrupted projection
# never leaves a saved copy that disagrees with the file it describes.
PENDING = "cache/settings.base.pending.json"
LOCK = "cache/.settings.lock"
BACKUPS = "backups"
KEEP_BACKUPS = 10
UNSET = "$ccproteusUnset"
# A static hook: it prints this launch's advisory when the launch left one, and
# nothing for any other entry point. No per-launch state lives in the file.
ADVISE_COMMAND = '[ -n "$CCPROTEUS_ADVISE" ] && printf "%s" "$CCPROTEUS_ADVISE" || true'
# The first release read the advisory from a file; its entry may still sit in a
# profile's generated settings.
ADVISE_COMMANDS = (ADVISE_COMMAND, 'f="$CCPROTEUS_ADVISE_FILE"; [ -n "$f" ] && [ -f "$f" ] && cat "$f" || true')
OWNED_TOP = ("model", "effortLevel", "availableModels")
OWNED_ENV = ("ANTHROPIC_MODEL", "CLAUDE_CODE_EFFORT_LEVEL")
MISSING = object()


def load(path: Path) -> dict:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except FileNotFoundError:
        return {}
    if not isinstance(value, dict):
        raise ValueError(f"{path}: root is not a JSON object")
    return value


class PolicyError(ValueError):
    """A configured policy cannot be read; launching without it is unsafe."""


def read_policy(profile_dir: Path) -> dict:
    """The profile's linked shared policy, or {} when it links none.

    Strict on purpose: no policy entry is optional, but an entry that is there and
    cannot be read raises, because dropping it would silently drop its sandbox.
    """
    policy = profile_dir / POLICY
    # Read first: a target that vanishes must not silently drop its sandbox.
    try:
        doc = json.loads(policy.read_text(encoding="utf-8"))
    except FileNotFoundError as exc:
        try:
            policy.lstat()  # only an absent entry is optional, not a replaced link
        except FileNotFoundError:
            return {}
        except OSError as stat_exc:
            raise PolicyError(f"{policy}: {stat_exc}") from stat_exc
        else:
            raise PolicyError(f"{policy}: missing file during policy read") from exc
    except (OSError, ValueError, RecursionError) as exc:
        # Nested past the decoder's own limit is unreadable like any malformed one.
        raise PolicyError(f"{policy}: {exc}") from exc
    if not isinstance(doc, dict):
        raise PolicyError(f"{policy}: root is not a JSON object")
    doc.pop(UNSET, None)  # tombstones belong to profile layers, not to a shared policy
    return doc


def canonical_for(profile_dir: Path, canonical_path: Path) -> dict:
    doc = read_policy(profile_dir)
    base = load(canonical_path)
    try:
        return merge(base, doc, ())
    except RecursionError as exc:
        # Composing it copies its values, so a policy the decoder took can still
        # be too deep to hold. Only the policy is copied: the canonical is not to blame.
        raise PolicyError(f"{profile_dir / POLICY}: {exc}") from exc


def read_bytes(path: Path) -> bytes | None:
    try:
        return path.read_bytes()
    except FileNotFoundError:
        return None


def encode(doc: dict) -> bytes:
    return (json.dumps(doc, indent=2, ensure_ascii=False) + "\n").encode()


def write_bytes(path: Path, data: bytes) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=".settings.")
    try:
        with os.fdopen(fd, "wb") as handle:
            handle.write(data)
        os.chmod(tmp, 0o600)
        os.replace(tmp, path)
    except BaseException:
        with contextlib.suppress(OSError):
            os.unlink(tmp)
        raise


def settle(profile_dir: Path) -> None:
    """Finish or discard a projection that was interrupted between its writes."""
    pending = profile_dir / PENDING
    data = read_bytes(pending)
    if data is None:
        return
    if read_bytes(profile_dir / "settings.json") == data:
        os.replace(pending, profile_dir / BASE)
    else:
        pending.unlink()


def save_base(profile_dir: Path, data: bytes) -> None:
    if read_bytes(profile_dir / BASE) != data:
        write_bytes(profile_dir / BASE, data)


def without_inherited_hooks(layer: dict, canonical: dict) -> dict:
    """A profile adds hooks; it never shadows an inherited command identity."""
    layer = copy.deepcopy(layer)
    for event, entries in list((layer.get("hooks") or {}).items()):
        inherited = {(group.get("matcher", ""), hook.get("command"))
                     for group in (canonical.get("hooks") or {}).get(event, [])
                     for hook in group.get("hooks", [])}
        kept = []
        for group in entries:
            hooks = [hook for hook in group.get("hooks", [])
                     if (group.get("matcher", ""), hook.get("command")) not in inherited]
            if hooks:
                kept.append({**group, "hooks": hooks})
        if kept:
            layer["hooks"][event] = kept
        else:
            del layer["hooks"][event]
    if "hooks" in layer and not layer["hooks"]:
        del layer["hooks"]
    return layer


def merge(base: dict, override: dict, path: tuple = ()) -> dict:
    """Deep merge with special handling for hook and permission lists.

    Dicts are merged recursively. Lists under .hooks.* are appended (profile additions
    come after canonical hooks), allowing profiles to add hooks without duplicating the
    canonical set. permissions.deny combines without duplicates, as Claude Code combines
    it across its own settings scopes, so a profile or policy adds deny rules and never
    drops canonical ones. Other lists replace.
    """
    result = dict(base)
    for key, value in override.items():
        current_path = path + (key,)

        if isinstance(value, dict) and isinstance(result.get(key), dict):
            result[key] = merge(result[key], value, current_path)
        elif isinstance(value, list) and isinstance(result.get(key), list):
            # Append lists under .hooks.* instead of replacing
            if len(current_path) >= 2 and current_path[0] == "hooks":
                result[key] = result[key] + value
            elif current_path in PERMISSION_LISTS:
                result[key] = result[key] + [v for v in value if v not in result[key]]
            else:
                result[key] = copy.deepcopy(value)
        else:
            result[key] = copy.deepcopy(value)
    return result


def without_advise(doc: dict) -> dict:
    """The document with ccproteus's own SessionStart entry taken out."""
    doc = copy.deepcopy(doc)
    hooks = doc.get("hooks")
    if isinstance(hooks, dict) and isinstance(hooks.get("SessionStart"), list):
        kept = [entry for entry in hooks["SessionStart"] if not is_advise(entry)]
        if kept:
            hooks["SessionStart"] = kept
        else:
            del hooks["SessionStart"]
            if not hooks:
                del doc["hooks"]
    return doc


def is_advise(entry) -> bool:
    return (isinstance(entry, dict) and isinstance(entry.get("hooks"), list) and
            any(isinstance(h, dict) and h.get("command") in ADVISE_COMMANDS for h in entry["hooks"]))


def owned(path: tuple, mapping: set) -> bool:
    if path and path[0] == "hooks":
        # Hooks flow one way: canonical -> profile. A profile's settings.json
        # always carries canonical hooks plus the layer's own (appended by
        # merge()), so folding edits back out of it would re-capture canonical
        # hooks into the layer and double them on the next build.
        return True
    if len(path) == 1:
        return path[0] in OWNED_TOP
    if path[0] == "env" and len(path) == 2:
        return path[1] in OWNED_ENV or path[1] in mapping
    if path[0] == "modelSettings" and len(path) == 3:
        return path[2] == "effortLevel"
    return False


def get_path(doc: dict, path: tuple):
    node = doc
    for key in path:
        if not isinstance(node, dict) or key not in node:
            return MISSING
        node = node[key]
    return node


def set_path(doc: dict, path: tuple, value) -> None:
    node = doc
    for key in path[:-1]:
        if not isinstance(node.get(key), dict):
            node[key] = {}
        node = node[key]
    node[path[-1]] = copy.deepcopy(value)


def delete_path(doc: dict, path: tuple) -> bool:
    node = doc
    for key in path[:-1]:
        if not isinstance(node, dict) or key not in node:
            return False
        node = node[key]
    if isinstance(node, dict) and path[-1] in node:
        del node[path[-1]]
        return True
    return False


def tombstones(layer: dict) -> list[tuple]:
    raw = layer.get(UNSET, [])
    return [tuple(p) for p in raw if isinstance(p, list) and p and all(isinstance(k, str) for k in p)]


def without_tombstones(layer: dict) -> dict:
    """A layer's own content: its tombstones describe deletions, not values."""
    return {k: v for k, v in layer.items() if k != UNSET}


def apply_tombstones(doc: dict, layer: dict) -> None:
    """Delete what this layer tombstones. Hooks are exempt: they only ever accumulate."""
    for path in tombstones(layer):
        if path[0] != "hooks":
            delete_path(doc, path)


def merged_view(paths) -> dict:
    """What settings.json would hold for these layers, canon first: the merge plus
    every layer's tombstones -- except a shared policy's, which belong to profile
    layers and are dropped where it is composed (canonical_for). The one reading
    readers outside this file share."""
    data: dict = {}
    for path in paths:
        try:
            layer = json.loads(Path(path).read_text(encoding="utf-8"))
        except Exception:
            continue
        if not isinstance(layer, dict):
            continue
        data = merge(data, without_tombstones(layer), ())
        if Path(path).name == POLICY:
            continue
        apply_tombstones(data, layer)
    return data


def set_tombstones(layer: dict, paths: list[tuple]) -> None:
    unique = sorted(set(paths))
    if unique:
        layer[UNSET] = [list(p) for p in unique]
    else:
        layer.pop(UNSET, None)


def fold(base: dict, current: dict, layer: dict, canonical: dict, mapping: set) -> dict:
    """Carry edits made to settings.json since `base` into the profile layer."""
    layer = copy.deepcopy(layer)
    unset = tombstones(layer)

    def walk(b: dict, c: dict, path: tuple) -> None:
        for key in list(dict.fromkeys([*b, *c])):
            here = path + (key,)
            if owned(here, mapping):
                continue
            before, after = b.get(key, MISSING), c.get(key, MISSING)
            if before == after:
                continue
            if isinstance(before, dict) and isinstance(after, dict):
                walk(before, after, here)
            elif after is MISSING:
                delete_path(layer, here)
                if get_path(canonical, here) is not MISSING:
                    unset.append(here)
            else:
                if here in PERMISSION_LISTS and isinstance(after, list):
                    # merge() adds canonical rules back; keep only the profile's own
                    canon = get_path(canonical, here)
                    after = [r for r in after if not (isinstance(canon, list) and r in canon)]
                set_path(layer, here, after)
                unset[:] = [p for p in unset if p[:len(here)] != here]

    walk(without_advise(base), without_advise(current), ())
    set_tombstones(layer, unset)
    return layer


def acw_valid(value) -> bool:
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        return False
    if isinstance(value, float) and (value != value or value in (float("inf"), float("-inf"))
                                     or value != int(value)):
        return False
    return 100_000 <= int(value) <= 1_000_000


def build(canonical: dict, layer: dict, saved: dict, strip: set, mapping: set,
          acw: int | None) -> dict:
    layer = without_inherited_hooks(layer, canonical)
    data = merge(canonical, without_tombstones(layer), ())
    apply_tombstones(data, layer)
    for key in ("model", "effortLevel"):
        data.pop(key, None)
    for row in (data.get("modelSettings") or {}).values():
        if isinstance(row, dict):
            row.pop("effortLevel", None)
    env = data.get("env")
    if isinstance(env, dict):
        for key in (*OWNED_ENV, *mapping):
            env.pop(key, None)
    data = merge(data, saved, ())
    env = data.get("env")
    if isinstance(env, dict):
        for key in strip:
            env.pop(key, None)
        if not env:
            del data["env"]
    if acw is not None and not acw_valid(data.get("autoCompactWindow")):
        data["autoCompactWindow"] = acw
    hooks = data.setdefault("hooks", {})
    if isinstance(hooks, dict):
        entries = hooks.setdefault("SessionStart", [])
        if isinstance(entries, list):
            entries.append({"hooks": [{"type": "command", "command": ADVISE_COMMAND}]})
    return data


def backup(profile_dir: Path, content: bytes) -> None:
    folder = profile_dir / BACKUPS
    folder.mkdir(parents=True, exist_ok=True)
    stamp = time.strftime("%Y%m%dT%H%M%S") + f".{time.time_ns() % 1_000_000:06d}"
    target = folder / f"settings.{stamp}.json"
    target.write_bytes(content)
    os.chmod(target, 0o600)
    old = sorted(folder.glob("settings.*.json"))
    for stale in old[:-KEEP_BACKUPS]:
        with contextlib.suppress(OSError):
            stale.unlink()


@contextlib.contextmanager
def locked(profile_dir: Path):
    path = profile_dir / LOCK
    path.parent.mkdir(parents=True, exist_ok=True)
    fd = os.open(path, os.O_CREAT | os.O_RDWR, 0o600)
    try:
        fcntl.flock(fd, fcntl.LOCK_EX)
        yield
    finally:
        os.close(fd)


def capture(profile_dir: Path, current: dict | None, canonical: dict, mapping: set) -> dict:
    """The profile layer with every edit made to settings.json since it was generated.

    A missing settings.json is not an edit: it only means there is nothing to read,
    and the next projection writes it again.
    """
    layer_path, base_path = profile_dir / LAYER, profile_dir / BASE
    if base_path.exists() or layer_path.exists():
        # settings.json is generated (a removed layer starts empty), so only what
        # changed since the last projection belongs to the profile.
        layer = load(layer_path)
        if base_path.exists() and current is not None:
            layer = fold(load(base_path), current, layer, canonical, mapping)
        return layer
    # First run: the old settings.json WAS the profile layer.
    return without_inherited_hooks(without_advise(current or {}), canonical)


def read_current(target: Path) -> tuple[bytes | None, dict | None]:
    raw = read_bytes(target)
    if raw is None:
        return None, None
    doc = json.loads(raw)
    if not isinstance(doc, dict):
        raise ValueError(f"{target}: root is not a JSON object")
    return raw, doc


def carries_policy(profile_dir: Path, policy: dict) -> bool:
    """Whether the settings.json generated last time already enforces `policy`, as the
    profile's own layer adjusts it. Only then may a launch that cannot regenerate
    settings start with them."""
    if not policy:
        return True
    try:
        _, current = read_current(profile_dir / "settings.json")
        if current is None:
            return False
        layer = load(profile_dir / LAYER)
        # What the policy means for this profile: the layer adjusts its values, and a
        # tombstone is the profile deleting one of them. merge() shares the base's
        # nested dicts, so the deletion needs a copy: the walk below reads every leaf
        # of the policy, and a tombstone must not remove one from it.
        expected = merge(copy.deepcopy(policy), without_tombstones(layer), ())
        apply_tombstones(expected, layer)

        def held(value, here: tuple) -> bool:
            if isinstance(value, dict) and value:
                return all(held(item, here + (key,)) for key, item in value.items())
            if (here[:1] == ("hooks",) or here in PERMISSION_LISTS) and isinstance(value, list):
                # Hooks only ever accumulate: several layers append to the same list, so a
                # policy's entry is carried when it is still somewhere in it.
                generated = get_path(current, here)
                return isinstance(generated, list) and all(entry in generated for entry in value)
            return get_path(current, here) == get_path(expected, here)

        return held(policy, ())
    except Exception:
        # Everything that stops the comparison -- an unreadable file, a layer ccproteus
        # cannot parse, a policy nested past what the readers can walk (#318) -- is not
        # carried: a launch must not start on a guess, and this walk not finishing is one.
        return False


def refuse_symlinks(profile_dir: Path) -> None:
    if (profile_dir / "settings.json").is_symlink() or (profile_dir / LAYER).is_symlink():
        raise ValueError("profile settings must be regular files")


def save_layer(profile_dir: Path, layer: dict) -> None:
    path = profile_dir / LAYER
    if not path.exists() or load(path) != layer:
        write_bytes(path, encode(layer))


def fold_only(profile_dir: Path, canonical_path: Path, mapping: set) -> None:
    """Carry pending edits into the layer so readers see them before a launch."""
    refuse_symlinks(profile_dir)
    with locked(profile_dir):
        settle(profile_dir)
        raw, current = read_current(profile_dir / "settings.json")
        save_layer(profile_dir, capture(profile_dir, current, canonical_for(profile_dir, canonical_path), mapping))
        # The saved copy now matches what the layer holds, so the same edits are
        # never folded twice.
        if raw is not None and (profile_dir / BASE).exists():
            save_base(profile_dir, raw)


def materialize(profile_dir: Path, canonical_path: Path, saved: dict, strip: set,
                mapping: set, acw_arg: str | None) -> bool:
    target, base_path, pending = profile_dir / "settings.json", profile_dir / BASE, profile_dir / PENDING
    refuse_symlinks(profile_dir)
    with locked(profile_dir):
        settle(profile_dir)
        for _ in range(3):
            current_bytes, current = read_current(target)
            canonical = canonical_for(profile_dir, canonical_path)
            layer = capture(profile_dir, current, canonical, mapping)
            if acw_arg is None:
                # Keep the budget derived last time. The saved copy holds it whenever
                # neither layer nor canonical sets one, and a set one wins anyway.
                previous = load(base_path).get("autoCompactWindow")
                acw = int(previous) if acw_valid(previous) else None
            else:
                acw = None if acw_arg == "none" else int(acw_arg)
            doc = build(canonical, layer, saved, strip, mapping, acw)
            # Claude Code may be writing the same file; start over rather than
            # replace an edit that landed while this pass was reading.
            if read_bytes(target) != current_bytes:
                continue
            save_layer(profile_dir, layer)
            changed = doc != (current or {}) or current_bytes is None
            if not changed:
                save_base(profile_dir, current_bytes)
                return False
            if current_bytes is not None:
                backup(profile_dir, current_bytes)
            data = encode(doc)
            write_bytes(pending, data)
            write_bytes(target, data)
            os.replace(pending, base_path)
            return True
    raise ValueError(f"{target} kept changing while it was being regenerated")


def fallback_or_refuse(command: str, profile_dir: Path) -> int:
    """The exit code for a projection that failed after saying why. fold just
    fails; a launch may fall back to the settings generated last time, but only
    if they already enforce the linked policy: starting with settings that
    predate it would run without its sandbox. An unreadable policy is not
    carried either."""
    if command != "materialize":
        return 1
    try:
        kept = carries_policy(profile_dir, read_policy(profile_dir))
    except Exception:
        # carries_policy swallows its own failures; this catches the policy read,
        # and one that fails any other way is not carried either -- escaping here
        # would be the unguarded fallback again.
        kept = False
    if kept:
        return 1
    print(f"settings-compose: {profile_dir / POLICY}: "
          "the settings generated last time do not carry this policy", file=sys.stderr)
    return 3


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    sub = parser.add_subparsers(dest="command", required=True)
    m = sub.add_parser("materialize")
    m.add_argument("profile_dir", type=Path)
    m.add_argument("--canonical", type=Path, default=Path.home() / ".claude" / "settings.json")
    m.add_argument("--saved", default="{}", help="ccproteus's model defaults as JSON")
    m.add_argument("--strip", action="append", default=[], help="env key the launch sets itself")
    m.add_argument("--mapping", action="append", default=[], help="tier-mapping env key ccproteus owns")
    m.add_argument("--acw", help="derived autoCompactWindow, or 'none'; omitted keeps the last one")
    f = sub.add_parser("fold")
    f.add_argument("profile_dir", type=Path)
    f.add_argument("--canonical", type=Path, default=Path.home() / ".claude" / "settings.json")
    f.add_argument("--mapping", action="append", default=[])
    args = parser.parse_args(argv)
    try:
        if args.command == "fold":
            fold_only(args.profile_dir, args.canonical, set(args.mapping))
            return 0
        saved = json.loads(args.saved)
        if not isinstance(saved, dict):
            raise ValueError("--saved must be a JSON object")
        if args.acw is not None and args.acw != "none" and not args.acw.isdigit():
            raise ValueError("--acw must be a token count or none")
        materialize(args.profile_dir, args.canonical, saved, set(args.strip),
                    set(args.mapping), args.acw)
    except PolicyError as exc:
        print(f"settings-compose: {exc}", file=sys.stderr)
        return 3
    except (OSError, ValueError) as exc:
        print(f"settings-compose: {exc}", file=sys.stderr)
        return fallback_or_refuse(args.command, args.profile_dir)
    except Exception as exc:
        # A crash -- a canonical nested past the decoder's limit, a layer whose
        # tombstones cannot be parsed -- fails the projection like the errors
        # above; a traceback the launch reads as exit 1 would start the session
        # on settings that may predate the linked policy. Name the class so the
        # crash stays visible, then hold it to the same decision.
        print(f"settings-compose: {type(exc).__name__}: {exc}", file=sys.stderr)
        return fallback_or_refuse(args.command, args.profile_dir)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
