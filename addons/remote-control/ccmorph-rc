#!/usr/bin/env python3
"""Remote Control on a claude.ai account, inference on a ccmorph route profile.

    ccmorph-rc <route-profile> [--as <account-profile>] [--route-models] [--debug] [--probe]
                [-- <remote-control args>]

Claude Code only offers Remote Control to a claude.ai-authenticated session that
talks to api.anthropic.com. This add-on keeps that true for the process, and moves
only `/v1/messages` to the route profile through a scoped TLS proxy:

  claude remote-control ──HTTPS_PROXY──▶ mitmdump (loopback, this launch only)
      api.anthropic.com/v1/messages ──▶ route profile (its ccmorph-core adapter if needed)
      every other host/path            ──▶ unchanged

Add-on, not core. It uses only public ccmorph seams: `ccmorph _route_env` /
`_route_stop` for the route profile (endpoint and credential, plus a bridge for a
provider profile), `ccmorph _env` for the account, `ccmorph _backend_env` for the names a launch
never inherits, and `ccmorph-core adapter <profile>
--auto --parent-pid`. Nothing in ccmorph knows it exists; delete this directory and
ccmorph is unchanged.

Scope guarantees:
  - the proxy CA lives in its own 0700 directory under ccmorph's state root and is
    trusted by this process tree only (NODE_EXTRA_CA_CERTS); no system trust change
  - only api.anthropic.com is intercepted; every other host is a raw CONNECT tunnel,
    so tools run inside the session keep normal TLS
  - the route key reaches the proxy through a 0600 file it deletes on read, never argv
    or the Claude process environment; so does a profile --switch hands over, and the
    proxy that took it says so in held.<edge pid>.json (no key), which is how a lost
    handoff is seen and handed again (issue #595)
  - fail closed: a dead proxy or route is an error in the session, never a silent
    fallback to the account's own quota
  - this process execs into Claude; the proxy and adapter watch its pid and exit with it
"""
from __future__ import annotations

import argparse
import fcntl
import functools
import json
import os
import re
import resource
import shutil
import signal
import socket
import stat
import subprocess
import sys
import tempfile
import time
import urllib.parse
import zlib
from contextlib import suppress
from pathlib import Path

HERE = Path(__file__).resolve().parent
# the routing decision beside this script, however it was loaded (test, install, exec)
sys.path.insert(0, str(HERE))
from rc_route import (ACCOUNT_METADATA, SESSION_ID, edge_name, route_edge,  # noqa: E402
                      switch_edge)
import rc_route  # noqa: E402  (rc_route.proc_started: the one start identity, looked up per call)
LIB_DIR = Path(os.environ.get("CCMORPH_LIB_DIR") or HERE.parent.parent / "lib")
CCMORPH = LIB_DIR / "ccmorph.sh"
ADAPTER = LIB_DIR.parent / "libexec" / "ccmorph-core"
# Same state-root resolution as ccmorph-adapter; profile .conf files live here.
STATE_ROOT = Path(os.environ.get("CCMORPH_STATE_DIR") or
                  Path(os.environ.get("XDG_CONFIG_HOME") or Path.home() / ".config") / "ccmorph")
STATE = STATE_ROOT / "profiles" / ".rc-bridge"
# One shared edge (adapter + proxy) per route, run by `ccmorph-rc <route> --edge`
# (optional). Bridges of that route reuse it instead of
# starting their own. Its port is fixed per route so a restarted edge keeps every
# bridge's HTTPS_PROXY valid; while it is down, bridges fail closed (refused).
EDGES = STATE / "edges"
# "account", "route" or a profile: where every host's inference goes, read by the proxy on each turn (--switch).
INFERENCE = STATE / "inference"


def edge_port(route: str) -> int:
    return 47100 + zlib.crc32(route.encode()) % 800


def live_edge(route: str) -> dict | None:
    """The route's shared edge if its process is alive and its proxy answers.

    A record names the route that wrote it, and one naming ANOTHER route is not
    this route's edge: on a case-insensitive volume `GW.json` and `gw.json` are
    one file, and adopting a twin's record would point this route's bridges at
    the twin's port (#846). A record from before the field existed names no
    route, so only its file's stored spelling says whose it is: it is read only
    when EDGES lists an entry spelled exactly `<edge_name(route)>.json` (the
    GH-259 rule), because on a case-insensitive volume opening `GW.json`
    succeeds on gw's old `gw.json`. A record that names its route is decided by
    that field alone: a rename on a case-folding volume may keep a twin's old
    spelling. The rule itself is rc_route.route_edge, which the proxy's fallback
    note counts with too, so the note never names a --switch this refuses (#595).
    """
    return route_edge(EDGES, route)

# By default phone sessions keep Claude Code's own aliases (fable, opus, sonnet,
# haiku -> the real Claude ids, 1:1), which the route serves by name. --route-models carries the
# route profile's alias map instead. None of these touch Remote Control eligibility.
MODEL_ENV = ("ANTHROPIC_DEFAULT_FABLE_MODEL", "ANTHROPIC_DEFAULT_OPUS_MODEL",
             "ANTHROPIC_DEFAULT_SONNET_MODEL", "ANTHROPIC_DEFAULT_HAIKU_MODEL",
             "ANTHROPIC_SMALL_FAST_MODEL", "CLAUDE_CODE_SUBAGENT_MODEL")
# Behavioural flags the route profile carries, forwarded to the session as-is. They
# describe the endpoint, not a model choice, so they apply whoever answers. Add a
# name here when a route sets it and the session must honour it. The capability mask
# belongs here for the same reason: a route that declares its own mask is describing
# the endpoint, and the adapter default below is only the gap-filler for a route that
# declares none (2026-10-14: a conf-declared mask reached every launcher but the phone).
ROUTE_ENV = ("CLAUDE_CODE_DISABLE_ADVISOR_TOOL", "CLAUDE_CODE_MODEL_CAPABILITIES")
# Same value ccmorph.sh sets on an adapter launch; see session_env.
ADAPTER_MODEL_CAPABILITIES = "-mid_conv_system,-mid_conv_tool_change,-per_turn_effort"
# Anything that would take the session off the account's own claude.ai login: the
# backend, account and credential keys ccmorph itself never lets a launch inherit
# (one list, `ccmorph _backend_env`), plus the proxy half below. CLAUDE_CODE_OAUTH_TOKEN
# matters most here: it outranks the keychain login and is inference-only, so Remote
# Control refuses it ("requires a full-scope login token").
# The proxy half of strip_env(), which only the SESSION may lose: its one proxy is
# the mitmdump below, so an inherited one would take `/v1/messages` somewhere else.
# The adapter is the opposite case — it dials the route's real endpoint, which on a
# private network is reachable only through the proxy the caller exported.
PROXY_ENV = ("HTTP_PROXY", "http_proxy", "HTTPS_PROXY", "https_proxy", "ALL_PROXY", "all_proxy")


@functools.lru_cache(maxsize=None)
def strip_env() -> tuple:
    """ccmorph's backend/credential list plus PROXY_ENV, read once from the seam."""
    # Source with local.sh skipped (the existing read-only gate) so host opt-ins
    # neither run nor print into the list; the name filter is a second guard.
    env = {**os.environ, "CCMORPH_DOCTOR_READONLY": "1"}
    out = ccmorph("_backend_env", "", 90, env)
    names = tuple(n for n in out.stdout.split() if re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", n))
    if out.returncode or not names:
        die(f"ccmorph _backend_env failed: {out.stderr.strip()}")
    return names + PROXY_ENV


def die(msg: str) -> "None":
    print(f"ccmorph-rc: {msg}", file=sys.stderr)
    sys.exit(1)


def ccmorph(cmd: str, arg: str, timeout: float, env: dict | None = None) -> subprocess.CompletedProcess:
    return subprocess.run(["zsh", "-c", f'source "$1" && ccmorph {cmd} "$2"',
                           "ccmorph-rc", str(CCMORPH), arg],
                          capture_output=True, text=True, timeout=timeout, env=env)


def profile_env(profile: str, cmd: str = "_env") -> dict[str, str]:
    # 180s for _route_env: a provider profile starts its bridge process first.
    out = ccmorph(cmd, profile, 180 if cmd == "_route_env" else 90)
    if out.returncode:
        die(f"ccmorph {cmd} {profile} failed: {out.stderr.strip()}")
    return dict(line.split("=", 1) for line in out.stdout.splitlines() if "=" in line)


def resolve_route(profile: str) -> dict[str, str]:
    """The route profile's endpoint and credential, ready to dial.

    `_route_env`, not `_env`: a provider profile has no endpoint until ccmorph
    starts its bridge, and only `_route_env` starts one (and hands back a handle).
    """
    return profile_env(profile, "_route_env")


def retire_route_with(pid: int, handle: str) -> None:
    """Stop the route once `pid` (Claude, after exec) is gone. This process execs
    away, so a detached watcher owns the `_route_stop` a launch's EXIT trap would do."""
    if not handle:
        return
    watcher = ('while kill -0 "$3" 2>/dev/null; do sleep 2; done; '
               'source "$1" && ccmorph _route_stop "$2"')
    subprocess.Popen(["zsh", "-c", watcher, "ccmorph-rc", str(CCMORPH), handle, str(pid)],
                     stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                     stderr=subprocess.DEVNULL, start_new_session=True)


def adapter_env() -> dict[str, str]:
    """No inherited credential, but the caller's proxy intact — exactly what
    `_ccm_adapter_start` gives it, which is the launcher's own environment."""
    return {k: v for k, v in os.environ.items()
            if k not in strip_env() or k in PROXY_ENV}


def plugin_dirs(env) -> str:
    """The session's plugin path, as `ccmorph run` would set it."""
    out = subprocess.run([str(ADAPTER), "cli", "_plugin_dirs"], env=env,
                         capture_output=True, text=True)
    if out.returncode != 0 or not out.stdout.strip():
        die(f"ccmorph-core cli _plugin_dirs failed: {out.stderr.strip() or out.returncode}")
    return out.stdout.strip()


def session_env(base, route_env: dict, route_models: bool) -> dict:
    """The session's env: no inherited credentials, model aliases left to Claude Code
    (1:1 real Claude ids) unless --route-models asks for the route's map, and the
    route's behavioural flags either way — a flag the route sets describes the
    endpoint being dialed, so it must not hinge on how aliases are chosen."""
    # Model aliases are Claude Code's own (1:1 real Claude ids) unless --route-models
    # asks for the route's map. The one thing carried in from the caller is a tier the
    # supervisor pinned (the route profile's out-of-family tiers, overridden by
    # `tier.<alias>=<model>` in rc-hosts): forwarding an alias the route cannot serve is
    # the caller's call, and it names the alias explicitly.
    env = {k: v for k, v in base.items() if k not in strip_env()}
    env.update({k: route_env[k] for k in ROUTE_ENV if k in route_env})
    # Message threads: on a first-party login Claude Code may send only the newest
    # turn plus `thread: continue`, trusting Anthropic's server to hold the rest. A
    # route has no such state, so every turn after the first reaches it with no
    # system prompt, tools or history (2026-10-06: every phone session lost its
    # context mid-conversation). The full conversation must be sent every time.
    env["CLAUDE_CODE_TETHER_LIVE"] = "0"
    # Every route here is served through ccmorph-adapter, whose cliproxyapi config
    # hoists mid-conversation system turns into the top-level system field. That
    # rewrites the prompt prefix each turn and defeats prompt caching, so the session
    # gets the same default a ccmorph adapter launch gets: no model id sends
    # those turns. A value the caller set wins.
    env.setdefault("CLAUDE_CODE_MODEL_CAPABILITIES", ADAPTER_MODEL_CAPABILITIES)
    # Likewise the advisor: a server-side tool the adapter's routes do not serve.
    env.setdefault("CLAUDE_CODE_DISABLE_ADVISOR_TOOL", "1")
    pinned = {k: v for k, v in base.items() if k in MODEL_ENV}
    env.update(pinned)
    if route_models:
        env.update({k: route_env[k] for k in MODEL_ENV if k in route_env})
    # The seam to a launch nested in this session: it inherits our loopback proxy, so
    # it must get the flags this session was given. The EFFECTIVE values, defaults
    # included -- an edge record holds only what the route's conf declares.
    # ccmorph.sh re-applies exactly these lines (_ccm_nested_edge_env).
    env["CCMORPH_EDGE_ROUTE_ENV"] = "\n".join(f"{k}={env[k]}" for k in ROUTE_ENV if k in env)
    return env

def pinned_tiers(base) -> dict[str, str]:
    """{alias: model} for the tiers the caller pinned, so the proxy can pin the full
    ids (claude-fable-5-1) the phone's picker sends, not only the bare alias."""
    return {k.split("_")[2].lower(): (v[:-4] if v.endswith("[1m]") else v) for k, v in base.items()
            if k in MODEL_ENV and k.startswith("ANTHROPIC_DEFAULT_") and v}


def profile_field(profile: str, field: str) -> str:
    """One `field=value` from the profile's conf, or "" when the file is missing
    or cannot be read as text. An unreadable (mode 000) or undecodable conf is no
    field, not a crash: the hosts supervisor resolves its account through here at
    every config reload, so one damaged profile file ended it every time and
    launchd restarted it into the same crash (GH-845). The cause reaches the
    supervisor's log (stderr is merged into rc-hosts.log) once per lookup."""
    conf = STATE_ROOT / f"{profile}.conf"
    try:
        text = conf.read_text() if conf.exists() else ""
    except (OSError, UnicodeDecodeError) as e:
        print(f"ccmorph-rc: {conf}: unreadable ({e}); treating it as no {field}", file=sys.stderr)
        return ""
    for line in text.splitlines():
        if line.startswith(field + "="):
            return line.split("=", 1)[1].strip()
    return ""


def profile_type(profile: str) -> str:
    return profile_field(profile, "type")


def account_candidates() -> list[str]:
    """The Claude account profiles on the machine, listed without refusing.
    The rc-hosts supervisor resolves `inference=<account>` from its reload
    branch, where default_account()'s refusal would exit a long-lived process
    over a config edit (issue #596); a CLI caller that ends anyway still uses
    default_account()."""
    return sorted(p.stem for p in STATE_ROOT.glob("*.conf") if profile_type(p.stem) == "sub")


def default_account() -> str:
    subs = account_candidates()
    if not subs:
        # There is nothing to pass --as yet, so the refusal names the command that
        # creates the profile instead (issue #276).
        die("no Claude account profiles found — Remote Control signs the session in with one; "
            "create it with 'ccmorph add <name>' and choose 'Claude account'")
    if len(subs) > 1:
        die(f"pass --as <profile>; Claude account profiles found: {', '.join(subs)}")
    return subs[0]


def free_port() -> int:
    with socket.socket() as s:
        s.bind(("127.0.0.1", 0))
        return s.getsockname()[1]


def wait_listening(port: int, proc: subprocess.Popen, what: str, limit: float = 20) -> None:
    deadline = time.monotonic() + limit
    while time.monotonic() < deadline:
        if proc.poll() is not None:
            die(f"{what} exited during startup (rc={proc.returncode})")
        with socket.socket() as s:
            if s.connect_ex(("127.0.0.1", port)) == 0:
                return
        time.sleep(0.1)
    die(f"{what} did not start listening within {limit:.0f}s")


def seed_trust(account_dir: str, folder: str) -> None:
    """Record the folder as trusted in the account's config.

    An unattended Remote Control start in an untrusted folder waits on a trust
    prompt nobody can answer; the folder then never registers. Whoever launched
    ccmorph-rc here chose the folder, so trusting it is their intent.
    """
    cfg = Path(account_dir) / ".claude.json"
    try:
        data = json.loads(cfg.read_text()) if cfg.exists() else {}
        if not isinstance(data, dict):
            return
    except (OSError, ValueError):
        return
    entry = data.setdefault("projects", {}).setdefault(str(Path(folder).resolve()), {})
    if entry.get("hasTrustDialogAccepted"):
        return
    entry["hasTrustDialogAccepted"] = True
    tmp = cfg.with_name(cfg.name + ".tmp")
    # The file holds the account's identity: 0600 from creation, never the umask's mode.
    try:
        mode = stat.S_IMODE(cfg.stat().st_mode) & 0o600
    except OSError:
        mode = 0o600
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, mode or 0o600)
    with os.fdopen(fd, "w") as fh:
        fh.write(json.dumps(data, indent=2))
    os.chmod(tmp, mode or 0o600)
    tmp.replace(cfg)


POINTER_TTL = 3 * 3600   # Claude drops its bridge pointer after 4h


def keep_host(account_dir: str, folder: str) -> None:
    """One folder, one host: `.claude/rc-host.json` in the folder names its environment.

    Claude reattaches a restarted host (same row in the app, its session adopted,
    none created) only from its own bridge pointer, which it drops after 4h or a
    fatal error. A fresh pointer is copied into the folder's file; a missing or
    stale one is put back from it. The file travels with the folder.
    """
    pointer = (Path(account_dir) / "projects" /
               re.sub(r"[^A-Za-z0-9]", "-", str(Path(folder).resolve())) / "bridge-pointer.json")
    kept = Path(folder) / ".claude" / "rc-host.json"
    fresh = pointer.exists() and time.time() - pointer.stat().st_mtime < POINTER_TTL
    src, dst = (pointer, kept) if fresh else (kept, pointer)
    try:
        data = json.loads(src.read_text())
    except (OSError, ValueError):
        return
    for key in ("pid", "procStart"):
        data.pop(key, None)
    dst.parent.mkdir(parents=True, exist_ok=True)
    dst.write_text(json.dumps(data))


class AdapterURL(str):
    """start_adapter's loopback URL, carrying the adapter's pid: the sidecar ledger
    records the process it may later retire (issue #595). Still a str, so a caller
    that wants only the URL is unchanged."""
    pid: int | None = None

    def __new__(cls, url: str, pid: int | None = None) -> "AdapterURL":
        made = super().__new__(cls, url)
        made.pid = pid
        return made


def start_adapter(route: str, parent: int, env: dict[str, str]) -> str:
    """Return the loopback URL of the route's gateway edge (see shim), as an
    AdapterURL naming the adapter's pid."""
    ready = tempfile.NamedTemporaryFile(prefix="ccmorph-rc-ready.", delete=False)
    # --model, as a normal ccmorph launch passes it: the adapter then verifies one
    # (cached) model. Without it every launch re-probes the whole gateway inventory,
    # which overruns the adapter's 30s budget as soon as a few bridges start at once.
    model = profile_field(route, "model")
    # The adapter outlives this command; an inherited stderr would hold the caller's
    # pipe open (`ccmorph-rc X --switch 2>&1 | tail` never returned), so it gets a log.
    (STATE / "logs").mkdir(parents=True, exist_ok=True)
    with open(STATE / "logs" / f"adapter-{route}.log", "ab") as log:
        proc = subprocess.Popen([str(ADAPTER), "adapter", route, "--auto", "--parent-pid", str(parent),
                                 *(["--model", model] if model else [])],
                                env=env, stdin=subprocess.DEVNULL, stdout=ready, stderr=log,
                                start_new_session=True)
    deadline = time.monotonic() + 120
    try:
        while time.monotonic() < deadline:
            line = Path(ready.name).read_text().splitlines()[:1]
            if line and line[0].startswith("PORT="):
                return AdapterURL(f"http://127.0.0.1:{int(line[0][5:])}", proc.pid)
            if line and line[0].startswith("EXIT="):
                die(f"adapter declined: {line[0][5:]}")
            if proc.poll() is not None:
                die(f"adapter exited without a port (rc={proc.returncode})")
            time.sleep(0.1)
        proc.terminate()
        die("adapter did not become ready within 120s")
    finally:
        os.unlink(ready.name)


def our_adapter(pid: int, profile: str, edge: int) -> bool:
    """Whether `pid` is the sidecar start_adapter launched for `profile` beside edge
    `edge`, per its own argv: `<...>/ccmorph-core adapter <profile> ... --parent-pid
    <edge>`. A word found anywhere in argv is no proof (issue #595: 'adapter
    different-profile --model oli --parent-pid 777' passed), and a signal must never
    reach a stranger."""
    try:
        ps = subprocess.run(["ps", "-p", str(pid), "-o", "command="],
                            capture_output=True, text=True, errors="replace", timeout=10).stdout
    except (OSError, ValueError, subprocess.SubprocessError):
        return False
    argv = ps.split()
    if len(argv) < 3 or not argv[0].endswith("/ccmorph-core") or argv[1:3] != ["adapter", profile]:
        return False
    flags = argv[3:]
    return "--parent-pid" in flags and flags[flags.index("--parent-pid") + 1:][:1] == [str(edge)]


def edge_started(pid: int) -> str | None:
    """The identity of the edge process at `pid`, beyond its number: the moment it
    started (rc_route.proc_started). It cannot change while the process lives, and
    the next process the OS gives that number starts at another moment, so nothing
    made beside an edge is taken for the next edge's (issue #595)."""
    return rc_route.proc_started(pid)


def _listening(upstream: str) -> bool:
    """Whether an upstream URL's port answers: proof the adapter behind it serves."""
    target = urllib.parse.urlsplit(upstream)
    try:
        with socket.create_connection((target.hostname, target.port), timeout=1):
            return True
    except (OSError, ValueError, TypeError):
        return False


def _retire(pid: int) -> None:
    """Stop a replaced sidecar and confirm it is gone -- TERM then KILL, polled --
    before its replacement starts. An orphaned adapter keeps its port and its old
    endpoint answerable forever (issue #595); a switch that cannot clear the old
    one refuses to double rather than leave both serving."""
    for sig, tries in ((signal.SIGTERM, 50), (signal.SIGKILL, 50)):
        try:
            os.kill(pid, sig)
        except ProcessLookupError:
            return                        # gone between the look and the signal: it retired itself
        except OSError:
            pass                          # cannot signal it: the probe below decides
        for _ in range(tries):
            try:
                os.kill(pid, 0)
            except ProcessLookupError:
                return
            time.sleep(0.1)
    die(f"sidecar adapter {pid} will not exit; the switch is refused rather than doubled (issue #595)")


def sidecar(profile: str, owner: int, started: str) -> tuple[str, int | None]:
    """The (upstream, pid) of the ONE adapter serving `profile` beside edge `owner`.

    Every `--switch` used to start another adapter and orphan the last beside the
    same edge (issue #595). sidecar-<profile>.json is the ledger: reuse the adapter
    while it is ours (its own argv), belongs to this edge process (pid and start)
    and answers; else retire it -- confirmed gone -- and start exactly one
    replacement. The read, the start and the record are one step under a
    per-profile lock, so two overlapping switches cannot both start one; a record
    that cannot be written stops the new adapter rather than leave it unrecorded."""
    STATE.mkdir(mode=0o700, parents=True, exist_ok=True)
    # edge_name keeps a profile name whole: safe_part merged api_eu and api__eu onto
    # one ledger, so switching between them doubled the first's adapter (#595 review).
    ledger = STATE / f"sidecar-{edge_name(profile)}.json"
    with open(STATE / f".sidecar-{edge_name(profile)}.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)          # released when the file closes
        if edge_started(owner) != started:        # the edge may have been replaced while we waited
            die(f"edge {owner} was replaced while this switch waited; nothing was changed -- run "
                f"`ccmorph-rc {profile} --switch` again to hand {profile} to the edge live now (issue #595)")
        try:
            rec = json.loads(ledger.read_text())
            old, edge, url = int(rec["pid"]), int(rec["edge"]), str(rec["upstream"])
            was = rec.get("edge_started")
        except (OSError, ValueError, KeyError, TypeError):   # no record, or one naming no pid
            old = edge = -1
            url, was = "", None
        if (old >= 0 and edge == owner and was == started
                and our_adapter(old, profile, edge) and _listening(url)):
            return url, old
        if old >= 0 and our_adapter(old, profile, edge):
            _retire(old)
        upstream = start_adapter(profile, owner, adapter_env())
        pid = getattr(upstream, "pid", None)
        try:
            write_json(ledger, {"pid": pid, "upstream": str(upstream), "edge": owner, "edge_started": started})
        except OSError as e:
            if pid is not None:
                _retire(pid)
            die(f"sidecar record not written ({e}); its new adapter was stopped, not left unrecorded")
        return str(upstream), pid


# The addon is the only thing standing between Claude and api.anthropic.com. Two
# ways it can go missing while the proxy keeps running, each observed live:
#  - mitmproxy hot-reloads a -s script when its file changes, and a failed reload
#    leaves the proxy running with NO addon (an upgrade of this directory did it);
#  - any other load error after startup.
# Either way the proxy would forward inference to Anthropic on the account's own
# credential. So the proxy runs a private copy that nothing else writes, and a
# built-in block_list answers 502 to any /v1/messages still addressed to
# api.anthropic.com. A rerouted request carries the route's host, so it never
# matches. The account word is a legitimate first-party call on that very
# destination: the addon marks the flow it leaves untouched, and the guard exempts
# that mark. Only the addon sets it, so a missing addon still matches and closes.
FAIL_CLOSED = (rf"|(~d ^api\.anthropic\.com$ & ~u /v1/messages & !~meta {ACCOUNT_METADATA})"
               "|502")


def owned_prefix(kind: str) -> str:
    """A per-launch file's prefix names its launcher, so a later start can tell it is orphaned."""
    return f"{kind}.{os.getpid()}."


def sweep_handoffs(parent: Path) -> None:
    """Remove every switch-<profile>.json naming an edge process that no longer runs
    (its pid gone, or given to another process: another start). A switch killed
    between its publish and its cleanup leaves the route key there, and no proxy
    will ever take a handoff for an edge that is gone (issue #595 review). Under the
    switch lock, so no switch is publishing meanwhile; a handoff for the live edge --
    a newer publication -- is kept."""
    with open(parent / ".switch.lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)              # released when the file closes
        for hand in parent.glob("switch-*.json"):
            try:
                h = json.loads(hand.read_text())
                edge, started = int(h["edge"]), h["edge_started"]
            except OSError:
                continue                              # taken meanwhile, or unreadable this once
            except (ValueError, KeyError, TypeError, AttributeError):
                edge, started = -1, None              # names no edge: nothing can ever take it
            if edge > 0 and not _edge_gone(edge, started):
                continue                              # a live edge's, or one we cannot judge: kept
            with suppress(OSError):
                hand.unlink()


def _edge_gone(pid: int, started) -> bool:
    """Proof that the edge process `started` at `pid` is gone: no process holds the
    pid, or the one that does started at another moment. A start that merely cannot
    be read this once proves nothing, so the handoff of a live edge is never taken
    away on it (REVIEW.md: a shared resource torn down on transient evidence)."""
    now = edge_started(pid)
    if now is not None:
        return now != started
    try:
        os.kill(pid, 0)
    except ProcessLookupError:
        return True
    except OSError:
        pass
    return False


def _taker_replaced(path: Path, pid: int) -> bool:
    """Proof that the proxy which was taking a handoff (taken.<pid>.<start tag>.
    <profile>.json) is gone though its pid runs: the process at that pid started at
    another moment (rc_route.start_tag). A tag of "unknown", a name without a tag,
    or a start that cannot be read proves nothing, and the pid check decides (issue
    #595 review: a proxy killed mid-take kept its key on disk once the OS gave its
    pid to another process)."""
    parts = path.name.split(".")
    if len(parts) < 5 or parts[2] == "unknown":
        return False
    now = rc_route.proc_started(pid)
    return now is not None and rc_route.start_tag(now) != parts[2]


def sweep_orphans(parent: Path) -> None:
    """Remove the route keys and addon copies of launchers that are gone, the
    held.<edge pid>.json a proxy wrote for an edge that is gone, a handoff a proxy
    that is gone was taking (taken.<proxy pid>.<start tag>.*: gone by its pid, or by
    its start once the pid is another process's) and the handoffs of edges that are
    gone (issue #595). Every exit removes its own, but a SIGKILL or a power cut
    cannot, and a key must not linger; a held record holds no key, but it must not
    outlive its edge either."""
    sweep_handoffs(parent)
    for path in [*parent.glob("route-key.*"), *parent.glob("addon.*"), *parent.glob("held.*"),
                 *parent.glob("taken.*")]:
        pid = path.name.split(".")[1]
        if not pid.isdigit():
            continue
        if path.name.startswith("taken.") and _taker_replaced(path, int(pid)):
            with suppress(OSError):
                path.unlink()
            continue
        try:
            os.kill(int(pid), 0)
            continue
        except PermissionError:
            continue
        except ProcessLookupError:
            pass
        if path.is_dir():
            shutil.rmtree(path, ignore_errors=True)
        else:
            with suppress(OSError):
                path.unlink()


def private_addon(parent: Path) -> Path:
    """Copy the addon and its module into a fresh 0700 directory; return the script."""
    run = Path(tempfile.mkdtemp(prefix=owned_prefix("addon"), dir=parent))
    for name in ("rc_addon.py", "rc_flow.py", "rc_route.py"):
        # copy, not copy2: mitmproxy loads a -s script only if its mtime beats its
        # last load (0), so a source delivered with epoch timestamps never loads.
        shutil.copy(HERE / name, run / name)
    return run / "rc_addon.py"


def proxy_command(mitmdump: str, port: int, confdir: Path, script: Path) -> list[str]:
    return [mitmdump, "-q", "--listen-host", "127.0.0.1", "--listen-port", str(port),
            "--set", f"confdir={confdir}", "--set", f"block_list={FAIL_CLOSED}",
            "--allow-hosts", r"^api\.anthropic\.com(:443)?$", "-s", str(script)]


def stop_proxy(proc) -> None:
    """Stop the proxy a failed start spawned. The addon is what follows our pid, and
    it reads the route key on load: once the key is gone it never loads, so nothing
    else would stop this proxy (on --edge it would hold the fixed port for good)."""
    proc.terminate()
    try:
        proc.wait(timeout=5)
    except subprocess.TimeoutExpired:
        proc.kill()
        proc.wait()


def own_edge(route: str, me: int, args, fixed_port: int | None):
    """Route + adapter + proxy for one bridge (or, with fixed_port, the shared edge)."""
    route_env = resolve_route(route)
    # From here the route is up; tie its teardown to this pid before anything can die.
    retire_route_with(me, route_env.get("CCMORPH_ROUTE_HANDLE", ""))
    key = route_env.get("ANTHROPIC_API_KEY") or die(f"route profile '{route}' has no key")
    route_env.get("ANTHROPIC_BASE_URL") or die(f"route profile '{route}' has no endpoint")

    mitmdump = shutil.which("mitmdump") or die("mitmdump not found: brew install mitmproxy")

    upstream = start_adapter(route, me, adapter_env())

    STATE.mkdir(parents=True, exist_ok=True)
    STATE.chmod(0o700)
    sweep_orphans(STATE)
    confdir = STATE / "mitm"
    confdir.mkdir(exist_ok=True)
    confdir.chmod(0o700)
    # finally handles Python exceptions, but the default TERM/HUP/QUIT disposition
    # exits without unwinding. Block them across mkstemp + assignment, install cleanup
    # handlers, then unblock: even a pending signal cannot land in the tiny window
    # between the file being created and key_file receiving its name.
    startup_signals = (signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT)
    # Ctrl-C is blocked across the same windows (it is only deferred, never handled
    # here): a KeyboardInterrupt raised inside mkstemp leaves the file with no name.
    blocked = (*startup_signals, signal.SIGINT)
    old_mask = signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
    old_handlers = {sig: signal.getsignal(sig) for sig in startup_signals}
    # Only a signal left at SIG_DFL ends the process without unwinding. One the
    # caller ignores (nohup ignores HUP) stays ignored: it cannot leave the key behind.
    taken = [sig for sig in startup_signals if old_handlers[sig] == signal.SIG_DFL]
    key_file = None
    fd = None
    proxy = None
    started = False

    def interrupted(signum, _frame):
        if key_file is not None:
            with suppress(OSError):
                os.unlink(key_file)
        raise SystemExit(128 + signum)

    try:
        for sig in taken:
            signal.signal(sig, interrupted)
        fd, key_file = tempfile.mkstemp(prefix=owned_prefix("route-key"), dir=STATE)
        # README: the route key is in no argv, environment, or lingering file.
        # Exceptions use finally; TERM/HUP use interrupted and then finally.
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
        os.write(fd, key.encode())
        os.close(fd)
        fd = None
        port = fixed_port or free_port()
        proxy_env = {k: v for k, v in os.environ.items() if k not in strip_env()}
        proxy_env.update(RC_UPSTREAM=upstream, RC_KEY_FILE=key_file, RC_PARENT_PID=str(me),
                         RC_PARENT_STARTED=edge_started(me) or "",
                         RC_TIERS=json.dumps(pinned_tiers(os.environ)), RC_INFERENCE=str(INFERENCE),
                         RC_SOURCE=str(HERE))
        if args.debug:
            proxy_env["RC_LOG"] = str(STATE / "debug.log")
        proxy = subprocess.Popen(
            proxy_command(mitmdump, port, confdir, private_addon(STATE)),
            env=proxy_env, stdin=subprocess.DEVNULL, start_new_session=True)
        wait_listening(port, proxy, "proxy")
        ca = confdir / "mitmproxy-ca-cert.pem"
        if not ca.exists():
            die(f"proxy CA not generated at {ca}")
        if os.path.exists(key_file):
            die("proxy did not consume the route key; refusing to continue")
        started = True
        return port, ca, upstream, route_env
    finally:
        # Close the cleanup window too: a TERM/HUP during unlink must not re-enter
        # interrupted while this finally block is already unwinding.
        signal.pthread_sigmask(signal.SIG_BLOCK, blocked)
        try:
            if fd is not None:
                with suppress(OSError):
                    os.close(fd)
            if key_file is not None:
                with suppress(OSError):
                    os.unlink(key_file)      # already gone when the addon consumed the key
            if proxy is not None and not started:
                # Best effort: nothing raised while stopping it may replace the error
                # (or the 128+signal exit) that ended this start.
                with suppress(Exception):
                    stop_proxy(proxy)
        finally:
            # Restore dispositions only while blocked. A signal pending at this point
            # sees the key already removed and the caller's normal disposition restored.
            for sig in taken:
                signal.signal(sig, old_handlers[sig])
            signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)


def edge_down(port: int, upstream: str) -> str | None:
    """Why the shared edge can no longer serve, or None while it can.

    The proxy answering is not enough: with its adapter gone (translator exited) it
    answers every /v1/messages with 502 while looking healthy (2026-10-19).
    """
    up = urllib.parse.urlsplit(upstream)
    for what, addr in (("proxy", ("127.0.0.1", port)), ("upstream", (up.hostname, up.port))):
        try:
            with socket.create_connection(addr, timeout=5):
                pass
        except OSError:
            return f"shared edge {what} on {addr[0]}:{addr[1]} stopped answering"
    return None


NOFILE = 65536          # launchd's default soft limit is 256; one shared edge proxy
                       # carries every bridge's connections and hit it (EMFILE)


def raise_nofile() -> None:
    """Lift the open-file soft limit; the proxy and adapter inherit it."""
    soft, hard = resource.getrlimit(resource.RLIMIT_NOFILE)
    want = NOFILE if hard == resource.RLIM_INFINITY else min(NOFILE, hard)
    if soft != resource.RLIM_INFINITY and soft < want:
        resource.setrlimit(resource.RLIMIT_NOFILE, (want, hard))


def edge_record(me: int, port: int, ca, upstream: str, route_env: dict, env) -> dict:
    """What a live edge publishes about itself under <route>.json.

    `tiers` is what its proxy really pins: a supervisor that finds this edge still
    serving after a restart reads it to decide whether to adopt it or replace it,
    so it must be the same function the proxy's own env was built from.
    """
    return {"pid": me, "port": port, "ca": str(ca), "upstream": upstream,
            "tiers": pinned_tiers(env),
            "route_env": {k: route_env[k]
                          for k in (*MODEL_ENV, *ROUTE_ENV) if k in route_env}}


def publish_edge(route: str, record: dict) -> Path:
    """The one writer of the route's edge record, in the one place live_edge reads.

    The record names the ROUTE that wrote it: on a case-insensitive volume
    `GW.json` and `gw.json` are one file, so a reader that never asked whose
    record it found would adopt a case twin's edge and its port (#846). The
    write goes through a temp beside the target so a reader never sees half a
    record, and the name comes from edge_name -- never the raw route, which may
    hold a `/` nothing creates a directory for.
    """
    EDGES.mkdir(parents=True, exist_ok=True)
    path = EDGES / f"{edge_name(route)}.json"
    tmp = EDGES / f".{path.name}.tmp"
    tmp.write_text(json.dumps({**record, "route": route}))
    tmp.replace(path)
    return path


def write_inference(word: str, path: Path = INFERENCE) -> None:
    """The one writer of the switch file; rc-hosts calls it too. The temp name
    is unique per write because the supervisor and a manual `--switch` both
    land here: one shared `<target>.tmp` let each writer's replace() rename the
    other's half-written temp away, or the two O_TRUNC opens interleave into a
    torn word that inference_target silently reads as "route" (issue #596)."""
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:    # mkstemp's 0600: unique names, no umask race
            fh.write(word + "\n")
        os.replace(tmp, path)   # atomic: a proxy never reads half a word
    except OSError:
        with suppress(OSError):
            os.unlink(tmp)      # a failed write leaves no temp beside the switch file
        raise


def get_tiers(profile: str) -> dict[str, str] | None:
    """The profile's tier map from its owner, `ccmorph get <profile> --json` (no side
    effect: nothing is started), `[1m]` stripped as pinned_tiers does; None if unread."""
    try:
        out = subprocess.run([str(ADAPTER), "cli", "get", profile, "--json"], stdin=subprocess.DEVNULL,
                             capture_output=True, text=True, timeout=30)
        tiers = json.loads(out.stdout)["tiers"] if out.returncode == 0 else None
    except (OSError, subprocess.TimeoutExpired, ValueError, KeyError, TypeError):
        return None
    if not isinstance(tiers, dict):
        return None
    return {a: (m[:-4] if m.endswith("[1m]") else m) for a, m in tiers.items() if isinstance(m, str) and m}


def write_json(path: Path, obj) -> None:
    """A small non-secret record, replaced atomically through a temp only this write owns."""
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=path.name + ".", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump(obj, fh)
        os.replace(tmp, path)
    except OSError:
        with suppress(OSError):
            os.unlink(tmp)
        raise


def _word_seq(path: Path) -> Path:
    return path.with_name(f".{path.name}.seq")


def _read_word_seq(path: Path) -> tuple[int, int]:
    """(the next ticket to hand out, the ticket whose word is in the file now)."""
    try:
        seq = json.loads(_word_seq(path).read_text())
        return int(seq["next"]), int(seq["landed"])
    except (OSError, ValueError, KeyError, TypeError):
        return 1, 0


def _write_word_seq(path: Path, nxt: int, landed: int) -> None:
    fd, tmp = tempfile.mkstemp(dir=path.parent, prefix=f".{path.name}.seq.", suffix=".tmp")
    try:
        with os.fdopen(fd, "w") as fh:
            json.dump({"next": nxt, "landed": landed}, fh)
        os.replace(tmp, _word_seq(path))
    except BaseException:
        with suppress(OSError):
            os.unlink(tmp)
        raise


def _word_lock(path: Path):
    path.parent.mkdir(parents=True, exist_ok=True)
    return open(path.with_name(f".{path.name}.lock"), "a")


def take_ticket(path: Path = INFERENCE) -> int:
    """This writer's place in line for the switch file, taken when its switch
    starts. A `--switch` can stall for seconds (an adapter start) while another --
    the person's own, or the supervisor's -- starts after it and lands first; with
    no order, the older word landed last and silently replaced the newer choice
    (issue #595). land_word() lands a word only if no later ticket already has."""
    with _word_lock(path) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        nxt, landed = _read_word_seq(path)
        _write_word_seq(path, nxt + 1, landed)
        return nxt


def overtaken(ticket: int, path: Path = INFERENCE) -> bool:
    """Whether a switch that started after the one holding `ticket` has landed."""
    with _word_lock(path) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        return _read_word_seq(path)[1] > ticket


def land_word(word: str, ticket: int, path: Path = INFERENCE) -> bool:
    """Write `word` unless a switch that started after this one (a later ticket)
    has already landed its own: then nothing is written and False says so. The
    last switch asked for wins, never the one that happened to finish last."""
    with _word_lock(path) as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        nxt, landed = _read_word_seq(path)
        if landed > ticket:
            return False
        write_inference(word, path)
        _write_word_seq(path, max(nxt, ticket + 1), ticket)
        return True


def read_inference(path: Path | None = None) -> str | None:
    """The word every proxy is answering now; None when there is none to read."""
    try:
        return (path or INFERENCE).read_text().strip() or None
    except OSError:
        return None


def inference_word(profile: str, account: str) -> str:
    """The one rule for what a profile name becomes in the switch file: "account"
    for the account profile, "route" ONLY while an edge really answers for that
    profile (the word tells a proxy to serve from its own upstream), else the
    profile itself, which has to be brought up beside the live edge. rc-hosts'
    `inference=` asks this same question: its own answer used to be any
    config-named route, edge or no edge, so `inference=gateway` with the gateway
    edge down silently put the phone on whichever route did answer (issue #595)."""
    if profile == account:
        return "account"
    return "route" if live_edge(profile) else profile


def held_by(owner: int, started: str) -> dict:
    """{profile: handoff id} the proxy of edge `owner` -- that process, by its start --
    says it holds now (held.<pid>.json, which the proxy rewrites as it takes each
    handoff and empties when it starts). {} when it says nothing for that process:
    a proxy that restarted holds nothing, whatever an earlier one took."""
    try:
        h = json.loads((STATE / f"held.{owner}.json").read_text())
    except (OSError, ValueError):
        return {}
    if not isinstance(h, dict) or h.get("edge") != owner or h.get("edge_started") != started:
        return {}
    profiles = h.get("profiles")
    return profiles if isinstance(profiles, dict) else {}


def hand_held(profile: str, owner: int, started: str) -> dict | None:
    """The up-<profile>.json record when the proxy of edge `owner` (by pid and
    start) holds the handoff that record names and its upstream answers; else None.
    The record alone proved nothing: a proxy that restarted behind the same edge
    lost every endpoint it held, and the record still said "up" (issue #595)."""
    try:
        up = json.loads((STATE / f"up-{edge_name(profile)}.json").read_text())
        upstream, hand = str(up["upstream"]), up.get("hand")
    except (OSError, ValueError, KeyError, TypeError, AttributeError):
        return None
    if up.get("edge") != owner or up.get("edge_started") != started or not hand:
        return None
    if held_by(owner, started).get(profile) != hand or not _listening(upstream):
        return None
    return up


def brought_up(profile: str, owner: int, started: str, tiers: dict | None) -> bool:
    """Whether `profile` is already up beside this edge with these tiers: its proxy
    holds the endpoint (hand_held), and a second bring-up would only hand the same
    thing over again. Several sessions on one profile share the first bring-up."""
    up = hand_held(profile, owner, started)
    return up is not None and up.get("tiers") == tiers


HANDOFF_WAIT = 5.0      # seconds; the proxy looks for a handoff every half second


def handoff_taken(hand: Path, payload: bytes, seconds: float = HANDOFF_WAIT) -> bool:
    """Whether the edge's proxy took this handoff in time: the file is gone and that
    proxy says it holds this very handoff (held.<edge>.json names its id). A file
    that is merely gone proves nothing a later look can check (issue #595)."""
    rec = json.loads(payload)
    profile = hand.name[len("switch-"):-len(".json")]
    for i in range(int(seconds / 0.1) + 1):
        if i:
            time.sleep(0.1)
        try:
            hand.stat()
            continue
        except FileNotFoundError:
            pass
        except OSError:
            continue
        if held_by(rec["edge"], rec["edge_started"]).get(profile) == rec["id"]:
            return True
    return False


def _land(word: str, ticket: int | None, path: Path) -> bool:
    """The shared word lands by its ticket (land_word); a session's own word has no
    line to wait in and is simply written."""
    if ticket is None:
        write_inference(word, path)
        return True
    return land_word(word, ticket, path)


def _switch_lock():
    """Held across a handoff's publish, the wait for its proxy and the word: one
    switch at a time hands anything over, so no switch ever replaces or removes a
    handoff another one published (issue #595)."""
    STATE.mkdir(parents=True, exist_ok=True)
    return open(STATE / ".switch.lock", "a")


def switch(profile: str, account: str, session: str | None = None, rehand: bool = False) -> None:
    """Send inference to `profile` from the next turn, with no restart: every host's,
    or with `session` that one phone session's only (the rest keep the shared switch).
    The account profile is Anthropic on the phone's own login, a profile that has a
    live edge is that edge's route (inference_word), and any other route or provider
    profile is brought up beside the edge (one sidecar adapter, reused) and handed to
    its proxy. The word lands only once that proxy says it holds the endpoint. A
    shared switch that a later one overtook (it started after this one and landed
    first) writes nothing, neither the word nor a handoff: the later choice stands,
    and when that choice is this same profile the switch says so and succeeds.

    `rehand` (rc-hosts, after an edge or proxy restart) hands the profile's endpoint
    to the live edge's proxy again and never writes a word or takes a place in line:
    upkeep must not overtake a choice the person made meanwhile (issue #595)."""
    if session is not None and not SESSION_ID.fullmatch(session):
        die(f"'{session}' is not a session id")
    word_path = INFERENCE if session is None else STATE / "sessions" / session
    ticket = take_ticket(INFERENCE) if session is None and not rehand else None   # our place in line
    word = inference_word(profile, account)
    if rehand and word != profile:
        print(f"ccmorph-rc: '{profile}' is the '{word}' word now; nothing to hand over", file=sys.stderr)
        return
    hand = payload = up = None
    if word == "account":
        # The account's own model per alias, for a tier the route pinned (fable -> the
        # route's model): the proxy reads it back to the account's model for that alias.
        STATE.mkdir(parents=True, exist_ok=True)
        write_json(STATE / "account-tiers.json", get_tiers(account) or {})
    if word == profile:
        if profile_type(profile) == "sub":
            die(f"'{profile}' is a Claude account profile, but the hosts sign in as '{account}'")
        # One shared edge (rc-hosts runs one route); the fallback note counts the same way.
        n, edge = switch_edge(EDGES, lambda f: live_edge(f.stem))
        if n != 1:
            die(f"--switch needs exactly one live shared edge, found {n}")
        if edge is None:
            die("the start of the live shared edge cannot be read on this system, so nothing could "
                "tell its proxy from a later one; nothing was switched (issue #595)")
        owner, started = int(edge["pid"]), str(edge["started"])   # the profile lives as long as that edge
        current = get_tiers(profile)
        if not brought_up(profile, owner, started, current):
            route_env = resolve_route(profile)
            retire_route_with(owner, route_env.get("CCMORPH_ROUTE_HANDLE", ""))
            key = route_env.get("ANTHROPIC_API_KEY") or die(f"profile '{profile}' has no key")
            # a provider's bridge already speaks the Anthropic API; a key profile goes through the adapter
            upstream = (route_env.get("ANTHROPIC_BASE_URL") or die(f"profile '{profile}' has no endpoint")
                        if profile_type(profile) == "provider" else sidecar(profile, owner, started)[0])
            tiers = pinned_tiers(route_env)
            hid = os.urandom(8).hex()        # this handoff, as the proxy reports it in held.<edge>.json
            hand = STATE / f"switch-{profile}.json"
            payload = json.dumps({"upstream": upstream, "key": key, "tiers": tiers,
                                  "edge": owner, "edge_started": started, "id": hid}).encode()
            up = {"edge": owner, "edge_started": started, "upstream": upstream, "tiers": current, "hand": hid}
    # From the temp's first byte until the proxy took it (or the switch took it back),
    # the handoff is the route key on disk with nothing else to remove it. The cleanup
    # below runs only when Python unwinds: TERM/HUP/QUIT at their default kill without
    # unwinding, and Ctrl-C can land between two statements. So the window -- the
    # publish, the wait for the proxy (HANDOFF_WAIT at most) and the word -- runs with
    # them blocked (deferred, not handled: dispositions stay the caller's), and one
    # that arrives is delivered once the handoff is taken or gone. The adapter start
    # that can take long is above.
    old_mask = signal.pthread_sigmask(
        signal.SIG_BLOCK, (signal.SIGTERM, signal.SIGHUP, signal.SIGQUIT, signal.SIGINT))
    try:
        with _switch_lock() as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            if ticket is not None and overtaken(ticket, INFERENCE):
                landed = False               # a later switch landed: this one hands nothing over
            elif hand is None:
                landed = rehand or _land(word, ticket, word_path)
            else:
                # Looked at once more here, after every wait: the OS may have given the
                # edge's pid to a replacement edge meanwhile (issue #595 review).
                if edge_started(owner) != started:
                    die(f"edge {owner} was replaced while this switch ran; nothing was handed over -- "
                        f"run `ccmorph-rc {profile} --switch` again to hand {profile} to the edge live now")
                # One temp per switch (mkstemp: unique name, 0600 from creation). A shared
                # switch-<profile>.tmp let a failed switch's cleanup delete the temp another
                # switch to the same profile had just staged there; this name is only ours.
                fd, tmp = tempfile.mkstemp(dir=hand.parent, prefix=hand.name + ".", suffix=".tmp")
                try:
                    try:
                        os.write(fd, payload)
                    finally:
                        os.close(fd)
                    os.replace(tmp, hand)
                except BaseException:
                    with suppress(OSError):
                        os.unlink(tmp)    # a temp that never became the handoff still holds the route key
                    raise
                try:
                    if not handoff_taken(hand, payload):
                        die(f"the edge's proxy did not take '{profile}' within {HANDOFF_WAIT:g}s "
                            f"(a proxy started before this ccmorph-rc does not); nothing changed")
                    write_json(STATE / f"up-{edge_name(profile)}.json", up)
                    landed = rehand or _land(word, ticket, word_path)
                except BaseException:
                    # No word names this handoff, so no request would read it: leaving it
                    # would keep the route key on disk for good (README: no lingering file).
                    # Under the switch lock the file holds this switch's payload or nothing.
                    with suppress(OSError):
                        if hand.read_bytes() == payload:
                            hand.unlink()
                    raise
    finally:
        signal.pthread_sigmask(signal.SIG_SETMASK, old_mask)
    if not landed:
        live = read_inference(INFERENCE)
        if live == word:
            print(f"ccmorph-rc: inference already goes to '{profile}': a switch started after this one "
                  f"landed it first", file=sys.stderr)
            return
        die(f"a switch started after this one landed first ({live}); '{profile}' was not switched in "
            f"-- run `ccmorph-rc {profile} --switch` again to choose it now (issue #595)")
    if rehand:
        print(f"ccmorph-rc: the live edge's proxy holds '{profile}' again", file=sys.stderr)
        return
    who = f"session {session}'s" if session else "every host's"
    print(f"ccmorph-rc: {who} inference now goes to '{profile}' from the next turn", file=sys.stderr)


def unswitch(session: str) -> None:
    """Hand one session back to the switch every host shares."""
    if not SESSION_ID.fullmatch(session):
        die(f"'{session}' is not a session id")
    with suppress(FileNotFoundError):
        (STATE / "sessions" / session).unlink()
    print(f"ccmorph-rc: session {session} follows every host's inference again", file=sys.stderr)


def main(argv: list[str]) -> None:
    raise_nofile()
    rc_args: list[str] = []
    if "--" in argv:
        i = argv.index("--")
        argv, rc_args = argv[:i], argv[i + 1:]
    ap = argparse.ArgumentParser(prog="ccmorph-rc", description=__doc__.split("\n\n")[0])
    ap.add_argument("route", nargs="?", help="ccmorph profile that serves inference")
    ap.add_argument("--as", dest="account", help="Claude account profile (default: the only one)")
    ap.add_argument("--debug", action="store_true", help="log method+path per request to the state dir")
    ap.add_argument("--route-models", action="store_true",
                    help="use the route profile's model aliases instead of real Claude ids")
    ap.add_argument("--edge", action="store_true",
                    help="run the route's shared adapter+proxy for other bridges to use, and stay up")
    ap.add_argument("--switch", action="store_true",
                    help="send every host's inference to this profile from the next turn, with no restart")
    ap.add_argument("--rehand", action="store_true",
                    help="with --switch: hand the live profile to the edge's proxy again, changing no word "
                         "(ccmorph-rc-hosts runs it after an edge or proxy restart)")
    ap.add_argument("--session", metavar="ID",
                    help="with --switch: only this phone session (cse_...) moves; the rest keep theirs")
    ap.add_argument("--unswitch", metavar="ID",
                    help="hand session ID back to every host's inference")
    ap.add_argument("--probe", action="store_true",
                    help="send one prompt through the same wiring (claude -p) instead of Remote Control")
    args = ap.parse_args(argv)
    if args.unswitch:
        return unswitch(args.unswitch)
    if args.route is None:
        ap.error("the route profile is required")
    if args.session and not args.switch:
        ap.error("--session goes with --switch")
    if args.rehand and (not args.switch or args.session):
        ap.error("--rehand goes with --switch, for every host's word")

    claude = shutil.which("claude") or die("claude not found on PATH")
    account = args.account or default_account()
    if args.switch:
        return switch(args.route, account, args.session, rehand=args.rehand)
    if profile_type(account) != "sub":
        die(f"'{account}' is not a Claude account profile")
    if (route_type := profile_type(route := args.route)) == "sub":
        die(f"'{route}' is a Claude account profile; the route must be an API key profile")
    if route_type == "provider":
        die(f"'{route}' is a provider profile; ccmorph-rc routes only to API key profiles")

    account_dir = profile_env(account).get("CLAUDE_CONFIG_DIR") or die(f"no config dir for '{account}'")
    me = os.getpid()                       # becomes Claude's pid after exec
    edge = None if (args.edge or args.debug) else live_edge(route)
    if edge:
        port, ca, upstream = int(edge["port"]), Path(edge["ca"]), edge["upstream"]
        route_env = edge.get("route_env", {})
    else:
        port, ca, upstream, route_env = own_edge(route, me, args, edge_port(route) if args.edge else None)
    if args.edge:
        publish_edge(route, edge_record(me, port, ca, upstream, route_env, os.environ))
        print(f"ccmorph-rc: shared edge for '{route}' on 127.0.0.1:{port} ({upstream})", file=sys.stderr)
        while True:                        # adapter and proxy follow this pid; stay up
            time.sleep(15)
            if why := edge_down(port, upstream):
                die(f"{why}; exiting so it is restarted")
    env = session_env(os.environ, route_env, args.route_models)
    env.update(CLAUDE_CONFIG_DIR=account_dir,
               HTTPS_PROXY=f"http://127.0.0.1:{port}",
               NO_PROXY="localhost,127.0.0.1,::1",
               NODE_EXTRA_CA_CERTS=str(ca))
    # ccmorph's own plugin and, while it is on, the router's: the core owns the rule.
    env["CLAUDE_CODE_PLUGIN_DIRS"] = plugin_dirs(env)
    seed_trust(account_dir, os.getcwd())
    print(f"ccmorph-rc: Remote Control as '{account}', inference via '{route}' ({upstream})",
          file=sys.stderr)
    if args.probe:
        cmd = [claude, "-p", "--model", "sonnet", "Reply with exactly: rc-bridge-ok"]
    else:
        # Pass-through: exactly what was typed after `--`. A pinned conversation is
        # reattached by --session-id; --continue would restore only a host's first
        # session, as a single-session host.
        if "--session-id" not in rc_args:
            keep_host(account_dir, os.getcwd())
        cmd = [claude, "remote-control", *rc_args]
    os.execve(claude, cmd, env)


if __name__ == "__main__":
    main(sys.argv[1:])
