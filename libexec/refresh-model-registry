#!/usr/bin/env python3
"""Discover context windows without inference by default.

Read gateway-declared limits from /v1/models and merge them into the existing
registry. Missing metadata never starts a paid probe. Automatic discovery runs
in the background; each invocation has a 30-second wall-clock deadline.

An operator may explicitly authorize inference for one profile and model with
--allow-inference. Accepted oversized prompts can be expensive; neither rejection
nor cancellation guarantees zero billing across arbitrary gateways. --bisect is
an additional opt-in for a hidden ceiling, not the normal discovery mechanism.
"""

from __future__ import annotations

import argparse
import contextlib
import difflib
import fnmatch
import json
import importlib.machinery
import importlib.util
import os
import re
import signal
import socket
import subprocess
import sys
import time
import urllib.error
import urllib.parse
import urllib.request
from pathlib import Path

LIB_DIR = Path(os.environ.get("CCMORPH_LIB_DIR") or Path(__file__).resolve().parent.parent / "lib")
CCMORPH = LIB_DIR / "ccmorph.sh"
SHARE_DIR = LIB_DIR.parent / "share"


def _state_dir() -> Path:
    """Where ccmorph keeps state — profiles, the registry, the active marker.

    NOT beside this script. The registry is state that survives upgrades, and this
    file is code that an upgrade replaces; resolving it from __file__ only ever
    worked because a clone-install put both in one directory. Under any packaged
    install the script sits in a read-only prefix, so writing the registry beside
    it fails, or worse writes into a versioned directory the next upgrade discards.
    """
    return Path(os.environ.get("CCMORPH_STATE_DIR")
                or Path(os.environ.get("XDG_CONFIG_HOME")
                        or Path.home() / ".config") / "ccmorph")


_store_spec = importlib.util.spec_from_loader(
    "profile_context", importlib.machinery.SourceFileLoader("profile_context", str(Path(__file__).resolve().with_name("model-window"))))
assert _store_spec and _store_spec.loader
store = importlib.util.module_from_spec(_store_spec)
_store_spec.loader.exec_module(store)

# An opt-in probe can send this many characters, NOT a guaranteed token count.
OVERSHOOT_CHARS = 6_000_000
PROBE_TIMEOUT = 10
LIST_TIMEOUT = 5
USER_AGENT = "ccmorph-refresh-model-registry"
RUN_TIMEOUT = 30


DECLARED = [
    re.compile(r"maximum context length is (\d[\d,]*)", re.I),
    re.compile(r"too long:\s*\d[\d,]*\s*tokens?\s*>\s*(\d[\d,]*)\s*maximum", re.I),
    re.compile(r">\s*(\d[\d,]*)\s*maximum", re.I),
    re.compile(r"max(?:imum)?[ _-]?(?:input|context)[ _-]?(?:tokens|length)\D{0,12}(\d[\d,]*)", re.I),
    re.compile(r"(?:limit|maximum) of (\d[\d,]*) tokens", re.I),
    re.compile(r"should be \[?\d+,\s*(\d[\d,]*)\]?", re.I),
]

# "Wrong endpoint for this model", not "payload too large" -- try the other shape.
SHAPE_MISMATCH = re.compile(
    r"does not support the required API|MESSAGES_API|internal_feature_not_supported",
    re.I,
)

CONTEXT_OVERFLOW = re.compile(
    r"prompt.{0,20}too long|context.{0,30}(?:exceed|too long)|maximum context length", re.I)

SHAPES = (
    ("anthropic", "/v1/messages",
     lambda k: {"x-api-key": k, "anthropic-version": "2023-06-01"}),
    ("openai", "/v1/chat/completions",
     lambda k: {"Authorization": f"Bearer {k}"}),
)


class RouteUnavailable(Exception):
    """ccmorph could not produce a reachable endpoint for a profile."""


class SameOriginRedirect(urllib.request.HTTPRedirectHandler):
    """Never carry the credential to another origin (mirrors the class of the
    same name in ccmorph-adapter): urllib copies request headers, including
    x-api-key/Authorization, onto a redirect target. Same-origin redirects
    follow; a cross-origin one fails as a transport error."""

    @staticmethod
    def _origin(url):
        parts = urllib.parse.urlsplit(url)
        return parts.scheme.lower(), parts.netloc.lower()

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if self._origin(newurl) != self._origin(req.full_url):
            raise urllib.error.URLError(
                f"cross-origin redirect refused: {req.full_url} -> {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def build_opener() -> urllib.request.OpenerDirector:
    """The opener every request for one route goes through.

    No ProxyHandler of our own: urllib's default one reads HTTPS_PROXY/NO_PROXY
    from the environment, which is exactly the contract ccmorph keeps everywhere
    else -- an ambient proxy exported by whatever bridge the operator runs reaches
    this probe unchanged, and no proxy means a direct request.
    """
    handlers: list[urllib.request.BaseHandler] = [SameOriginRedirect()]
    return urllib.request.build_opener(*handlers)


# Bare urllib.request.urlopen calls below use the global opener; give it the
# same-origin guard too so no request path carries a key across origins.
urllib.request.install_opener(build_opener())


def ccmorph_env(profile: str) -> dict[str, str]:
    """Endpoint and credential, from ccmorph, the only definition.

    `_route_env` rather than `_env`: a provider profile has no endpoint until its
    bridge process runs, and only _route_env starts one. It hands back a handle to
    retire with route_stop(); every other type answers with _env's own output.
    """
    out = subprocess.run(
        ["zsh", "-c", 'source "$1" && ccmorph _route_env "$2"',
         "refresh-model-registry", str(CCMORPH), profile],
        # Starting a provider bridge is not a local read. 60s was the budget for
        # printing a config file.
        capture_output=True, text=True, timeout=180,
    )
    if out.returncode != 0:
        # Not SystemExit any more. This is one route out of possibly several, and
        # aborting the process discarded every other route's probe -- while
        # with `--profile` naming one account, that traceback-shaped line was the
        # only thing the user ever saw.
        raise RouteUnavailable(out.stderr.strip() or
                               f"ccmorph could not resolve a route for {profile}")
    env = {}
    for line in out.stdout.splitlines():
        if "=" in line:
            k, v = line.split("=", 1)
            env[k] = v
    return env


def route_stop(handle: str) -> None:
    """Retire a route opened by ccmorph_env.

    Best-effort: a route left up is reused by the next caller (shared by design),
    so failing to close one must never fail a run that already got its numbers.
    """
    if not handle:
        return
    try:
        subprocess.run(
            ["zsh", "-c", 'source "$1" && ccmorph _route_stop "$2"',
             "refresh-model-registry", str(CCMORPH), handle],
            capture_output=True, text=True, timeout=30)
    except Exception:  # noqa: BLE001
        pass


def why_unreachable(exc: Exception, base: str) -> str:
    """What a reader can act on, derived from an exception they cannot.

    "model list unavailable (URLError(TimeoutError('timed out')))" names a python
    class and a nested repr. Nothing in it says the endpoint is private or that
    connecting the VPN is the fix. An exception class is what the code caught,
    never what went wrong.
    """
    host = base.split("://", 1)[-1].split("/", 1)[0] or base

    if isinstance(exc, urllib.error.HTTPError):
        if exc.code in (401, 403):
            return (f"{host}: model listing denied (HTTP {exc.code}); "
                    "check credentials and gateway access rules")
        return f"{host}: model listing failed (HTTP {exc.code})"

    # URLError wraps the real cause, sometimes more than once; the useful sentence
    # is in the innermost one.
    cause: BaseException = exc
    while isinstance(cause, urllib.error.URLError) and \
            isinstance(cause.reason, BaseException):
        cause = cause.reason

    if isinstance(cause, (TimeoutError, socket.timeout)):
        detail = f"did not answer at {host} (timed out)"
    elif isinstance(cause, socket.gaierror):
        detail = f"could not resolve {host} (DNS)"
    elif isinstance(cause, OSError):
        detail = f"did not answer at {host} ({cause.strerror or cause})"
    else:
        detail = f"could not be reached at {host} ({cause})"

    return f"{detail}; check the endpoint and network access"


def routed_profiles() -> list[str]:
    """Profiles with a routed endpoint: every one has a listing ccmorph can size."""
    names = []
    for conf in sorted(_state_dir().glob("*.conf")):
        try:
            _, fields = store.read_conf(conf)
        except (OSError, ValueError):
            continue
        if fields.get("type") in {"apikey", "proxy", "provider"}:
            names.append(conf.stem)
    return names


def payload(n_chars: int) -> str:
    unit = "The quick brown fox jumps over the lazy dog number %d. "
    out, n, i = [], 0, 0
    while n < n_chars:
        s = unit % i
        out.append(s)
        n += len(s)
        i += 1
    return "".join(out)


# Fields a gateway may use to STATE a model's context size in its listing.
DECLARED_FIELDS = ("max_input_tokens", "max_context_length",
                   "context_length", "context_window")

# The one reason a model can end a metadata-only run with no number. It is matched,
# not just printed: the summary keys the "here is how to resolve it" block off this
# note, so the string lives in one place instead of being re-spelled at each site.
UNRESOLVED = ("no size published by the gateway, and no catalogue "
              "entry for this model id")


def declared_sizes(rows: list) -> dict[str, int]:
    """Read explicit limits; equal values are not evidence of fabrication."""
    out: dict[str, int] = {}
    for row in rows:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str) or not row["id"]:
            continue
        for field in DECLARED_FIELDS:
            value = row.get(field)
            if type(value) is int and value > 0:
                out[row["id"]] = value
                break
    return out


SOURCE_RETRY_SECONDS = 600


def _source_table(source: dict, timeout: float, cache: dict) -> dict[str, tuple]:
    """{model id: (default or None, window)} from one source, fetched once per run.

    On the launch path (cache["launch"]) a failed fetch is remembered for
    SOURCE_RETRY_SECONDS, so an offline source costs one timeout, not one per launch.
    """
    url, rows_key, id_key = source.get("url"), source.get("rows"), source.get("id")
    window_key, default_key = source.get("window"), source.get("default")
    slot = f"source:{url}"
    down = _state_dir() / "cache" / f"window-source-{source.get('name', 'unnamed')}.unreachable"
    if slot not in cache and cache.get("launch"):
        try:
            if time.time() - down.stat().st_mtime < SOURCE_RETRY_SECONDS:
                cache[slot] = {}
        except OSError:
            pass
    if slot not in cache:
        rows = _fetch_json_dict(url, timeout).get(rows_key) if isinstance(url, str) else None
        table = {}
        for row in rows if isinstance(rows, list) else []:
            model = row.get(id_key) if isinstance(row, dict) else None
            window = row.get(window_key) if isinstance(model, str) else None
            if type(window) is int and window > 0:
                default = row.get(default_key) if default_key else None
                table[model] = (default if type(default) is int else None, window)
        cache[slot] = table
        try:
            if table:
                down.unlink(missing_ok=True)
            elif cache.get("launch"):
                down.parent.mkdir(parents=True, exist_ok=True)
                down.touch()
        except OSError:
            pass
    return cache[slot]


def provider_windows(declared: dict[str, int], rows: list, fields: dict, timeout: float,
                     cache: dict) -> tuple[dict[str, int], set[str]]:
    """Apply the window sources this profile opts into (contract: window-sources.json).

    Returns the raised sizes and the models whose source could not be read: those
    stay undecided this run, because a stored bare declaration would pin them.
    """
    wanted = {name for name in fields.get("window_sources", "").split(",") if name}
    if not wanted or not declared:
        return declared, set()
    if "sources" not in cache:
        try:
            cache["sources"] = json.loads((SHARE_DIR / "window-sources.json").read_text()).get("sources", [])
        except (OSError, ValueError, AttributeError):
            cache["sources"] = []
    out, pending = dict(declared), set()
    for source in cache["sources"] if isinstance(cache["sources"], list) else []:
        if not isinstance(source, dict) or source.get("name") not in wanted \
                or not isinstance(source.get("owned_by"), list):
            continue
        models = {row["id"] for row in rows if row.get("owned_by") in source["owned_by"]} & set(out)
        if not models:
            continue  # nothing this source speaks for: no fetch
        table = _source_table(source, timeout, cache)
        if not table:
            pending |= models
            continue
        for model in models & set(table):
            default, window = table[model]
            if default is not None and out[model] == default and window > out[model]:
                out[model] = window
    return out, pending


def api_url(base: str, path: str) -> str:
    parts = urllib.parse.urlsplit(base.rstrip("/"))
    prefix = parts.path.rstrip("/")
    # Keep inference probes consistent with the native Anthropic client's URL:
    # /v1/messages is never stripped, because the client is handed the versioned
    # base directly. Other paths (e.g. /v1/models) are stripped when the base
    # already carries a version suffix, so https://gw/api/v1 + /v1/models does
    # not produce /v1/v1/models.
    if path != "/v1/messages" and re.search(r"/v[0-9]+$", prefix, re.I):
        path = path[3:] if path.startswith("/v1") else path
    return urllib.parse.urlunsplit((parts.scheme, parts.netloc, prefix + path, "", ""))


real_id = store.real_id  # limits are stored under the true id


def listing_rows(data) -> list[dict]:
    """Chat-capable /v1/models rows under their true ids: the one listing rule."""
    rows = []
    for row in data if isinstance(data, list) else []:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str) or not row["id"]:
            continue
        caps = row.get("capabilities")
        if isinstance(caps, dict) and caps.get("chat_completion") is False:
            continue
        rows.append({**row, "id": real_id(row["id"])})
    return rows


def list_models(base: str, key: str,
                timeout: float = LIST_TIMEOUT,
                opener: urllib.request.OpenerDirector | None = None,
                ) -> tuple[list[str], dict[str, int], list[dict]]:
    req = urllib.request.Request(
        api_url(base, "/v1/models"),
        headers={"Authorization": f"Bearer {key}", "x-api-key": key,
                 "anthropic-version": "2023-06-01"},
    )
    send = opener.open if opener else urllib.request.urlopen
    with send(req, timeout=timeout) as r:
        rows = listing_rows(json.load(r).get("data"))
    ids = [row["id"] for row in rows]
    sizes = declared_sizes(rows)
    for row in rows:
        model = row["id"]
        if model in sizes or row.get("owned_by") != "ollama":
            continue
        # Ollama's listing identifies the protocol but omits the served num_ctx.
        # /api/show is metadata, not generation; architectural context_length can
        # exceed the configured window and must not substitute for num_ctx.
        req = urllib.request.Request(
            f"{base.rstrip('/')}/api/show",
            data=json.dumps({"model": model}).encode(),
            headers={"content-type": "application/json",
                     "Authorization": f"Bearer {key}", "x-api-key": key})
        try:
            with send(req, timeout=timeout) as response:
                parameters = json.load(response).get("parameters", "")
            found = re.search(r"^\s*num_ctx\s+([0-9]+)\s*$", parameters, re.MULTILINE)
            if found and int(found[1]) > 0:
                sizes[model] = int(found[1])
        except Exception:
            continue  # Missing metadata stays unknown; never start inference.
    return sorted(ids), sizes, rows


CATALOGUE_URL = "https://models.dev/api.json"
# Flat, provider-independent catalogue: one entry per canonical "provider/model-id"
# leaf instead of api.json's per-gateway-listing nesting. Only consulted when the
# per-provider lookup above is ambiguous or absent -- e.g. a reselling gateway
# (owned_by names the wrapper, not the lab) causes the same model to appear under
# many provider entries in api.json, so bare-id matching there is routinely
# ambiguous. The canonical id here still has to match exactly; no aliasing.
CANONICAL_CATALOGUE_URL = "https://models.dev/models.json"
CATALOGUE_TIMEOUT = LIST_TIMEOUT


def _fetch_json_dict(url: str, timeout: float) -> dict:
    """A JSON object fetched from `url`, or {} on any failure.

    Never raises: unreachable, slow, or malformed all mean "no catalogue fallback
    available", not a discovery failure.

    Sends an explicit User-Agent: models.dev answers 403 to urllib's default
    `Python-urllib/3.x`, so every live catalogue fetch failed silently and fell
    back to the bundled snapshot -- making any model newer than the snapshot
    look unresolvable.
    """
    request = urllib.request.Request(url, headers={"User-Agent": USER_AGENT})
    try:
        with urllib.request.urlopen(request, timeout=timeout) as response:
            data = json.load(response)
    except Exception:  # noqa: BLE001
        return {}
    return data if isinstance(data, dict) else {}


def fetch_catalogue(timeout: float = CATALOGUE_TIMEOUT) -> dict:
    """The offline models.dev provider/model catalogue, or {} on any failure.

    Fetched at most once per run (the caller memoizes), only when a model actually
    falls through to this tier -- most runs have every model declared by the gateway
    itself and never need it.
    """
    return _fetch_json_dict(CATALOGUE_URL, timeout)


def fetch_canonical_catalogue(timeout: float = CATALOGUE_TIMEOUT) -> dict:
    """The offline models.dev flat canonical-id catalogue, or {} on any failure.

    Fetched at most once per run (the caller memoizes), and only when the
    per-provider catalogue above didn't already resolve the model.
    """
    live = _fetch_json_dict(CANONICAL_CATALOGUE_URL, timeout)
    if live:
        return live
    try:
        snapshot = json.loads((SHARE_DIR / "model-catalogue.json").read_text())
        models = snapshot.get("models", {})
        if isinstance(models, dict):
            print(f"Catalogue unavailable; using bundled snapshot "
                  f"from {snapshot.get('retrieved', 'unknown date')} (models.dev).", file=sys.stderr)
            return models
    except (OSError, ValueError):
        pass
    return {}


_limit_window = store._limit_window
canonical_catalogue_window = store.canonical_catalogue_window


def catalogue_window(catalogue: dict, model_id: str, owned_by: str | None) -> dict | None:
    """An exact provider+model or unambiguous bare-model catalogue match.

    Returns {"value", "input", "context", "source": "catalogue"} or None. No family,
    alias, or fuzzy matching: a provider's `owned_by` on a gateway listing is not
    guaranteed to be the catalogue's provider slug, so a mismatch there is not treated
    as absence of a provider -- it falls back to the bare-id search below, which is
    only trusted when the id is unique across the WHOLE catalogue (2+ providers
    shipping the same id is ambiguous and is skipped, never maxed or guessed).
    """
    entries = []
    if owned_by and isinstance(catalogue.get(owned_by), dict):
        exact = catalogue[owned_by].get("models")
        if isinstance(exact, dict) and isinstance(exact.get(model_id), dict):
            entries = [exact[model_id]]
    if not entries:
        for provider in catalogue.values():
            if not isinstance(provider, dict):
                continue
            models = provider.get("models")
            if isinstance(models, dict) and isinstance(models.get(model_id), dict):
                entries.append(models[model_id])
        if len(entries) != 1:
            return None  # absent, or present under 2+ providers: no confident pick
    window = _limit_window(entries[0].get("limit"))
    return {**window, "source": "catalogue"} if window else None




# A gateway may hand back the upstream body as a hex blob rather than as text.
# One gateway wraps Bedrock this way:
#   detailMsg: "bedrock-claude 400 client error SdkBytes(bytes=0x7b22...7d)"
# and inside those bytes is the ordinary "prompt is too long: N tokens > M maximum"
# every pattern in DECLARED already reads. So the ceiling WAS being served on every
# probe, the tool simply could not see it, and a whole 46-model catalogue probed
# nothing while the answer sat in the error body in hex.
SDK_BYTES = re.compile(r"0x((?:[0-9a-fA-F]{2})+)")


def decode_hex_bodies(detail: str) -> str:
    """Append the decoded text of any 0x… blob, keeping the original around.

    Appended rather than substituted: the wrapper sometimes carries its own status
    or model name that the patterns may also want, and nothing is gained by throwing
    it away.
    """
    for match in SDK_BYTES.findall(detail):
        try:
            text = bytes.fromhex(match).decode("utf-8", "replace")
        except ValueError:
            continue
        if text:
            detail = f"{detail} {text}"
    return detail


def post_sized(base, key, model, blob, path, hdr, timeout=PROBE_TIMEOUT,
               opener=None):
    """POST one sized prompt. Returns the parsed doc, or raises.

    The single place this request is built. It existed three times -- the opening
    overshoot, the half-size re-read, and the bisection's sender -- with identical
    URL joins, bodies and headers but three different error policies, which is how a
    timeout came to mean "refused" in one copy and "failed" in another.
    """
    req = urllib.request.Request(
        api_url(base, path),
        data=json.dumps({"model": model, "max_tokens": 8,
                         "messages": [{"role": "user", "content": blob}]}).encode(),
        headers={"content-type": "application/json", **hdr(key)}, method="POST")
    send = opener.open if opener else urllib.request.urlopen
    with send(req, timeout=timeout) as r:
        return json.loads(r.read())


def is_timeout(exc: BaseException) -> bool:
    """A timeout, however it is wrapped. One definition, because the whole safety
    property (never read the clock as a ceiling) rests on recognising it."""
    if isinstance(exc, (TimeoutError, socket.timeout)):
        return True
    reason = getattr(exc, "reason", None)
    return isinstance(reason, (TimeoutError, socket.timeout))


def _reread(base, key, model, blob, path, hdr, timeout=PROBE_TIMEOUT,
            opener=None):
    """Same request at half the size, for the plateau comparison. None if it fails."""
    try:
        doc = post_sized(base, key, model, blob, path, hdr, timeout, opener)
    except Exception:  # noqa: BLE001
        return None
    used = doc.get("usage") or {}
    return (used.get("input_tokens") or used.get("prompt_tokens"),
            doc.get("stop_reason"))


# How close the search must get before it stops. 2% of the window is well inside the
# headroom Claude Code already leaves (it compacts at ~0.85 of the window minus an
# output reserve), so narrowing further buys nothing a session can feel.
BISECT_TOLERANCE = 0.02

# THE cost control, and the reason this is not a symmetric bisection.
#
# A refused over-limit request is FREE: the provider rejects it before inference, so
# nothing is generated and nothing is billed. An ACCEPTED one is billed for its whole
# payload. So the budget that matters is a cap on accepts, not on steps -- an
# implementation that capped steps would happily buy a dozen accepted megabyte
# payloads while "staying in budget".
#
# ONE. Not two.
#
# An accepted request costs roughly the window it accepted, so on a 1M model at
# Fable-tier pricing the second accept is the difference between ~$7.50 and ~$17.37
# for one model -- and across a 46-model catalogue, between ~$345 and ~$799. What it
# buys is precision: 1 accept lands 6-28% low, 2 lands within a few percent.
#
# That trade is wrong by default, because understating is SAFE here (the registry
# value only ever lowers the compaction trigger, so a low number compacts early;
# a high one fails late at the wall). Paying double for accuracy in the harmless
# direction is not a default anyone would choose if the invoice were in front of
# them. --bisect-accepts 2 remains available for a route worth the money.
BISECT_MAX_ACCEPTS = 1

# Probes are biased HIGH in the remaining range, because a probe above the ceiling is
# refused and therefore free. 0.75 shrinks the range to 75% on a free refusal and to
# 25% on a billed accept, so the search spends most of its steps paying nothing.
BISECT_BIAS = 0.75

# A bound on wall clock and on a flapping endpoint, not on spend.
BISECT_MAX_STEPS = 32


def bisect_ceiling(send, request, blob, floor=1_000, tolerance=BISECT_TOLERANCE,
                   max_accepts=BISECT_MAX_ACCEPTS, max_steps=BISECT_MAX_STEPS):
    """Find a ceiling a gateway enforces but will not state. Returns (value, note, billed).

    Why this exists
    ---------------
    A refusal is an answer. Some gateways strip the number out of their own error --
    observed: `[prompt is too long]` with the count removed -- and the tool used to
    record nothing for those, leaving the model to launch at a default nobody
    probed. But "too long" already says the ceiling is BELOW what was sent, and an
    acceptance says it is at or above; that is a monotone predicate over size, so the
    boundary is discoverable with no cooperation from the error text.

    Shape follows cost
    ------------------
      * Free descent: halve while REFUSED. Unlimited, costs nothing, and it reaches
        the bracket from below -- which makes the first billed request the cheapest
        one available rather than a megabyte midpoint.
      * Free narrowing: probe high in the remaining range (BISECT_BIAS), so the likely
        outcome is another free refusal that lowers the upper bound.
      * Billed steps are capped at `max_accepts`; reaching the cap returns the value
        already paid for instead of buying a tighter one, and says that it understates.

    Honesty
    -------
    The value is a size the provider ACTUALLY accepted, never the midpoint of a range
    never sent -- so it can only understate, and understating merely compacts early.
    Where the accepting response reports its own `input_tokens`, that is recorded in
    preference to a chars/4 estimate, and the note says which. A gateway that refuses
    even the floor yields None; nothing is invented.
    """
    base, key, model, path, hdr_or_none = request
    # The caller's oversized payload IS every smaller payload: each probe is a prefix
    # of it. Regenerating one per step rebuilt a multi-megabyte string from ~54k
    # pieces on every step (231ms -> 2.5ms per model timed, and worse under
    # --jobs because payload() is pure python and holds the GIL, serialising the
    # workers). `high` is derived from the same blob, so a probe can never exceed it.
    high = len(blob) // 4
    lo = 0                  # largest size known to be ACCEPTED
    hi = high               # smallest size known to be REFUSED
    best = None             # (accepted_size, provider_reported_or_None)
    accepts = 0
    steps = 0

    def converged() -> bool:
        return bool(lo) and hi - lo <= max(floor, int(hi * tolerance))

    def ask(size):
        nonlocal steps, lo, hi, best, accepts
        steps += 1
        kind, reported = send(base, key, model, blob[:size * 4], path, hdr_or_none)
        if kind == "refused":
            hi = min(hi, size)
            return "refused"
        if kind == "accepted":
            accepts += 1
            if size > lo:
                lo, best = size, (size, reported)
            return "accepted"
        return kind             # a transport error, which says nothing about size

    # Phase 1 — free descent. Every refusal here costs nothing.
    size = high // 2
    while steps < max_steps and size >= floor:
        outcome = ask(size)
        if outcome == "refused":
            size //= 2
            continue
        if outcome == "accepted":
            break
        # A timeout or transport failure must never be read as a ceiling: it says the
        # REQUEST did not finish, not that the prompt was too long. Reporting a
        # timeout as a refusal is what recorded glm-5.3 at 23,051 under
        # --probe-timeout 3 — a number probed from the clock, in a registry trusted
        # permanently and unverifiable downstream.
        if outcome == "timeout":
            return (None,
                    f"search timed out after {steps} step(s); nothing was recorded. "
                    "Retry with a larger --probe-timeout and --deadline if needed; "
                    "requests may be billed", accepts)
        return (None, f"search abandoned after {steps} step(s): {outcome}", accepts)

    if best is None:
        return (None,
                f"all {steps} requests were refused down to the estimated "
                f"{floor:,}-token floor; no limit identified", accepts)

    # Phase 2 — narrow, biased toward free refusals.
    while steps < max_steps and not converged() and accepts < max_accepts:
        probe = lo + int((hi - lo) * BISECT_BIAS)
        if probe <= lo or probe >= hi:
            break
        # A timeout is not information: it narrowed nothing, so stop and keep only
        # what was actually probed (the `gap` note below then says the range is
        # unconfirmed). Same reason the sender no longer calls a timeout a refusal.
        if ask(probe) not in ("refused", "accepted"):
            break               # keep what was already probed
    accepted_size, reported = best
    gap = "" if converged() else (
        f"; search stopped within the estimated {lo:,}–{hi:,} range, "
        "so this understates the unconfirmed ceiling")
    if isinstance(reported, int) and reported > 0:
        return (reported,
                f"{steps} search steps, {accepts} accepted request(s), potentially billed; "
                f"reported {reported:,} input tokens{gap}", accepts)
    return (accepted_size,
            f"{steps} search steps, {accepts} accepted request(s), potentially billed; "
            f"no token count reported, using a ~4 chars/token estimate{gap}", accepts)


def classify_accepted(full, half):
    """What a 200 to an over-limit request means. Returns (kind, value, note).

    Three outcomes arrive as 200 and the old code called all of them "accepted",
    concluding that the model truncates silently and has no observable ceiling. That
    threw away a probe glm-5.2 had handed over: it answers 200 with empty
    content, zeroed usage and stop_reason model_context_window_exceeded -- a refusal,
    stated plainly, in a success envelope.

    `full` and `half` are (reported_input_tokens, stop_reason) from the overshoot and
    from a second request at half the size. The second reading is what separates a
    prompt that was quietly trimmed from one that simply fitted, and it needs no
    cooperation from the model: if halving the input does not change what comes back,
    the extra tokens went nowhere and that plateau is the limit.
    """
    reported, stop = full
    if stop == "model_context_window_exceeded":
        return ("exceeded", None,
                "stop_reason reports context overflow without a numeric limit")
    if half is None:
        return ("inconclusive", None,
                "oversized request accepted; confirmation failed, so the limit is unknown")
    half_reported, _ = half
    if not reported or not half_reported:
        return ("inconclusive", None, "no usable token counts reported")
    # Halving the input should roughly halve the count. Anything close to unchanged
    # means the model stopped reading at the same place both times.
    if half_reported > reported * 0.9:
        return ("truncated", reported,
                f"token-count plateau near {reported:,} for full and half inputs; inferred limit")
    return ("intact", None,
            f"accepted at least {reported:,} input tokens; upper limit not identified")


def probe(base: str, key: str, model: str, blob: str,
          timeout: float = PROBE_TIMEOUT,
          opener: urllib.request.OpenerDirector | None = None,
          bisect: int = 0,
          ) -> tuple[str, int | None, str]:
    """Return (kind, value, note). kind is prefixed with the shape that answered.

    A value read on either shape may be recorded: a ccmorph adapter=true
    profile puts a translator in front of its endpoint, so a model answering
    only the OpenAI shape is still selectable in a session and its ceiling
    still belongs in the registry.
    """
    for shape_name, path, hdr in SHAPES:
        # Only an explicit context-overflow refusal may begin a size search.
        def send_probe(b, k, m, blb, pth, hd, _t=timeout, _o=opener, _hdr=hdr):
            """One bisection step: did the gateway take this size, or refuse it?"""
            try:
                doc = post_sized(b, k, m, blb, pth, _hdr, _t, _o)
            except urllib.error.HTTPError as exc:
                detail = decode_hex_bodies(exc.read().decode("utf-8", "replace"))
                if exc.code in (400, 413, 422) and CONTEXT_OVERFLOW.search(detail):
                    return ("refused", None)
                return (f"HTTP {exc.code}: not a context-overflow refusal", None)
            except Exception as exc:  # noqa: BLE001
                # A timeout is NOT a refusal. Reporting it as one is what recorded a
                # model holding hundreds of thousands of tokens at 23,051 under
                # --probe-timeout 3: a ceiling read off the clock, written into a
                # registry that is trusted permanently. It says the REQUEST did not
                # finish, never that the prompt was too long.
                return ("timeout" if is_timeout(exc)
                        else f"{type(exc).__name__}: {exc}", None)
            if doc.get("stop_reason") == "model_context_window_exceeded":
                return ("refused", None)
            used = doc.get("usage") or {}
            return ("accepted",
                    used.get("input_tokens") or used.get("prompt_tokens"))

        try:
            doc = post_sized(base, key, model, blob, path, hdr, timeout, opener)
            used = doc.get("usage") or {}
            got = used.get("input_tokens") or used.get("prompt_tokens")
            stop = doc.get("stop_reason")
            half = None
            if stop != "model_context_window_exceeded":
                # This second request can also incur input charges.
                half = _reread(base, key, model, blob[:len(blob) // 2], path,
                               hdr, timeout, opener)
            kind, value, note = classify_accepted((got, stop), half)
            return f"{shape_name}:{kind}", value, note
        except urllib.error.HTTPError as e:
            detail = e.read().decode("utf-8", "replace")
            try:
                parsed = json.loads(detail)
                err = parsed.get("error")
                # Gateways wrap the provider's words: tencent puts the ceiling
                # in error.message and unicode-escapes the ">" in it, so the
                # declared-limit patterns miss the raw body entirely.
                detail = (parsed.get("detailMsg") or parsed.get("error_message")
                          or (isinstance(err, dict) and err.get("message"))
                          or detail)
            except json.JSONDecodeError:
                pass
            if SHAPE_MISMATCH.search(detail) or e.code == 404:
                continue
            # A gateway that wraps the upstream body as text (a prefix like
            # "tencent 400 client error {…}") never json-parses, so the escaped
            # comparison inside it must be normalized before the patterns run.
            detail = (detail.replace("\\u003e", ">").replace("\\u003c", "<")
                            .replace("\\u0026", "&"))
            detail = decode_hex_bodies(detail)
            for pat in DECLARED:
                m = pat.search(detail)
                if m:
                    return (f"{shape_name}:declared",
                            int(m.group(1).replace(",", "")), "")
            # 90 chars cut the note off mid-word, exactly where the interesting part
            # of a WRAPPED body starts: `cloudsway 400 client error {"error":
            # {"message":"Anthropic Claude bad request: [1261][promp` — the vendor
            # prefix and JSON envelope ate the whole budget, so the one thing a
            # reader needs (does this body carry a number the patterns missed?) was
            # the part discarded. Matching always ran on the full body; only the
            # diagnostic was blind.
            # The refusal proves a ceiling exists BELOW what was sent; this gateway
            # just did not say where. That is what the search is for.
            if bisect and e.code in (400, 413, 422) and CONTEXT_OVERFLOW.search(detail):
                val, why, billed = bisect_ceiling(
                    send_probe, (base, key, model, path, hdr), blob,
                    max_accepts=int(bisect))
                if val:
                    return f"{shape_name}:bisected", val, why
                return (f"{shape_name}:opaque", None,
                        f"{' '.join(detail[:200].split())} — {why}")
            return (f"{shape_name}:opaque", None,
                    " ".join(detail[:300].split()))
        except Exception as exc:  # noqa: BLE001
            # `repr(exc)` is what the code caught, not what happened —
            # "TimeoutError('The read operation timed out')" tells a reader nothing
            # about which request, how big, or what to do. Same rule as the listing
            # path (why_unreachable): name the event in words, and for a timeout say
            # that the probe is deliberately oversized, since that is WHY a slow
            # gateway times out here and not in a session.
            if is_timeout(exc):
                return (f"{shape_name}:error", None,
                        "over-limit probe timed out; no further requests sent. "
                        "Retry with a larger --probe-timeout and --deadline if needed; "
                        "the timed-out request may be billed")
            return f"{shape_name}:error", None, f"{type(exc).__name__}: {exc}"
    return "unsupported", None, "rejected on both shapes"


class RunDeadline(BaseException):
    """Escape nested request handlers without treating a clock as a model limit."""


@contextlib.contextmanager
def run_deadline(seconds):
    # Unix is already required by the registry's flock. A real timer also bounds
    # DNS, trickling response bodies, route startup, and cleanup; socket timeouts do not.
    def expired(signum, frame):
        raise RunDeadline()

    previous = signal.signal(signal.SIGALRM, expired)
    signal.setitimer(signal.ITIMER_REAL, seconds)
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous)


def prior_values(profiles=None) -> dict[str, int]:
    values = {}
    paths = (store.profile_path(profile) for profile in profiles) if profiles is not None else _state_dir().glob("*.conf")
    for path in paths:
        if not re.fullmatch(r"[A-Za-z0-9_]+", path.stem):
            continue
        try:
            _, fields = store.read_conf(path)
        except OSError:
            continue
        values.update({f"{path.stem}:{model}": value
                       for model, value in store.discovered_values(fields).items()})
    return values


def prior_catalogue_tags(profiles=None) -> dict[str, dict]:
    """`profile:model` -> its stored provenance tag, for every catalogue-derived
    (not verified) baseline entry.

    Doubles as the "is this scoped key catalogue-derived" test (non-empty membership)
    and as the exact tag to carry forward when a run merely repeats a prior value
    without re-fetching -- carrying it forward, rather than dropping it and letting a
    later untagged commit erase it, is what keeps an unverified guess from silently
    reading as verified after a run that changed nothing about it.
    """
    tags = {}
    paths = (store.profile_path(profile) for profile in profiles) if profiles is not None else _state_dir().glob("*.conf")
    for path in paths:
        if not re.fullmatch(r"[A-Za-z0-9_]+", path.stem):
            continue
        try:
            _, fields = store.read_conf(path)
        except OSError:
            continue
        tags.update({f"{path.stem}:{model}": entry for model, entry in store.discovered_sources(fields).items()})
    return tags


def probe_all(profiles: list[str] | None, jobs: int,
              mode: str = "declared-only",
              only_models: set[str] | None = None,
              probe_timeout: float = PROBE_TIMEOUT,
              deadline: float = RUN_TIMEOUT,
              bisect: int = 0,
              identities: dict | None = None,
              ) -> tuple[dict[str, int], list[tuple[str, str]], dict[str, dict]]:
    values: dict[str, int] = {}
    sources: dict[str, dict] = {}
    notes: list[tuple[str, str]] = []
    baseline = prior_values(profiles)
    catalogue_tags = prior_catalogue_tags(profiles)
    catalogues: dict = {}  # each fetched at most once per run, only if needed
    blob = None
    handle = ""
    cleanup_budget = min(1.0, deadline / 10)

    def stop_route():
        nonlocal handle
        closing, handle = handle, ""
        route_stop(closing)

    try:
        with run_deadline(deadline - cleanup_budget):
            profiles = profiles if profiles is not None else routed_profiles()
            for profile in profiles:
                if identities is not None:
                    identities[profile] = store.profile_identity(profile)
                    baseline = prior_values([profile])
                    catalogue_tags = prior_catalogue_tags([profile])
                try:
                    env = ccmorph_env(profile)
                except (RouteUnavailable, subprocess.TimeoutExpired) as exc:
                    notes.append((str(exc).replace("ccmorph:", "").strip(), profile))
                    continue
                handle = env.get("CCMORPH_ROUTE_HANDLE", "")
                key = env.get("ANTHROPIC_API_KEY")
                if not key:
                    notes.append(("profile has no api key, skipped", profile))
                    stop_route()
                    continue
                base = env.get("ANTHROPIC_BASE_URL", "https://api.anthropic.com")
                opener = build_opener()
                try:
                    models, declared, listing_rows = list_models(base, key, min(probe_timeout, LIST_TIMEOUT), opener)
                except Exception as exc:
                    notes.append((why_unreachable(exc, base), profile))
                    if mode == "declared-only" and only_models:
                        # Explicit model selection is enough for a catalogue lookup;
                        # an unavailable gateway is not evidence of model absence.
                        models, declared, listing_rows = sorted(only_models), {}, []
                        print(f"[{profile}] gateway metadata unavailable; trying catalogue for requested models", file=sys.stderr)
                    else:
                        stop_route()
                        continue
                try:
                    _, fields = store.read_conf(store.profile_path(profile))
                except (OSError, ValueError):
                    fields = {}
                if only_models is not None:
                    for wanted in sorted(only_models - set(models)):
                        near = [m for m in models if wanted.lower() in m.lower()] or \
                            difflib.get_close_matches(wanted, models, n=1)
                        hint = f"; did you mean {near[0]}?" if near else ""
                        notes.append((f"'{wanted}' is not on this route{hint}", profile))
                    models = [m for m in models if m in only_models]
                else:
                    # The operator already hid these from the picker; a model nobody
                    # can select needs no window, and listing it as unresolved is noise.
                    excluded = set(fields.get("excluded_models", "").split(","))
                    models = [m for m in models if m not in excluded]
                pinned = {m for m in models if mode != "probe-all"
                          and fields.get(f"context_window.{m}", "").isdigit()
                          and int(fields[f"context_window.{m}"]) > 0}
                sized = {m: v for m, v in declared.items() if m in models and m not in pinned}
                raised, pending = provider_windows(sized, listing_rows, fields,
                                                   min(probe_timeout, LIST_TIMEOUT), catalogues)
                declared = {**declared, **raised}
                owned_by = {row["id"]: row.get("owned_by") for row in listing_rows
                           if isinstance(row.get("owned_by"), str)}
                for model in models:
                    if model in pending:
                        notes.append(("provider catalogue unreachable; size left for the next run", model))
                        continue
                    pin = fields.get(f"context_window.{model}", "")
                    if pin.isascii() and pin.isdigit() and int(pin) > 0 and mode != "probe-all":
                        notes.append(("manual context override configured; not probed", model))
                        continue
                    scoped = f"{profile}:{model}"
                    known = baseline.get(scoped)
                    prior_tag = catalogue_tags.get(scoped)
                    # A prior catalogue guess is not verified: a fresh declared value
                    # this run always supersedes it, unlike a real probed/declared value
                    # which stays pinned (mode != "probe-all") exactly as before.
                    if mode != "probe-all" and known and not (
                            prior_tag and model in declared):
                        values[scoped] = known
                        if prior_tag:
                            # Repeating the same value this run must not look like a
                            # fresh unsourced (therefore "verified") write: carry the
                            # tag forward exactly, or a second identical run would
                            # silently promote an unverified guess to trusted.
                            sources[scoped] = prior_tag
                        if model in declared and declared[model] != known:
                            reason = f"kept saved limit {known:,}; gateway now declares {declared[model]:,}"
                            notes.append((reason, model))
                            print(f"  {model}: {reason}", file=sys.stderr)
                        continue
                    if model in declared and mode != "probe-all":
                        values[scoped] = declared[model]
                        continue
                    if mode == "declared-only":
                        found = catalogue_lookup(model, owned_by.get(model), catalogues)
                        if found:
                            values[scoped] = found["value"]
                            sources[scoped] = catalogue_tag(found)
                        else:
                            notes.append((UNRESOLVED, model))
                        continue
                    print(f"[{profile}] {model}: paid probe enabled. The first "
                          f"{OVERSHOOT_CHARS:,}-character prompt may be billed in full.\n"
                          "  Confirmation and search requests add cost; rates and tokenization "
                          "depend on the gateway. A timeout does not undo billing.", file=sys.stderr)
                    if blob is None:
                        blob = payload(OVERSHOOT_CHARS)
                    kind, val, why = probe(base, key, model, blob, probe_timeout, opener, bisect)
                    if kind.endswith((":declared", ":truncated", ":bisected")) and type(val) is int and val > 0:
                        values[scoped] = val
                    else:
                        notes.append((why or kind, model))
                    print(f"  {model:<30} {kind:<12} {val or '-'}", file=sys.stderr)
                    if why:
                        print(f"    {why}", file=sys.stderr)
                stop_route()
    except RunDeadline:
        notes.append((f"{deadline:g}s discovery deadline reached; existing values are preserved", "discovery"))
        print(notes[-1][0], file=sys.stderr)
    finally:
        if handle:
            try:
                with run_deadline(cleanup_budget):
                    stop_route()
            except RunDeadline:
                print("route cleanup timed out; a provider bridge may still be running", file=sys.stderr)
    return values, notes, sources


def catalogue_lookup(model: str, owned_by: str | None, cache: dict,
                     timeout: float = CATALOGUE_TIMEOUT) -> dict | None:
    """models.dev window for one id; `cache` memoizes each catalogue for the caller's run."""
    if "api" not in cache:
        cache["api"] = fetch_catalogue(timeout)
    found = catalogue_window(cache["api"], model, owned_by)
    if found is None:
        # api.json's per-provider nesting was ambiguous or empty for this model (a
        # common shape for reselling gateways, where owned_by names the wrapper and
        # the same model repeats under many provider entries) -- try the flat,
        # provider-independent canonical catalogue before giving up.
        if "flat" not in cache:
            cache["flat"] = fetch_canonical_catalogue(timeout)
        found = canonical_catalogue_window(cache["flat"], model, owned_by)
    return found


def catalogue_tag(found: dict) -> dict:
    return {"source": "catalogue", "value": found["value"], "input": found["input"],
            "context": found["context"], "fetched": time.strftime("%Y-%m-%d", time.gmtime())}


# Launch waits on this, so each catalogue fetch gets less than a background run does.
LAUNCH_CATALOGUE_TIMEOUT = 3

# A total-length limit stated in a request-validation error. Deliberately narrower
# than DECLARED: a max_tokens refusal usually names the OUTPUT cap ("[1,131072]"),
# which must never be read as the context window.
VALIDATION_WINDOW = re.compile(
    r"(?:max_model_len|max_total_tokens|maximum context length is)\D{0,20}(\d[\d,]*)", re.I)
OVERSIZED_MAX_TOKENS = 100_000_000


def validation_window(base: str, key: str, model: str, opener=None,
                      timeout: float = LAUNCH_CATALOGUE_TIMEOUT) -> int | None:
    """The window a gateway states when refusing an impossible max_tokens.

    The request is rejected at validation, before any generation, and many
    servers (vLLM behind most internal gateways) name the model's total length in
    that refusal. A gateway that accepts it answers "hi" and stops at the first
    paragraph break, the same bounded cost the adapter's output-cap check pays.
    """
    send = opener.open if opener else urllib.request.urlopen
    for name, path, headers in SHAPES:
        body = {"model": model, "max_tokens": OVERSIZED_MAX_TOKENS,
                "messages": [{"role": "user", "content": "hi"}],
                ("stop_sequences" if name == "anthropic" else "stop"): ["\n\n"]}
        req = urllib.request.Request(api_url(base, path), data=json.dumps(body).encode(),
                                     headers={"content-type": "application/json", **headers(key)})
        try:
            with send(req, timeout=timeout):
                return None  # accepted: nothing stated, nothing more to ask
        except urllib.error.HTTPError as exc:
            try:
                detail = exc.read().decode("utf-8", "replace")
            except Exception:  # noqa: BLE001
                continue
            found = VALIDATION_WINDOW.search(detail.replace("\\u003e", ">"))
            if found:
                value = int(found[1].replace(",", ""))
                if value > 0:
                    return value
        except Exception:  # noqa: BLE001
            continue  # a slow or rate-limited shape says nothing; ask the other one
    return None


# A model nothing could size is asked about again after this many days, not on
# every launch: a new catalogue entry is worth finding, a repeated wait is not.
MISS_RETRY_DAYS = 7


def recently_missed(day: str | None, today: str) -> bool:
    try:
        from datetime import date
        return (date.fromisoformat(today) - date.fromisoformat(day)).days < MISS_RETRY_DAYS
    except (TypeError, ValueError):
        return False


def size_listing(profile: str, body: str, base: str = "", key: str = "", opener=None) -> int:
    """Size, before launch, every listed model this profile has no limit for yet.

    The listing is the one launch already fetched, so a launch where every model is
    known costs a local comparison and nothing else. A model the gateway added since
    gets its declared size, else a models.dev estimate, else a dated miss that stops
    the lookup repeating for a week. Silent by design: the outcome goes to the
    log, never to the person launching.
    """
    try:
        data = listing_rows(json.loads(body).get("data"))
        _, fields = store.read_conf(store.profile_path(profile))
    except (ValueError, AttributeError, OSError):
        return 0
    expected = store.profile_identity(profile)
    known = {**store.discovered_values(fields), **store.manual_values(fields)}
    excluded = set(fields.get("excluded_models", "").split(","))
    today = time.strftime("%Y-%m-%d", time.gmtime())
    misses = store.discovered_misses(fields)
    rows = [row for row in data if store.valid_model(row["id"]) and row["id"] not in excluded
            and not recently_missed(misses.get(row["id"]), today)
            and not any(fnmatch.fnmatchcase(row["id"], pattern) for pattern in known)]
    if not rows:
        return 0
    values, sources, missed, cache = {}, {}, {}, {"launch": True}
    declared, pending = provider_windows(declared_sizes(rows), rows, fields, LAUNCH_CATALOGUE_TIMEOUT, cache)
    rows = [row for row in rows if row["id"] not in pending]  # retried next launch
    for row in rows:
        model = row["id"]
        if model in declared:
            values[model] = declared[model]
            continue
        owned_by = row.get("owned_by") if isinstance(row.get("owned_by"), str) else None
        found = catalogue_lookup(model, owned_by, cache, LAUNCH_CATALOGUE_TIMEOUT)
        if found:
            values[model] = found["value"]
            sources[model] = catalogue_tag(found)
            continue
        # A provider bridge answers from the user's subscription, and a probe it
        # accepts generates a reply: size such a model from metadata only.
        paid = fields.get("type") == "provider"
        stated = validation_window(base, key, model, opener) if base and key and not paid else None
        if stated:
            values[model] = stated
        else:
            missed[model] = today
    if not store.save_discovered(profile, values, expected, overwrite=False,
                                 sources=sources, misses=missed):
        return 1
    for model, value in sorted(values.items()):
        note = " (catalogue estimate)" if model in sources else ""
        print(f"sized {profile}:{model} {value}{note}", file=sys.stderr)
    for model in sorted(missed):
        print(f"no size for {profile}:{model}; launch fallback applies", file=sys.stderr)
    return 0


def commit(values, notes, baseline=None, identities=None, sources=None):
    """Each profile owns its write; no shared registry or cross-profile fallback."""
    grouped = {}
    grouped_sources = {}
    changes = {}
    for scoped, value in values.items():
        profile, _, model = scoped.partition(":")
        grouped.setdefault(profile, {})[model] = value
        if (baseline or {}).get(scoped) != value:
            changes.setdefault(profile, {})[model] = value
        tag = (sources or {}).get(scoped)
        if tag:
            grouped_sources.setdefault(profile, {})[model] = tag
    failed = False
    for profile, models in grouped.items():
        expected = (identities or {}).get(profile)
        if expected is None or not store.save_discovered(
                profile, models, expected, sources=grouped_sources.get(profile)):
            print(f"profile '{profile}' changed during discovery; its configuration was left unchanged", file=sys.stderr)
            failed = True
            continue
        # "wrote 1 context entries to gateway.conf" answered a question nobody has.
        # It names a file and a count, which together cannot tell the reader whether
        # the model they asked about got a window, what that window is, or whether
        # anything at all is different from before the command ran.
        new = changes.get(profile, {})
        if not new:
            print(f"{profile}: {len(models)} model(s) sized, nothing changed.", file=sys.stderr)
            continue
        estimated = grouped_sources.get(profile, {})
        print(f"{profile}: {len(new)} limit(s) updated, applies to new sessions.", file=sys.stderr)
        for model, value in sorted(new.items()):
            note = "  (catalogue estimate)" if model in estimated else ""
            print(f"  {model:<30} {value:>11,}{note}", file=sys.stderr)
    return int(failed)


def positive_int(value: str) -> int:
    value = int(value)
    if value <= 0:
        raise argparse.ArgumentTypeError("must be > 0")
    return value


def positive_float(value: str) -> float:
    value = float(value)
    if not 0 < value < float("inf"):
        raise argparse.ArgumentTypeError("must be finite and > 0")
    return value


def report_unresolved(models: list[str], profiles: list[str] | None) -> None:
    """How to give these models a window, in the order a reader should try it.

    Printed on BOTH exits, which is the bug this exists to fix. A run naming one
    model has no other value to report, so it took the `not values` path, printed
    the reason, and stopped -- the reader learned that nothing was found and that
    something was "kept", with no next step anywhere on screen. The three options
    below were reachable only when some OTHER model in the same run happened to
    resolve, so a dead end for the model you asked about looked identical to a
    solved one.
    """
    account = profiles[0] if profiles and len(profiles) == 1 else "<profile>"
    single = len(models) == 1
    model = models[0] if single else "<model>"
    print(f"\n{len(models)} unresolved, running at Claude Code's "
          f"{store.CC_DEFAULT_WINDOW:,}-token default:", file=sys.stderr)
    print("  " + ", ".join(models), file=sys.stderr)
    print(f"Set it:      ccmorph context {account} {model} <tokens>", file=sys.stderr)
    print(f"Measure it:  ccmorph probe {account} --model {model} --allow-inference"
          "   (one large prompt, may be billed)", file=sys.stderr)


def main() -> int:
    ap = argparse.ArgumentParser()
    ap.add_argument("--profile", action="append", dest="profiles")
    ap.add_argument("--model", action="append", dest="models",
                    help="limit discovery to this model id (repeatable for metadata only); "
                         "other profile context entries are preserved")
    ap.add_argument("--check", action="store_true",
                    help="report changed values without writing; metadata-only by default")
    ap.add_argument("--jobs", type=positive_int, default=1,
                    help="compatibility option; discovery is serial to bound gateway load")
    ap.add_argument("--deadline", type=positive_float, default=RUN_TIMEOUT,
                    metavar="SECONDS", help="whole-run deadline, including route setup (default 30)")
    ap.add_argument("--probe-timeout", type=positive_float, default=PROBE_TIMEOUT,
                    metavar="SECONDS", help="per-request timeout (default 10); deadline still applies")
    ap.add_argument("--allow-inference", action="store_true",
                    help="authorize potentially expensive input requests; requires one --profile "
                         "and one --model. Known limits are reused unless --probe-all is set")
    ap.add_argument("--bisect", action="store_true",
                    help="also search an explicit context-overflow refusal lacking a number; "
                         "requires --allow-inference and may spend additional input tokens")
    ap.add_argument("--bisect-accepts", type=positive_int, default=BISECT_MAX_ACCEPTS,
                    metavar="N", help="accepted-request budget inside bisection (default 1)")
    ap.add_argument("--listing-stdin", action="store_true",
                    help="size only this profile's not-yet-known models from the /v1/models "
                         "JSON on stdin (launch path; metadata only)")
    mode = ap.add_mutually_exclusive_group()
    mode.add_argument("--declared-only", action="store_true",
                      help="metadata only, no inference (the default)")
    mode.add_argument("--probe-all", action="store_true",
                      help="retest the selected model even when known; requires --allow-inference")
    args = ap.parse_args()
    if args.listing_stdin:
        if len(args.profiles or []) != 1:
            ap.error("--listing-stdin requires exactly one --profile")
        env = os.environ
        return size_listing(args.profiles[0], sys.stdin.read(),
                            env.get("ANTHROPIC_BASE_URL", ""), env.get("ANTHROPIC_API_KEY", ""),
                            build_opener())
    if (args.bisect or args.probe_all) and not args.allow_inference:
        ap.error("--bisect and --probe-all require --allow-inference (requests can cost money)")
    if args.allow_inference and (args.declared_only or len(args.profiles or []) != 1
                                or len(args.models or []) != 1):
        ap.error("--allow-inference requires exactly one --profile and one --model, "
                 "and cannot be combined with --declared-only")
    profiles = args.profiles
    run_mode = ("probe-all" if args.probe_all else "auto" if args.allow_inference
                else "declared-only")
    only = set(args.models) if args.models else None
    baseline = prior_values(profiles)
    started = time.monotonic()
    identities = {}
    values, notes, sources = probe_all(profiles, args.jobs, run_mode, only,
                            args.probe_timeout, args.deadline,
                            args.bisect_accepts if args.bisect else 0, identities=identities)
    if not values:
        # What went wrong, then what was protected, then the fix -- one line each.
        unknown = sorted({model for reason, model in notes if reason == UNRESOLVED})
        groups: dict[str, list[str]] = {}
        for reason, subject in notes:
            if reason != UNRESOLVED:
                groups.setdefault(reason, []).append(subject)
        print("Nothing discovered.", file=sys.stderr)
        for reason, subjects in groups.items():
            # Grouped by reason: 46 models failing the same way is one line, not 46.
            if len(subjects) == 1:
                line = reason if subjects[0] in reason else f"{subjects[0]}: {reason}"
            else:
                names = ", ".join(sorted(subjects)[:4])
                if len(subjects) > 4:
                    names += f", and {len(subjects) - 4} more"
                line = f"{reason} ({len(subjects)}): {names}"
            print(f"  {line}", file=sys.stderr)
        if not notes:
            print(f"  no route produced a model listing "
                  f"(profiles tried: {', '.join(profiles or [])})", file=sys.stderr)
        if baseline:
            print(f"{len(baseline)} saved limit(s) untouched.", file=sys.stderr)
        if unknown:
            report_unresolved(unknown, profiles)
        return 1

    unknown = sorted({model for reason, model in notes if reason == UNRESOLVED})

    if args.check:
        drift = {key: (baseline.get(key), value) for key, value in values.items()
                 if baseline.get(key) != value}
        for key, (before, after) in sorted(drift.items()):
            print(f"DRIFT {key}: {before} -> {after}")
        if not drift and not unknown:
            print("No context-limit changes found.")
        if unknown:
            report_unresolved(unknown, profiles)
        return 2 if drift else 1 if unknown else 0

    remaining = args.deadline - (time.monotonic() - started)
    if remaining <= 0:
        print("deadline reached before profile write; existing values left unchanged", file=sys.stderr)
        return 1
    try:
        with run_deadline(remaining):
            result = commit(values, notes, baseline, identities, sources)
    except RunDeadline:
        print("Save deadline reached; completed profile updates were kept, and no partial files were written.", file=sys.stderr)
        return 1
    # What happened, THEN what is still open and how to close it. Printing the
    # unresolved advice before the write meant the last thing on screen was a
    # bookkeeping line about the models that already worked, burying the only part
    # of the output that asked the reader to do something.
    if unknown:
        report_unresolved(unknown, profiles)
    return result or int(bool(unknown))


if __name__ == "__main__":
    raise SystemExit(main())
