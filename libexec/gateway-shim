#!/usr/bin/env python3
"""id-uniquifier shim — sits between Claude Code and cliproxyapi.

Root cause of a run of session deaths traced on a private gateway: its
Anthropic translation mints DETERMINISTIC tool_use ids (Bash_0, Edit_115 —
verified on every response, direct or via cliproxyapi). Claude Code's transcript-repair treats a repeated id as a
corrupted duplicate and strips the block from the model's context, planting
"[Tool use interrupted]" (or "[Tool use removed]") placeholders in its place.
The model then sees its calls missing, orphaned/empty user messages, and the
placeholder text — "my tool calls keep getting interrupted", "the user keeps
sending empty messages" — spirals, and finally parrots the placeholder as its
own reply. That emission poisons every later turn.

This shim kills the seed at the wire: every tool_use id in a response is
rewritten to a globally unique value before Claude Code ever sees it. CC
echoes the rewritten id in its tool_result, so the history stays
self-consistent; the upstream treats ids as opaque. No dup ids → nothing for
the repair pass to eat → the placeholder never enters the model's context.

Passthrough for everything else: non-SSE responses are passed byte-identical
unless they are JSON containing tool_use blocks; SSE streams are filtered
line-by-line so streaming latency is unchanged. Stdlib only.

Ids are minted as toolu_shim_<per-process-random>_<n>. The random half is
load-bearing, not decoration — see _unique().

Metadata sidecar: when the adapter launches this shim it also hands over the
selected route (CCMORPH_MODEL_ROUTE), and every /v1/messages response then
drops one metadata-only row at
${XDG_STATE_HOME:-~/.local/state}/ccmorph/usage/<sha256(response_id)>.json
(a recycled id spills to <sha256(response_id.turn_id)>.json, or on to a further
<sha256(response_id.turn_id.N)>.json, instead of overwriting), so a response id
quoted in a transcript can be joined to what that
turn cost, including the gateway's own billed `usage.cost` when it reports one.
No session is identified here, no prompt, header or credential is written, and
a sidecar failure leaves the relayed bytes exactly as they were — see
UsageSidecar.

Requests keep the client's schema: body, `metadata`, the User-Agent and every
header go upstream exactly as the client sent them, except one per-profile
opt-in: --random-device-id swaps the `device_id` inside `metadata.user_id` for a
random 64-hex value minted once per session (the session id passes through, so
caching and affinity are untouched). A launcher that may be killed outright
passes --parent-pid=<pid>: the shim exits when that process disappears,
ccmorph-adapter's own flag of that name.

Per-profile request hooks (issue 438): when CCMORPH_SHIM_HOOKS points at a
Python module, the shim loads it once at startup and calls it on every request
— user_agent(client_ua) -> str rewrites the outbound User-Agent,
repair_request(payload) -> bool mutates the parsed request body (True means
re-serialize it), outbound_headers(headers, session) mutates the outgoing
headers in place (a hook replacing a header must drop its case-variants
first). With hooks present the session id is captured from metadata.user_id on
every POST, not only under --random-device-id; a raising hook leaves the
request bytes unchanged. Gateway-specific rewrites live in such a module — an
addon, outside this file — never here.
"""

import collections
import copy
import datetime
import errno
import importlib.util
import json
import os
import re
import secrets
import socket
import socketserver
import sys
import time
import subprocess
import threading
import tempfile
import hashlib
import hmac
import random
import urllib.error
import urllib.parse
import urllib.request
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from itertools import count

HOP_BY_HOP = frozenset({
    "host", "content-length", "connection", "transfer-encoding",
    "keep-alive", "proxy-authenticate", "proxy-authorization", "te",
    "trailer", "upgrade",
})

# Stripped from the upstream request on top of HOP_BY_HOP: the shim must see
# the response body in the clear to rewrite it (see _proxy).
REQUEST_DROP = HOP_BY_HOP | {"accept-encoding"}

# ccmorph's own tags — any x-ccmorph-* header, listed here or not — end at the
# shim: the launcher writes them into ANTHROPIC_CUSTOM_HEADERS, and a session
# started before a tag was retired still carries it. Claude Code's identifiers
# pass through so the request keeps its normal shape; only --random-device-id
# rewrites device_id (a per-profile opt-in).
INTERNAL_PREFIX = "x-ccmorph-"

# The POST bodies that carry `metadata.user_id` (--random-device-id).
METADATA_PATHS = frozenset({"/v1/messages", "/v1/messages/count_tokens"})

# Per-profile request hooks (issue 438): when CCMORPH_SHIM_HOOKS points at a
# module, main() loads it once into HOOKS. The module may define:
#   user_agent(client_ua) -> str          outbound User-Agent
#   repair_request(payload) -> bool       mutate the parsed request body;
#                                        True means re-serialize it
#   outbound_headers(headers, session)    mutate the outgoing headers in place
# Nothing gateway-specific lives in this file; the module does.
HOOKS = None

# Task tags. The launcher turns CCMORPH_TASK / CCMORPH_ATTEMPT into these request headers
# (Claude Code's ANTHROPIC_CUSTOM_HEADERS); they end here, never upstream.
TASK_RE = re.compile(r"^[A-Za-z0-9._-]{1,64}$")    # opaque id: no slash, so no path or repo
OUTCOMES = ("accepted", "rejected", "escalated", "parked")
NO_TAGS = {"task": None, "attempt": 1}


def task_tags(headers):
    """The whitelisted task/attempt tags from the request headers."""
    task = (headers.get("x-ccmorph-task") or "").strip()
    attempt = (headers.get("x-ccmorph-attempt") or "").strip()
    return {"task": task if TASK_RE.fullmatch(task) else None,
            # fullmatch on ASCII digits only: isdigit() also accepts "²", which raises in int().
            "attempt": int(attempt) if re.fullmatch(r"[0-9]{1,3}", attempt) and 0 < int(attempt) < 1000 else 1}




def load_hooks(path):
    """The profile's request-hook module, or a loud exit: a profile pointing at
    a module that is not there must fail at startup, never serve with its
    rewrites silently missing."""
    if not os.path.isfile(path):
        sys.exit(f"gateway-shim: CCMORPH_SHIM_HOOKS is not a file: {path}")
    spec = importlib.util.spec_from_file_location("ccmorph_shim_hooks", path)
    if not spec or not spec.loader:
        sys.exit(f"gateway-shim: cannot load hooks module: {path}")
    module = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(module)
    return module


# Events after which the upstream sends NOTHING but keeps the socket open for
# reuse. The shim must end the client response at these, or the client waits
# forever for bytes that never come.
TERMINAL_EVENTS = frozenset({"message_stop", "error"})

# Compact separators match the wire form cliproxyapi emits, so a rewritten
# data line differs from the original only in the id itself.
COMPACT = (",", ":")
EOF_RETRY_NEEDLE = b"unexpected EOF"
EOF_RETRY_PATH = b"/v1/messages"
EOF_RETRIES = 1

# Transport retry, on only with --retry-transport. The adapter sets it when the
# shim fronts a provider directly; behind the translator, cliproxyapi's own
# request-retry owns retries, so attempts must not multiply. The shim resends
# the same bytes to the same target, and only before the client has any bytes.
# A stall (STALL_ERRORS) is not retried: it already waited STALL_TIMEOUT, and
# Claude Code retries that itself.
RETRY_STATUSES = frozenset({429, 500, 502, 503, 504, 529})
TRANSPORT_RETRIES = 2
RETRY_BASE = float(os.environ.get("CCMORPH_RETRY_BASE") or 0.5)


def retry_delay(retry):
    """Full jitter: retry 1 waits up to RETRY_BASE seconds, retry 2 up to twice that."""
    return random.uniform(0, RETRY_BASE * 2 ** (retry - 1))


def wrapped_timeout(error):
    """A timeout however urllib delivers it: the connect phase's timeout arrives
    inside URLError. Three attempts at STALL_TIMEOUT each would outlast every
    client's own request timeout, so the retry rule must see through both."""
    return isinstance(error, STALL_ERRORS) or isinstance(getattr(error, "reason", None), STALL_ERRORS)


BREAKER_FAILURES = 3        # requests that still failed after their retries...
BREAKER_WINDOW = 300        # ...within this many seconds open the breaker...
BREAKER_OPEN = 600          # ...for this long; then the next real request probes it.


class Breaker:
    """The circuit for the one provider this shim fronts (one shim per launch).

    It counts requests that still failed after their retries, never single
    attempts, so a blip cannot take a single-provider route offline. While open
    the shim answers a readable 503 without calling out. After BREAKER_OPEN the
    next real request is the probe (no synthetic call is ever made): success
    closes the breaker, failure reopens it.
    """

    def __init__(self, clock=time.monotonic):
        self.clock = clock
        self.lock = threading.Lock()
        self.failures = []
        self.opened = None
        self.probing = False

    def wait(self):
        """None when a request may go upstream, else the seconds until one may."""
        with self.lock:
            if self.opened is None:
                return None
            left = BREAKER_OPEN - (self.clock() - self.opened)
            if left > 0 or self.probing:
                return max(left, 1)
            self.probing = True
            return None

    def record(self, ok):
        with self.lock:
            now = self.clock()
            if ok:
                self.failures, self.opened, self.probing = [], None, False
            elif self.probing:
                self.opened, self.probing = now, False
            else:
                self.failures = [t for t in self.failures if now - t < BREAKER_WINDOW] + [now]
                if len(self.failures) >= BREAKER_FAILURES:
                    self.failures, self.opened = [], now


def breaker_message(seconds):
    return (f"the provider failed {BREAKER_FAILURES} requests within {BREAKER_WINDOW // 60} min; "
            f"ccmorph holds calls to it for {seconds:.0f}s more, then tries one")

# Sidecar vocabulary. PARSE_NEEDLES is the existing id-rewriting hot-path
# filter; a capturing shim widens it by the two events that carry the response
# id and its usage, and nothing else changes about the streaming path.
PARSE_NEEDLES = (b'"tool_use"', b'"message_stop"', b'"error"')
CAPTURE_NEEDLES = PARSE_NEEDLES + (b'"message_start"', b'"message_delta"')
# The buckets we have actually seen billed. Anything else — service_tier's
# string, a future field, a nested object we do not know — stays out of the row.
USAGE_BUCKETS = ("input_tokens", "output_tokens",
                 "cache_creation_input_tokens", "cache_read_input_tokens")
# The gateway's own billed cost for the turn. A gateway that bills per turn reports it as usage.cost.
# Kept only as a non-negative number below COST_LIMIT; see usage_buckets().
COST_BUCKET = "cost"
# The largest dollar amount a float still holds to the cent. A float keeps cents, not
# dollars, exactly, so past this the report could not print the number it read. A cost
# this large is no billed turn, and summing a few of them is what overflows a float total.
COST_LIMIT = 2 ** 53 / 100
CACHE_CREATION_BUCKETS = ("ephemeral_5m_input_tokens", "ephemeral_1h_input_tokens")

# The longest the upstream may stay silent — before its reply starts, or between two
# chunks of a stream — before the shim ends the exchange with an error. Claude Code
# waits far longer on an open request, so without this a stalled gateway shows as a
# reply that never comes. An error is visible and Claude Code retries it. Generous
# by default: a gateway that buffers extended thinking sends nothing until it is done.
STALL_TIMEOUT = float(os.environ.get("CCMORPH_STALL_TIMEOUT") or 300)
# The exceptions that mean "the provider said nothing". Named as a tuple because
# on 3.9 (the macOS system python, which launches this shim) socket.timeout is
# not TimeoutError: the stall arm and the no-retry rule must both see it.
STALL_ERRORS = (TimeoutError, socket.timeout)


def stall_message(seconds):
    return f"gateway sent nothing for {seconds:.0f}s; ended by ccmorph so the session can retry"



class SameOriginRedirect(urllib.request.HTTPRedirectHandler):
    """Never carry the credential to another origin (mirrors the class of the
    same name in ccmorph-adapter): urllib copies request headers, including
    x-api-key/Authorization, onto a redirect target. Same-origin redirects
    follow; a cross-origin one fails as a transport error."""

    @staticmethod
    def _origin(url):
        parts = urllib.parse.urlsplit(url)
        return parts.scheme.lower(), parts.netloc.lower()

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if self._origin(newurl) != self._origin(req.full_url):
            raise urllib.error.URLError(
                f"cross-origin redirect refused: {req.full_url} -> {newurl}")
        return super().redirect_request(req, fp, code, msg, headers, newurl)

OPENER = urllib.request.build_opener(SameOriginRedirect())
# Loopback target (the translator): no proxy, whatever http_proxy says (same reason
# as --noproxy '*' in ccmorph.sh). A remote target and the catalogue keep OPENER.
LOOPBACK = urllib.request.build_opener(urllib.request.ProxyHandler({}), SameOriginRedirect())


class ModelRoutes:
    """Prepare a selected model before sending its first request, never replay it.

    A spec without "config" fronts the gateway directly (no translator). Declared
    non-Messages mapped targets must be rejected before incompatible forwarding.
    """
    def __init__(self, spec):
        self.command = ([sys.executable, spec["adapter"], spec["profile"],
                         "--ensure-config", spec["config"], "--ensure-port", str(spec["port"]),
                         "--ensure-identity", spec["identity"]]
                        if spec.get("config") else None)
        self.known = set(spec["models"])
        self.model_map = spec.get("model_map", {})
        self.catalogue = Catalogue(spec.get("upstream"), spec.get("models_url"))
        self.key_sha256 = spec["key_sha256"]
        self.timeout = float(spec["timeout"]) + 5
        self.lock = threading.Lock()
        # The adapter always names the profile; without one there is no route to
        # attribute a row to, so the sidecar stays off and the shim writes nothing.
        self.usage = (UsageSidecar(spec["profile"], spec.get("identity", ""))
                      if spec.get("profile") else None)

    def mapping_target(self, model):
        """The explicit map target for a request's wire id, or None."""
        if not isinstance(model, str):
            return None
        return self.model_map.get(model[:-4] if model.endswith("[1m]") else model)

    def ensure(self, body, key=None, requested=None, path="/v1/messages"):
        try:
            payload = json.loads(body)
        except (ValueError, TypeError):
            return None
        model = payload.get("model") if isinstance(payload, dict) else None
        if not isinstance(model, str):
            return None
        model = model[:-4] if model.endswith("[1m]") else model
        if self.command is None:
            # Same rule as _resolve: one key, the wire id. A suffixed key decides
            # nothing, so this request must not count as mapped either.
            base = requested[:-4] if requested and requested.endswith("[1m]") else requested
            if base in self.model_map:
                self.catalogue.served(key, model)
                endpoints = self.catalogue.endpoints.get(model)
                if (endpoints is not None and "/v1/messages" not in endpoints
                        and path not in endpoints
                        and any(endpoint in endpoints for endpoint in ("/v1/responses", "/v1/chat/completions"))):
                    return (f"Mapped model {model!r} requires translation: the gateway declares "
                            "a non-Messages endpoint only. This native edge cannot prepare "
                            "its adapter; use a translation-capable route for this map.")
            return None
        if model in self.known:
            return None
        if not self.lock.acquire(timeout=self.timeout):
            return "Another model is being prepared; retry this request."
        try:
            if model in self.known:
                return None
            try:
                result = subprocess.run(self.command + ["--model", model],
                                        stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                                        timeout=self.timeout)
            except (OSError, subprocess.TimeoutExpired):
                return f"Could not prepare model {model!r} within the compatibility deadline."
            if result.returncode:
                return f"Model {model!r} could not be prepared; check gateway availability and adapter compatibility."
            self.known.add(model)
            return None
        finally:
            self.lock.release()


# --- model identity -----------------------------------------------------------
# Claude Code and the Claude apps speak Anthropic model ids; that is the only
# vocabulary this shim shows them. Two gateway habits break it: answering under
# an internal name (Int_Cl_Opus_5.5_20260922_ULT, which the phone then
# displays), and a catalogue that moves (a new Opus appears, an old one is
# retired). Requests keep the asked id when the gateway serves it and otherwise
# take the newest served model of the SAME family whose version is not older
# than the asked one (never another family, never a downgrade); responses carry the Anthropic id that was sent.
CLAUDE_ID = re.compile(r"^claude-(?P<family>[a-z]+)-(?P<version>\d+(?:-\d{1,2})?)(?:-\d{8})?$")
CATALOGUE_TTL = 600          # a moving catalogue is re-read at most this often...
CATALOGUE_MISS_TTL = 60      # ...or this often while an asked id is missing
CATALOGUE_DEADLINE = 20      # total wait for connect, headers and body together
CATALOGUE_MAX_BYTES = 1024 * 1024


def claude_version(model):
    """(family, version tuple) for an Anthropic id, else None."""
    match = CLAUDE_ID.match(model) if isinstance(model, str) else None
    if not match:
        return None
    # A trailing -0 is spelling (claude-opus-5-0 is claude-opus-5), not a newer version.
    parts = [int(part) for part in match["version"].split("-")]
    while len(parts) > 1 and parts[-1] == 0:
        parts.pop()
    return match["family"], tuple(parts)


def resolve_model(model, served):
    """The id to send for `model`, given the gateway's served ids."""
    if not served or model in served:
        return model
    wanted = claude_version(model)
    if wanted is None:
        return model
    # The asked version under another spelling (a dated id) beats a newer one;
    # an older version is never substituted: the gateway's own error is better.
    same = [(version == wanted, version[1], candidate) for candidate in served
            if (version := claude_version(candidate)) and version[0] == wanted[0]
            and version[1] >= wanted[1]]
    return max(same)[2] if same else model


class Catalogue:
    """The gateway's served model ids, read from its own /v1/models."""

    def __init__(self, upstream, models_url=None):
        self.upstream = (upstream or "").rstrip("/")
        self.models_url = models_url or self.upstream + "/v1/models"
        self.ids = set()
        self.endpoints = {}
        self.read_at = None
        self.lock = threading.Lock()
        self.reader = None

    def _read(self, key, result, deadline):
        headers = {"x-api-key": key, "Authorization": f"Bearer {key}"}
        try:
            req = urllib.request.Request(self.models_url, headers=headers)
            with OPENER.open(req, timeout=CATALOGUE_DEADLINE) as resp:
                body = bytearray()
                # Shutdown interrupts even a read stuck in trickled chunk
                # framing. close() alone can wait on the buffered reader's lock.
                transport = getattr(getattr(getattr(resp, "fp", None), "raw", None), "_sock", None)
                def expire():
                    try:
                        transport.shutdown(socket.SHUT_RDWR)
                    except OSError:
                        pass
                timer = None
                remaining = deadline - time.monotonic()
                if remaining <= 0:
                    return
                if transport is not None:
                    timer = threading.Timer(remaining, expire)
                    timer.daemon = True
                    timer.start()
                try:
                    while time.monotonic() < deadline:
                        # read1 returns after one read, without accumulating an
                        # unbounded body while waiting for EOF.
                        chunk = resp.read1(min(65536, CATALOGUE_MAX_BYTES + 1 - len(body)))
                        if time.monotonic() >= deadline:
                            return
                        if not chunk:
                            # read1 does not enforce Content-Length at EOF.
                            if getattr(resp, "length", None):
                                return
                            break
                        body.extend(chunk)
                        if len(body) > CATALOGUE_MAX_BYTES:
                            return
                    else:
                        return
                    data = json.loads(body).get("data", [])
                finally:
                    if timer is not None:
                        timer.cancel()
            rows = (m for m in data
                    if isinstance(m, dict) and isinstance(m.get("id"), str))
            declarations = {}
            count_tokens = set()
            for row in rows:
                endpoints = row.get("supported_endpoints")
                if isinstance(endpoints, list) and "/v1/messages/count_tokens" in endpoints:
                    count_tokens.add(row["id"])
                # Match dialect_auto: malformed declarations stop the scan;
                # lists without a serving endpoint allow a later duplicate.
                if row["id"] in declarations:
                    previous = declarations[row["id"]]
                    if previous is None or any(path in previous for path in
                            ("/v1/messages", "/v1/responses", "/v1/chat/completions")):
                        continue
                declarations[row["id"]] = list(endpoints) if isinstance(endpoints, list) else None
            # Token counting is independent of the canonical message dialect.
            for model in count_tokens:
                endpoints = declarations[model]
                if endpoints is not None and "/v1/messages/count_tokens" not in endpoints:
                    endpoints.append("/v1/messages/count_tokens")
            if time.monotonic() <= deadline:
                result.append(declarations)
        except Exception:  # noqa: BLE001 — an unreadable catalogue means "send as asked"
            pass

    def served(self, key, model):
        if not self.upstream:
            return set()
        with self.lock:
            age = time.monotonic() - self.read_at if self.read_at is not None else float("inf")
            stale = age > CATALOGUE_TTL or (model not in self.ids and age > CATALOGUE_MISS_TTL)
            if stale and not (self.reader and self.reader.is_alive()):
                self.read_at = time.monotonic()
                result = []
                # Bound the caller's whole wait, including trickled headers.
                # The body reader shuts down its transport at this deadline;
                # discard late results and never overlap catalogue readers.
                deadline = self.read_at + CATALOGUE_DEADLINE
                try:
                    self.reader = threading.Thread(target=self._read,
                                                   args=(key, result, deadline), daemon=True)
                    self.reader.start()
                    self.reader.join(max(0, deadline - time.monotonic()))
                    if self.reader.is_alive() or time.monotonic() > deadline or not result:
                        self.ids = set()
                        self.endpoints = {}
                    else:
                        self.endpoints = result[0]
                        self.ids = set(result[0])
                except Exception:  # noqa: BLE001 — reader failures also fail open
                    self.ids = set()
                    self.endpoints = {}
            return self.ids


def encode_json(obj, ensure_ascii=True):
    """Compact UTF-8 JSON for a whole request body. json.dumps grows one buffer
    by realloc; on macOS each multi-MB body leaves the freed steps cached, and a
    session-long shim settled near 500 MB. Joining the encoder's chunks allocates
    the result once."""
    encoder = json.JSONEncoder(separators=COMPACT, ensure_ascii=ensure_ascii)
    return "".join(encoder.iterencode(obj)).encode()


def with_model(body, model):
    """`body` re-serialized with its model replaced."""
    payload = json.loads(body)
    payload["model"] = model
    return encode_json(payload)


# --- gateway error envelope (response side) ------------------------------------
# Some gateways wrap the upstream error as hex inside their own envelope:
#   {"code":400,"detailMsg":"bedrock-claude 400 client error SdkBytes(bytes=0x7b22...)"}
# Claude Code recovers from several 400s on its own (a refused tool_addition
# block: it retries without the beta and keeps it off), but only when it can read
# the upstream message. Unwrapping restores that native recovery.
_SDK_BYTES = re.compile(r"SdkBytes\(bytes=0x([0-9a-fA-F]+)\)")


def unwrap_gateway_error(body):
    """An Anthropic-shaped error for a hex-wrapped gateway error, else None."""
    try:
        payload = json.loads(body)
    except (ValueError, TypeError, RecursionError):
        return None
    if not isinstance(payload, dict):
        return None
    match = _SDK_BYTES.search(str(payload.get("detailMsg", "")))
    if not match:
        return None
    try:
        inner = json.loads(bytes.fromhex(match.group(1)))
    except ValueError:
        return None
    message = inner.get("message") if isinstance(inner, dict) else None
    if not isinstance(message, str):
        return None
    return json.dumps({"type": "error",
                       "error": {"type": "invalid_request_error", "message": message}}).encode()


# --- usage sidecar (metadata only) -------------------------------------------
def _bucket_numbers(source, keys):
    import math

    def finite(value):
        try:
            return math.isfinite(value)
        except OverflowError:
            return False  # an int too large for a float is no billable number

    return {key: source[key] for key in keys
            if isinstance(source.get(key), (int, float))
            and not isinstance(source.get(key), bool)
            and finite(source[key])}


def usage_buckets(usage):
    """Whitelisted numeric usage buckets only, plus the gateway's non-negative `cost`
    below COST_LIMIT. A key we have never seen billed,
    a non-number (service_tier is a string) and a bool (isinstance(True, int))
    all stay out, so nothing here can carry a prompt, a header or a credential."""
    if not isinstance(usage, dict):
        return {}
    buckets = _bucket_numbers(usage, USAGE_BUCKETS)
    cost = _bucket_numbers(usage, (COST_BUCKET,))
    if 0 <= cost.get(COST_BUCKET, -1) < COST_LIMIT:
        buckets.update(cost)
    creation = usage.get("cache_creation")
    if isinstance(creation, dict):
        nested = _bucket_numbers(creation, CACHE_CREATION_BUCKETS)
        if nested:
            buckets["cache_creation"] = nested
    return buckets


def requested_model(body):
    """The body's model ID, exact spelling kept ([1m] and all)."""
    try:
        payload = json.loads(body)
    except (ValueError, TypeError, RecursionError):
        return None
    model = payload.get("model") if isinstance(payload, dict) else None
    return model if isinstance(model, str) else None


class UsageSidecar:
    """One row per upstream response, keyed by the response id it answers with.

    A consumer joins a transcript's message id to <sha256(response_id)>.json.
    Each turn carries a random `turn_id` for row ownership. If a gateway recycles
    a response id, the later turn goes to <sha256(response_id.turn_id)>.json,
    and if that name too holds another turn's row, to the first free
    <sha256(response_id.turn_id.N)>.json with N = 1..3, so even identical
    timestamps preserve both rows. A name is only taken when it is free or
    already holds this turn's own row, so a turn whose every name is taken
    loses its own row rather than destroy someone else's — the claim is
    atomic on every filesystem: a hardlink where they are supported, an
    exclusive create where they are not. There is deliberately no
    session, no prompt, no header and no credential in it — the launch route
    is represented by `route_id`, which is a domain-separated digest of the
    profile and the adapter's route identity. That identity is itself a digest
    of upstream+key (ccmorph-adapter), so neither it, nor the key, its hash,
    the rendered config path or the token is ever written here.

    Rows are written at message_start and again on every usage update, each
    time atomically (tmp + rename, 0600), so a crashed or truncated stream
    still leaves the last known partial row with complete:false rather than
    nothing at all. Every failure is swallowed: the relay owns the result and
    a sidecar that cannot write must not change it.

    `retries` is how many times the shim re-sent this request before the response
    this row describes — the transport retries under --retry-transport, or the
    single unexpected-EOF replay without it, so 0 when it re-sent nothing.
    `attempt` stays the launcher's tag.
    """

    tags = NO_TAGS
    served_model = None
    retries = 0

    def tagged(self, tags):
        """A view of this sidecar whose rows carry `tags` (task, attempt)."""
        view = copy.copy(self)
        view.tags = tags
        return view

    def __init__(self, profile, identity):
        self.profile = profile
        self.route_id = hashlib.sha256(
            "ccmorph-route-v1\0{}\0{}".format(profile, identity).encode()).hexdigest()

    def _start(self, response_id, requested, response_model, usage):
        return {
            "schema": 1,
            "response_id": response_id,
            "turn_id": secrets.token_hex(16),
            "route_id": self.route_id,
            "profile": self.profile,
            "requested_model": requested,
            "served_model": self.served_model,
            "retries": self.retries,
            **self.tags,
            "response_model": response_model if isinstance(response_model, str) else None,
            "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat(),
            "usage": usage,
            "complete": False,
        }

    def _owns(self, path, turn_id):
        """True only when the row on disk at `path` carries `turn_id` —
        the one thing that makes replacing that name safe."""
        try:
            with open(path) as fh:
                return json.load(fh).get("turn_id") == turn_id
        except (OSError, ValueError, AttributeError):
            return False

    def _claim(self, temporary, candidate, turn_id):
        """Place the row in `temporary` at `candidate`, atomically: a hardlink
        under a free name where the filesystem has them, an exclusive create
        where it does not (both fail when the name is taken — that failure is
        the claim), or a replace when the name already holds this record's own
        earlier row. Returns None only when the name belongs to another turn."""
        try:
            os.link(temporary, candidate)
        except FileExistsError:
            # Taken: replace only this turn's own earlier row, never another's.
            if not self._owns(candidate, turn_id):
                return None
        except OSError:
            # No hardlinks here (#444): claim the free name with an exclusive
            # create — os.open(O_CREAT|O_EXCL) fails when the name is taken,
            # so racing writers cannot both take it — then fill it by replace.
            try:
                fd = os.open(candidate, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600)
            except FileExistsError:
                if not self._owns(candidate, turn_id):
                    return None
            else:
                os.close(fd)          # claimed; the replace below fills the name
        else:
            os.unlink(temporary)          # the link already placed the row
            return candidate
        os.replace(temporary, candidate)
        return candidate

    def _write(self, record):
        root = os.environ.get("XDG_STATE_HOME", "").strip() or os.path.join(
            os.path.expanduser("~"), ".local", "state")
        directory = os.path.join(root, "ccmorph", "usage")
        os.makedirs(directory, mode=0o700, exist_ok=True)
        # The consumer joins on sha256(response_id).json, so that is the primary
        # name. A gateway that recycles an id must not overwrite the earlier
        # turn: the primary is claimed atomically, so of the writers racing on
        # one response id only the first holds it and the rest go to
        # sha256(response_id.turn_id), then to sha256(response_id.turn_id.N) if
        # that name is another turn's row too. Recheck the on-disk turn_id on
        # every rewrite: a removed file may have been reclaimed by another turn.
        # A name is replaced only on the strength of this turn's own row being
        # on disk there — the claim itself is a hardlink, or an exclusive
        # create where the filesystem has no hardlinks, both atomic.
        # No claim cache survives a cancelled or truncated stream.
        def named(key):
            return os.path.join(
                directory, hashlib.sha256(key.encode()).hexdigest() + ".json")
        primary = named(record["response_id"])
        key = "{}.{}".format(record["response_id"], record["turn_id"])
        spills = [named(key)] + [named("{}.{}".format(key, n)) for n in range(1, 4)]
        # Exclusive, 0600 creation beside the target keeps rename same-fs and
        # never reopens a leftover hardlink alias after failed unlink cleanup.
        fd, temporary = tempfile.mkstemp(dir=directory, suffix=".tmp")
        try:
            with os.fdopen(fd, "w") as fh:
                json.dump(record, fh, separators=COMPACT)
            # A spill this turn already owns stays its file even if the primary
            # (or an earlier spill) was removed. Ownership still comes from the
            # disk row.
            owned = [s for s in spills if self._owns(s, record["turn_id"])][:1]
            for candidate in owned + [primary] + spills:
                if self._claim(temporary, candidate, record["turn_id"]) is not None:
                    break
            else:
                # Every name belongs to another turn: drop this row, never theirs.
                raise FileExistsError(errno.EEXIST, "usage row names all taken", primary)
        except OSError:
            try:
                os.unlink(temporary)
            except OSError:
                pass
            raise

    def observe(self, event, record, requested):
        """Fold one parsed SSE event into `record` and persist what is known.
        Never raises."""
        try:
            kind = event.get("type") if isinstance(event, dict) else None
            if kind == "message_start":
                message = event.get("message")
                if isinstance(message, dict) and isinstance(message.get("id"), str):
                    record = self._start(message["id"], requested,
                                         message.get("model"),
                                         usage_buckets(message.get("usage")))
                    self._write(record)
            elif record is not None and kind == "message_delta":
                usage = usage_buckets(event.get("usage"))
                if usage:
                    record["usage"].update(usage)
                    self._write(record)
            elif record is not None and kind == "message_stop":
                record["usage"].update(usage_buckets(event.get("usage")))
                record["complete"] = True
                self._write(record)
        except Exception:  # noqa: BLE001 — a sidecar failure is not a relay failure
            pass
        return record

    def response(self, data, requested):
        """A non-stream JSON message is one complete row. Never raises."""
        try:
            payload = json.loads(data)
            if isinstance(payload, dict) and isinstance(payload.get("id"), str):
                record = self._start(payload["id"], requested,
                                     payload.get("model"), usage_buckets(payload.get("usage")))
                record["complete"] = True
                self._write(record)
        except Exception:  # noqa: BLE001 — a sidecar failure is not a relay failure
            pass


class EmptyThinkingStream:
    """An SSE response minus malformed empty thinking: the streamed form of
    IdShim._drop_empty_thinking. A thinking block that starts with no text
    and no signature waits for its next data event. A delta releases it
    untouched (a healthy block that starts empty). Its own
    content_block_stop drops both events, and later blocks' indexes shift
    down so the client still sees 0..n-1. Anything else releases it as is.
    event:/id:/comment lines wait for their data line, so a dropped event
    leaves no orphan header. Nothing is read past a data line except
    while one block is held."""

    def __init__(self, resp):
        self._resp = resp
        self._out = collections.deque()  # lines ready for the relay loop
        self._pending = []               # non-data lines awaiting their data line
        self._held = None                # the held start: head, line, obj, tail, index
        self._dropped = []               # upstream indexes of dropped blocks
        self._swallow_blank = False      # the blank line closing a dropped stop

    def readline(self):
        while not self._out:
            line = self._resp.readline()
            if not line:
                self._release()
                self._out.extend(self._pending)
                self._pending = []
                if not self._out:
                    return b""
                break
            self._feed(line)
        return self._out.popleft()

    def _feed(self, line):
        stripped = line.rstrip(b"\r\n")
        if not stripped:
            if self._swallow_blank:
                self._swallow_blank = False
                self._pending = []
            elif self._held is not None:
                self._held["tail"] += self._pending + [line]
                self._pending = []
            else:
                self._out.extend(self._pending)
                self._out.append(line)
                self._pending = []
            return
        if not stripped.startswith(b"data:"):
            self._pending.append(line)
            return
        payload = stripped[5:].lstrip()
        obj = None
        if (self._held is not None or (self._dropped and b'"index"' in payload)
                or (b'"content_block_start"' in payload and b'"thinking"' in payload)):
            try:
                obj = json.loads(payload)
            except (ValueError, RecursionError):
                obj = None
        if self._held is not None:
            if (isinstance(obj, dict) and obj.get("type") == "content_block_stop"
                    and obj.get("index") == self._held["index"]):
                self._dropped.append(self._held["index"])
                self._held = None
                self._pending = []
                self._swallow_blank = True
                return
            self._release()
        if (isinstance(obj, dict) and obj.get("type") == "content_block_start"
                and isinstance(obj.get("index"), int)
                and IdShim._malformed_empty_thinking(obj.get("content_block"))):
            self._held = {"head": self._pending, "line": line, "obj": obj,
                          "tail": [], "index": obj["index"]}
            self._pending = []
            return
        self._out.extend(self._pending)
        self._pending = []
        self._out.append(self._reindex(line, obj))

    def _release(self):
        if self._held is None:
            return
        held, self._held = self._held, None
        self._out.extend(held["head"])
        self._out.append(self._reindex(held["line"], held["obj"]))
        self._out.extend(held["tail"])

    def _reindex(self, line, obj):
        if (not self._dropped or not isinstance(obj, dict)
                or not isinstance(obj.get("index"), int)):
            return line
        shift = sum(1 for i in self._dropped if i < obj["index"])
        if not shift:
            return line
        obj["index"] -= shift
        stripped = line.rstrip(b"\r\n")
        eol = line[len(stripped):] or b"\n"
        payload = stripped[5:].lstrip()
        prefix = stripped[:len(stripped) - len(payload)]
        return prefix + json.dumps(obj, separators=COMPACT).encode() + eol


class IdShim(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    target = "http://127.0.0.1:0"
    # All off by default: the shim's shipped behavior is id-rewriting only,
    # exactly as before. The adapter turns these on per profile; the profile's
    # request hooks (CCMORPH_SHIM_HOOKS) come through the HOOKS module.
    model_routes = None
    inbound = None
    preserve_ids = False
    random_device_id = False
    retry_transport = False
    breaker = None                       # set by main(): one per shim, one per provider
    sleep = staticmethod(time.sleep)     # injected in tests: the retry waits must not cost real time
    session = None                       # this request's session id, if the client sent one
    _devices = {}                        # session id -> its random device id
    _devices_lock = threading.Lock()
    _counter = count(1)
    _prefix = f"toolu_shim_{os.urandom(4).hex()}_"

    def log_message(self, *args):
        pass

    @classmethod
    def _unique(cls):
        # itertools.count.__next__ is atomic under the GIL; no lock needed.
        #
        # The per-process random prefix is the correctness half. The counter
        # restarts at 1 in every new process, but a Claude Code transcript
        # OUTLIVES the shim — relaunch, profile hop, crash-resume — so a bare
        # toolu_shim_<n> re-mints ids that are already in the transcript,
        # manufacturing precisely the duplicate-id corruption this shim
        # exists to prevent (observed live in 21 transcripts). The prefix
        # makes every process's id space disjoint.
        return f"{cls._prefix}{next(cls._counter)}"

    @classmethod
    def _rewrite_ids(cls, obj):
        """Recursively rewrite every tool_use id; returns True if changed."""
        changed = False
        if isinstance(obj, dict):
            if obj.get("type") == "tool_use" and isinstance(obj.get("id"), str):
                obj["id"] = cls._unique()
                changed = True
            for value in obj.values():
                changed |= cls._rewrite_ids(value)
        elif isinstance(obj, list):
            for item in obj:
                changed |= cls._rewrite_ids(item)
        return changed

    @classmethod
    def _device_id(cls, session):
        """The random device id for a session: minted on first sight, stable for
        its life. Memory only, never logged."""
        with cls._devices_lock:
            return cls._devices.setdefault(session, os.urandom(32).hex())

    def _swap_device_id(self, payload):
        """Replace `metadata.user_id.device_id` (user_id is a JSON string) and
        remember the session id for the request hooks. True if the body changed."""
        meta = payload.get("metadata")
        user_id = meta.get("user_id") if isinstance(meta, dict) else None
        try:
            ids = json.loads(user_id) if isinstance(user_id, str) else None
        except ValueError:
            ids = None
        if not isinstance(ids, dict):
            return False
        if isinstance(ids.get("session_id"), str):
            self.session = self.session or ids["session_id"]
        if not isinstance(ids.get("device_id"), str):
            return False
        ids["device_id"] = self._device_id(self.session)
        user_id = json.dumps(ids, separators=COMPACT, ensure_ascii=False)
        try:
            user_id.encode("utf-8")
        except UnicodeEncodeError:
            # Keep a lone surrogate escaped inside the nested JSON string;
            # escaping only the outer body would make its JSON invalid.
            user_id = json.dumps(ids, separators=COMPACT, ensure_ascii=True)
        meta["user_id"] = user_id
        return True

    def _remember_session(self, payload):
        """Capture the session id from metadata.user_id for the request hooks,
        when --random-device-id is off and nothing else would have looked."""
        meta = payload.get("metadata")
        user_id = meta.get("user_id") if isinstance(meta, dict) else None
        try:
            ids = json.loads(user_id) if isinstance(user_id, str) else None
        except ValueError:
            ids = None
        if isinstance(ids, dict) and isinstance(ids.get("session_id"), str):
            self.session = self.session or ids["session_id"]

    def _proxy(self, body):
        headers = {k: v for k, v in self.headers.items()
                   if k.lower() not in REQUEST_DROP
                   and not k.lower().startswith(INTERNAL_PREFIX)}
        if HOOKS is not None:
            ua_hook = getattr(HOOKS, "user_agent", None)
            if ua_hook:
                # Drop every case-variant first: a dict holding both
                # "User-Agent" and "user-agent" would send the header twice.
                headers = {k: v for k, v in headers.items()
                           if k.lower() != "user-agent"}
                headers["user-agent"] = ua_hook(self.headers.get("User-Agent", ""))
            outbound = getattr(HOOKS, "outbound_headers", None)
            if outbound:
                outbound(headers, self.session)
        # Force identity: a gzipped response fails json.loads and would be
        # passed through UNREWRITTEN and silently — the shim's whole job
        # skipped because the client happened to offer compression. Loopback
        # hop, so the lost compression costs nothing.
        headers["accept-encoding"] = "identity"
        req = urllib.request.Request(self.target + self.path, data=body,
                                     headers=headers, method=self.command)
        host = urllib.parse.urlsplit(self.target).hostname
        opener = LOOPBACK if host in ("127.0.0.1", "localhost", "::1") else OPENER
        return opener.open(req, timeout=STALL_TIMEOUT)

    def _swap_inbound(self):
        """A sandboxed client holds only the per-launch token; check it, then
        send the real key onward so the gateway key never enters the sandbox."""
        authorization = self.headers.get("Authorization", "").strip()
        scheme, _, token = authorization.partition(" ")
        got = self.headers.get("x-api-key") or (token.strip() if scheme.lower() == "bearer" else "")
        if not hmac.compare_digest(hashlib.sha256(got.encode()).hexdigest(), self.inbound["sha256"]):
            return False
        for h in ("x-api-key", "Authorization"):
            del self.headers[h]
        self.headers["x-api-key"] = self.inbound["key"]
        self.headers["Authorization"] = "Bearer " + self.inbound["key"]
        return True

    def _fail(self, status):
        """End the exchange with a bodiless status the client can finish
        reading. Under HTTP/1.1 keep-alive a bodiless response with neither
        content-length nor a close hangs the client forever."""
        self.send_response(status)
        self.send_header("content-length", "0")
        self.send_header("connection", "close")
        self.close_connection = True
        self.end_headers()

    def _error(self, status, message):
        """End the exchange with an Anthropic-shaped error Claude Code can read."""
        data = json.dumps({"type": "error",
                           "error": {"type": "api_error", "message": message}}).encode()
        self.send_response(status)
        self.send_header("content-type", "application/json")
        self.send_header("content-length", str(len(data)))
        self.send_header("connection", "close")
        self.close_connection = True
        self.end_headers()
        self.wfile.write(data)

    def _open(self, body):
        """Open one upstream request. HTTP errors are responses; transport
        errors propagate so the caller can return one finite 502."""
        try:
            return self._proxy(body)
        except urllib.error.HTTPError as e:
            return e

    def _exact_unexpected_eof(self, resp, data):
        """The only safe replay: /v1/messages got a complete 500 JSON response
        before any downstream SSE bytes were sent, and its body identifies
        an upstream POST's unexpected EOF. Unrelated paths/500s pass."""
        return (self.path.split("?", 1)[0].encode().endswith(EOF_RETRY_PATH)
                and resp.status == 500
                and EOF_RETRY_NEEDLE in data)

    def _relay(self):
        if self.inbound and not self._swap_inbound():
            self._fail(401)
            return
        raw = self.headers.get("content-length")
        # An ABSENT header means no body. A PRESENT but unparseable one is
        # rejected: int() accepts underscores and signs, so "1_3" parses as 13
        # and "-1" blocks in rfile.read — either way the body desyncs and the
        # next request on the reused connection is poisoned. An empty value is
        # malformed too, not a synonym for absent. Only ASCII digits pass:
        # str.isdigit() is too loose, since headers are latin-1 decoded and
        # '\xb2' ("²") satisfies isdigit() but raises in int().
        if raw is None:
            length = 0
        elif (v := raw.strip()) and all("0" <= c <= "9" for c in v):
            length = int(v)
        else:
            self.send_error(400, "invalid Content-Length")
            self.close_connection = True
            return
        body = self.rfile.read(length) if length else None
        answer_as = None
        requested = None
        self.session = self.headers.get("x-claude-code-session-id")
        is_message_post = (self.command == "POST"
                           and self.path.split("?", 1)[0] == "/v1/messages")
        is_model_post = (is_message_post or (self.command == "POST"
                         and self.path.split("?", 1)[0] == "/v1/messages/count_tokens"
                         and self.model_routes and self.model_routes.model_map
                         and self.model_routes.mapping_target(requested_model(body)) is not None))
        sidecar = None
        if body and self.model_routes and is_model_post:
            authorization = self.headers.get("Authorization", "").strip()
            scheme, _, token = authorization.partition(" ")
            key = self.headers.get("x-api-key") or (token.strip() if scheme.lower() == "bearer" else "")
            if not hmac.compare_digest(hashlib.sha256(key.encode()).hexdigest(), self.model_routes.key_sha256):
                self._fail(401)
                return
            sidecar = self.model_routes.usage if is_message_post else None
            # The client's choice, before any explicit map or family resolution.
            requested = (requested_model(body)
                         if sidecar is not None or self.model_routes.command is None else None)
            if sidecar is not None:
                sidecar = sidecar.tagged(task_tags(self.headers))
            body, answer_as = self._resolve(body, key)
            if sidecar is not None:
                sidecar.served_model = requested_model(body)
            error = self.model_routes.ensure(body, key, requested, self.path.split("?", 1)[0])
            if error:
                data = json.dumps({"type": "error", "error": {"type": "invalid_request_error", "message": error}}).encode()
                self.send_response(400)
                self.send_header("content-type", "application/json")
                self.send_header("content-length", str(len(data)))
                self.send_header("connection", "close")
                self.end_headers()
                self.wfile.write(data)
                self.close_connection = True
                return
        # Metadata-only capture, only for the one endpoint that answers with a
        # response id and a usage block, and only after the key has been verified.
        # Request hooks (if any) also read every POST body, whatever the path.
        swap = (self.random_device_id and self.command == "POST"
                and self.path.split("?", 1)[0] in METADATA_PATHS)
        if body and (swap or HOOKS is not None):
            body = self._clean_request(body, swap)
        retrying = self.retry_transport and is_message_post
        limit = TRANSPORT_RETRIES if retrying else EOF_RETRIES
        retries = 0
        breaker = self.breaker if retrying else None
        if breaker is not None:
            # The open breaker's answer is the whole exchange: no call goes out,
            # and nothing between here and the try may raise past the loop.
            held = breaker.wait()
            if held is not None:
                self._error(503, breaker_message(held))
                return
        try:
            while True:
                try:
                    resp = self._open(body)
                except STALL_ERRORS:
                    raise
                except Exception as error:  # noqa: BLE001 — refused/reset before any reply
                    if not (retrying and retries < limit and not wrapped_timeout(error)):
                        raise
                    retries += 1
                    self.sleep(retry_delay(retries))
                    continue
                ctype = resp.headers.get("content-type", "")
                # Read only non-SSE bodies before sending downstream headers.
                # That makes the exact EOF 500 safely replayable; healthy SSE
                # streams keep their original low-latency line-by-line path.
                if "text/event-stream" not in ctype:
                    data = resp.read()
                    failed = (resp.status in RETRY_STATUSES if retrying
                              else self._exact_unexpected_eof(resp, data))
                    if failed and retries < limit:
                        resp.close()
                        retries += 1
                        if retrying:
                            self.sleep(retry_delay(retries))
                        continue
                    break
                data = None
                if retrying and resp.status in RETRY_STATUSES and retries < limit:
                    # A failing status that declares itself a stream, with
                    # nothing sent downstream yet: only a delivered stream's
                    # bytes are unreplayable, so this one is retried like any
                    # other failed request.
                    resp.close()
                    retries += 1
                    self.sleep(retry_delay(retries))
                    continue
                break
        except STALL_ERRORS:
            if breaker is not None:
                breaker.record(False)
            self._error(504, stall_message(STALL_TIMEOUT))
            return
        except Exception:  # noqa: BLE001 — target down: say so, never hang
            if breaker is not None:
                breaker.record(False)
            self._fail(502)
            return

        if breaker is not None:
            breaker.record(resp.status not in RETRY_STATUSES)
        if sidecar is not None:
            sidecar.retries = retries
        with resp:
            self.send_response(resp.status)
            for k, v in resp.headers.items():
                if k.lower() not in HOP_BY_HOP:
                    self.send_header(k, v)
            if "text/event-stream" in ctype:
                self.end_headers()
                self._stream_sse(resp, sidecar, requested, answer_as)
            else:
                if "json" in ctype:
                    data = (unwrap_gateway_error(data) if resp.status >= 400 else None) \
                        or self._rewrite_json(data, answer_as)
                self.send_header("content-length", str(len(data)))
                self.end_headers()
                self.wfile.write(data)
                # After the client has its bytes: the response is the product,
                # the row is bookkeeping.
                if sidecar is not None:
                    sidecar.response(data, requested)

    @staticmethod
    def _malformed_empty_thinking(block):
        """A malformed block: thinking with no text and no signature. A signed
        empty block is a valid omitted-display block — the client replays it
        unchanged, signature and all — so it is not malformed."""
        return (isinstance(block, dict) and block.get("type") == "thinking"
                and not block.get("thinking")
                and not (isinstance(block.get("signature"), str)
                         and block["signature"]))

    @staticmethod
    def _drop_empty_thinking(obj):
        """Remove malformed empty thinking blocks from any `content` list;
        True if anything was removed. A gateway can return such a block, and
        Claude Code replays it in the next request, which the API rejects with
        a 400. A signed empty block is a valid omitted-display block the
        client must replay, so it is kept whole. `tool_use.input` is opaque,
        tool-owned JSON — a thinking-shaped record inside it is application
        data, not API content — so the walk stops at that boundary. Streamed
        replies get the same treatment in EmptyThinkingStream."""
        changed = False
        if isinstance(obj, dict):
            content = obj.get("content")
            if isinstance(content, list):
                kept = [b for b in content
                        if not IdShim._malformed_empty_thinking(b)]
                if len(kept) != len(content):
                    obj["content"] = kept
                    changed = True
            tool_input = obj.get("type") == "tool_use"
            for key, value in obj.items():
                if tool_input and key == "input":
                    continue
                changed |= IdShim._drop_empty_thinking(value)
        elif isinstance(obj, list):
            for item in obj:
                changed |= IdShim._drop_empty_thinking(item)
        return changed

    @classmethod
    def _try_rewrite(cls, obj):
        """_rewrite_ids plus _drop_empty_thinking, but a payload too deep for
        the recursion limit is reported as unchanged instead of killing the
        response. Passing a deep payload through byte-identical beats dropping
        it with no status: a nesting depth that blows the stack cannot be
        carrying a tool_use block Claude Code would act on anyway."""
        changed = False
        try:
            if not cls.preserve_ids:
                changed |= cls._rewrite_ids(obj)
            changed |= cls._drop_empty_thinking(obj)
        except RecursionError:
            pass
        return changed

    def _resolve(self, body, key):
        """(body to send, Anthropic id to answer as). Never raises."""
        try:
            asked = json.loads(body).get("model")
        except (ValueError, TypeError, AttributeError, RecursionError):
            return body, None
        if not isinstance(asked, str):
            return body, None
        base = asked[:-4] if asked.endswith("[1m]") else asked
        # One lookup, on the id this request will be routed by: the window marker
        # is stripped from it, the shell strips it before it hands a map its model
        # and refuses a key that carries it -- so a second lookup on the exact
        # spelling could only pick a target nothing else resolved.
        mapped = self.model_routes.mapping_target(asked)
        if mapped is not None:
            # Explicit maps are final: do not substitute even a newer Claude target.
            target = mapped[:-4] if mapped.endswith("[1m]") else mapped
            return with_model(body, target), base
        if claude_version(base) is None:
            return body, None
        served = self.model_routes.catalogue.served(key, base)
        chosen = resolve_model(base, served)
        if chosen == base:
            if served and base not in served:
                print(f"gateway-shim: {base} is not served and no same-family model of "
                      "that version or newer is; sending it unchanged",
                      file=sys.stderr, flush=True)
            return body, base
        print(f"gateway-shim: {base} is not served; sending newest same-family {chosen}",
              file=sys.stderr, flush=True)
        return with_model(body, chosen + asked[len(base):]), chosen

    @staticmethod
    def _answer_as(obj, answer_as):
        """Report the Anthropic id on a message or message_start; True if changed."""
        if not answer_as or not isinstance(obj, dict):
            return False
        message = obj.get("message") if obj.get("type") == "message_start" else obj
        if (isinstance(message, dict) and message.get("type") == "message"
                and isinstance(message.get("model"), str) and message["model"] != answer_as):
            message["model"] = answer_as
            return True
        return False

    def _clean_request(self, body, swap):
        """One parse, one dump: run the profile's request hooks (if any) and swap
        the device id in `metadata` when `swap`. Not a JSON object, too deep, or
        nothing changed ⇒ the original bytes go upstream. ensure_ascii=False keeps
        CJK at one UTF-8 copy, not a \\uXXXX escape."""
        try:
            payload = json.loads(body)
            if not isinstance(payload, dict):
                return body
            changed = False
            if HOOKS is not None:
                repair = getattr(HOOKS, "repair_request", None)
                if repair:
                    changed = bool(repair(payload))
                if not swap:
                    self._remember_session(payload)
            if swap:
                changed = self._swap_device_id(payload) or changed
            if not changed:
                return body
            try:
                return encode_json(payload, ensure_ascii=False)
            except UnicodeEncodeError:
                # A lone \udXXX escape parses but cannot UTF-8 encode; escape it
                # rather than let the except below send the un-swapped body upstream.
                return encode_json(payload)
        except (ValueError, RecursionError):
            return body

    def _rewrite_json(self, data, answer_as=None):
        try:
            payload = json.loads(data)
        except (ValueError, RecursionError):
            return data
        renamed = self._answer_as(payload, answer_as)
        if not self._try_rewrite(payload) and not renamed:
            return data
        return json.dumps(payload).encode()

    def _stream_sse(self, resp, sidecar=None, requested=None, answer_as=None):
        # An SSE response carries no content-length, so EOF is the ONLY
        # completion signal the client has: every exit from this loop must
        # close the client connection, or a keep-alive client waits forever.
        self.close_connection = True
        try:
            self._stream_loop(EmptyThinkingStream(resp), sidecar, requested, answer_as)
        except (BrokenPipeError, ConnectionResetError):
            # The client hung up mid-stream (cancelled turn, /clear, quit).
            # Routine, not an error — a traceback here just spams the shared
            # adapter log.
            pass
        except STALL_ERRORS:
            # The upstream went quiet mid-reply. Say so as a stream error event,
            # the same shape an overloaded Anthropic stream ends with.
            event = {"type": "error", "error": {"type": "api_error",
                                                "message": stall_message(STALL_TIMEOUT)}}
            try:
                self.wfile.write(b"event: error\ndata: " + json.dumps(event).encode() + b"\n\n")
                self.wfile.flush()
            except OSError:
                pass

    def _stream_loop(self, resp, sidecar=None, requested=None, answer_as=None):
        wfile = self.wfile
        # Per-response capture state: the row keyed by this stream's response id,
        # filled at message_start and updated in place afterwards.
        record = None
        needles = CAPTURE_NEEDLES if sidecar is not None or answer_as else PARSE_NEEDLES
        while True:
            line = resp.readline()
            if not line:
                # Upstream EOF, including a truncated stream with no
                # message_stop. Nothing more will arrive; stop.
                return
            stripped = line.rstrip(b"\r\n")
            # Preserve the original terminator: the upstream stream is LF and
            # emitting a CRLF data line mid-stream mixes framings.
            eol = line[len(stripped):] or b"\n"
            # cliproxyapi sends "data:{...}" without the space; both forms
            # are legal SSE
            if stripped.startswith(b"data:") and stripped != b"data: [DONE]":
                payload = stripped[5:].lstrip()
                # "data:" or "data: " — whichever the upstream used, reuse it
                prefix = stripped[:len(stripped) - len(payload)]
                # Hot-path pre-filter: text deltas dominate streaming traffic
                # and carry neither tool_use ids nor message_stop. A substring
                # scan skips json.loads for ~95%+ of events. The scan is
                # conservative: any event containing one of the needles is
                # parsed, even if the match is in text content (harmless —
                # just a wasted parse). A capturing shim adds the two events
                # that carry the response id and its usage to the scan.
                if not any(needle in payload for needle in needles):
                    wfile.write(line)
                    wfile.flush()
                    continue
                try:
                    obj = json.loads(payload)
                except (ValueError, RecursionError):
                    obj = None
                renamed = self._answer_as(obj, answer_as)
                if obj is not None and (self._try_rewrite(obj) | renamed):
                    # Rewrite the data line in place: same "data:" prefix,
                    # same terminator. The blank line that closes the SSE
                    # event is a SEPARATE line in the stream and still
                    # arrives from the upstream on the next readline().
                    line = (prefix
                            + json.dumps(obj, separators=COMPACT).encode()
                            + eol)
                wfile.write(line)
                wfile.flush()
                # After the client has the event, so capture never sits in the
                # stream's latency path. A stream that dies with no terminal
                # event simply leaves the row it last wrote, complete:false.
                if sidecar is not None:
                    record = sidecar.observe(obj, record, requested)
                # message_stop, and an error event (overloaded_error and
                # friends), are terminal: upstreams keep the connection alive
                # for reuse and send NOTHING after them — do not wait for
                # bytes that never come. Emit the blank line that closes the
                # event first, since returning here means the client never
                # sees the upstream's own.
                if isinstance(obj, dict) and obj.get("type") in TERMINAL_EVENTS:
                    wfile.write(eol)
                    wfile.flush()
                    return
            else:
                wfile.write(line)
                wfile.flush()

    do_GET = _relay
    do_POST = _relay
    do_PUT = _relay
    do_DELETE = _relay


def record_outcome(task, result):
    """Append one task outcome beside the usage rows; the join key is the task id."""
    if not TASK_RE.fullmatch(task) or result not in OUTCOMES:
        sys.exit(f"usage: {sys.argv[0]} outcome <task> {'|'.join(OUTCOMES)}")
    root = os.environ.get("XDG_STATE_HOME", "").strip() or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    directory = os.path.join(root, "ccmorph")
    os.makedirs(directory, mode=0o700, exist_ok=True)
    row = {"task": task, "outcome": result,
           "timestamp": datetime.datetime.now(datetime.timezone.utc).isoformat()}
    fd = os.open(os.path.join(directory, "outcomes.jsonl"),
                 os.O_WRONLY | os.O_CREAT | os.O_APPEND, 0o600)
    with os.fdopen(fd, "a") as fh:
        fh.write(json.dumps(row, separators=COMPACT) + "\n")


def report(days):
    """Read-only spend window and verdict cohort; accepted costs span the whole task."""
    root = os.environ.get("XDG_STATE_HOME", "").strip() or os.path.join(
        os.path.expanduser("~"), ".local", "state")
    base = os.path.join(root, "ccmorph")

    def model_id(value):
        # The shim strips the context suffix before sending a model upstream.
        if not isinstance(value, str) or not value:
            return None
        return value[:-4] if value.endswith("[1m]") else value

    def label(value):
        # Upstream model names are untrusted; keep controls out of terminal output.
        return value if value.isprintable() else json.dumps(value, ensure_ascii=True)

    def timestamp(value):
        when = datetime.datetime.fromisoformat(value)
        return when if when.tzinfo is not None else when.replace(tzinfo=datetime.timezone.utc)

    now = datetime.datetime.now(datetime.timezone.utc)
    try:
        if not days > 0:
            raise ValueError
        since = now - datetime.timedelta(days=days)
    except (ValueError, OverflowError):
        sys.exit(f"usage: {sys.argv[0]} report [--days N]")
    total = unknown = 0
    by_model, final, task_cost, unpriced = {}, {}, {}, set()
    usage_dir = os.path.join(base, "usage")
    try:
        names = sorted(os.listdir(usage_dir))
    except OSError:
        names = ()
    for name in names:
        if not name.endswith(".json"):
            continue  # the atomic writer's .json.<pid>.<thread>.tmp is not committed
        try:
            with open(os.path.join(usage_dir, name)) as fh:
                row = json.load(fh)
            when = timestamp(row["timestamp"])
            if not isinstance(row.get("usage"), dict) or when > now:
                continue
            attempt = row.get("attempt", 1)
            if isinstance(attempt, bool) or not isinstance(attempt, int) or attempt < 1:
                continue
        except (OSError, ValueError, KeyError, TypeError, AttributeError, RecursionError):
            continue
        c = usage_buckets(row["usage"]).get("cost")
        task = row.get("task")
        if isinstance(task, str) and TASK_RE.fullmatch(task):
            # Whole-task accounting is independent of the spend window. Equal
            # attempts are ordered by response time, never response-hash filenames.
            order = (attempt, when)
            if task not in final or order > final[task]:
                final[task] = order
            if c is None or row.get("complete") is not True:
                unpriced.add(task)
            if c is not None:
                task_cost[task] = task_cost.get(task, 0) + c
        if when < since:
            continue
        if c is None:
            unknown += 1
            continue
        # New rows record the actual outbound model. Older rows only recorded
        # response_model; requested_model is never evidence of a served identity.
        model = model_id(row.get("served_model")) or model_id(row.get("response_model"))
        total += c
        by_model[model or "(unknown)"] = by_model.get(model or "(unknown)", 0) + c

    history = {}  # last valid row in file order is the verdict, with its date
    try:
        with open(os.path.join(base, "outcomes.jsonl"), "rb") as fh:
            for line in fh:
                try:
                    o = json.loads(line.decode("utf-8"))
                    task, outcome, when = o["task"], o["outcome"], timestamp(o["timestamp"])
                    if (not isinstance(task, str) or not TASK_RE.fullmatch(task)
                            or outcome not in OUTCOMES or when > now):
                        continue
                    history.setdefault(task, []).append((outcome, when))
                except (ValueError, KeyError, TypeError, RecursionError):
                    continue
    except OSError:
        pass

    def pct(part, whole):
        return "n/a" if not whole else "{:.1f}%".format(100.0 * part / whole)

    print("ccmorph routing report, last {:g} day(s)".format(days))
    print("total spend ${:.2f}".format(total))
    print("unknown spend {} rows (no cost reported, not estimated)".format(unknown))
    print("spend by served model")
    for k, v in sorted(by_model.items(), key=lambda kv: -kv[1]):
        print("  {}  ${:.2f}".format(label(k), v))
    print("\ntasks with outcomes")
    tasks = [t for t, events in history.items() if events[-1][1] >= since]
    if tasks:
        accepted = [t for t in tasks if history[t][-1][0] == "accepted"]
        known = accepted and all(t in task_cost and t not in unpriced for t in accepted)
        spend = sum(task_cost.get(t, 0) for t in accepted)
        first = [t for t in accepted if t in final and final[t][0] == 1
                 and all(o == "accepted" for o, _ in history[t])]
        esc = [t for t in tasks if any(o == "escalated" for o, _ in history[t])]
        print("  accepted {}  {}/task  first-pass {}  escalated {}".format(
            len(accepted), "${:.2f}".format(spend / len(accepted)) if known else "n/a",
            pct(len(first), len(tasks)), pct(len(esc), len(tasks))))


class LoopbackServer(ThreadingHTTPServer):
    """ThreadingHTTPServer without HTTPServer.server_bind's socket.getfqdn: that
    is a reverse DNS lookup of 127.0.0.1, which can stall startup for tens of
    seconds on macOS, and the banner (the adapter's readiness signal) waits on
    it. The shim binds loopback only and never uses the name it would find."""

    def server_bind(self):
        socketserver.TCPServer.server_bind(self)
        self.server_name, self.server_port = self.server_address[:2]


def main():
    if sys.argv[1:2] == ["report"]:
        rest = sys.argv[2:]
        try:
            days = float(rest[1]) if rest[:1] == ["--days"] and len(rest) == 2 else 1.0 if not rest else -1
            if not days > 0:
                raise ValueError
        except ValueError:
            sys.exit(f"usage: {sys.argv[0]} report [--days N]")
        return report(days)
    if sys.argv[1:2] == ["outcome"]:
        if len(sys.argv) != 4:
            sys.exit(f"usage: {sys.argv[0]} outcome <task> {'|'.join(OUTCOMES)}")
        return record_outcome(sys.argv[2], sys.argv[3])
    # Flags are position-free so the existing "<port> <target>" call form,
    # and anything already invoking it, keeps working unchanged.
    args = [a for a in sys.argv[1:] if not a.startswith("--")]
    flags = {a for a in sys.argv[1:] if a.startswith("--")}
    parent_pid = [f.partition("=")[2] for f in flags if f.startswith("--parent-pid=")]
    unknown = flags - {"--preserve-tool-ids", "--random-device-id",
                       "--retry-transport"} \
        - {f"--parent-pid={p}" for p in parent_pid}
    if (unknown or len(args) != 2 or len(parent_pid) > 1
            or (parent_pid and not re.fullmatch(r"[0-9]+", parent_pid[0]))):
        sys.exit(f"usage: {sys.argv[0]} <port> <target> [--preserve-tool-ids] "
                 "[--random-device-id] [--retry-transport] [--parent-pid=<pid>]")
    port = int(args[0])
    target = args[1]
    IdShim.target = target
    route_spec = os.environ.get("CCMORPH_MODEL_ROUTE")
    IdShim.model_routes = ModelRoutes(json.loads(route_spec)) if route_spec else None
    inbound = os.environ.get("CCMORPH_INBOUND")
    IdShim.inbound = json.loads(inbound) if inbound else None
    global HOOKS
    hooks_path = os.environ.get("CCMORPH_SHIM_HOOKS", "").strip()
    if hooks_path:
        HOOKS = load_hooks(hooks_path)
    IdShim.preserve_ids = "--preserve-tool-ids" in flags
    IdShim.random_device_id = "--random-device-id" in flags
    IdShim.retry_transport = "--retry-transport" in flags
    IdShim.breaker = Breaker() if IdShim.retry_transport else None
    server = LoopbackServer(("127.0.0.1", port), IdShim)
    server.daemon_threads = True
    if parent_pid:
        # ccmorph-adapter's contract: die with the launcher even under SIGKILL,
        # which no in-process cleanup can cover (killed suite runs left shims
        # listening 12-17 h). os._exit: an orphaned shim has nothing to flush.
        watched = int(parent_pid[0])

        def _watch_parent():
            while True:
                time.sleep(2)
                try:
                    os.kill(watched, 0)
                except OSError:
                    os._exit(0)

        threading.Thread(target=_watch_parent, daemon=True).start()
    print(f"gateway-shim :{server.server_address[1]} -> {target}", flush=True)
    server.serve_forever()


if __name__ == "__main__":
    main()
