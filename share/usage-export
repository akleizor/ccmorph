#!/usr/bin/env python3
"""Export metadata-only ccmorph receipts for ccusage, one project per profile.

Usage: usage-export --output ROOT [--since YYYYMMDD]
Then, with ccusage installed:
CLAUDE_CONFIG_DIR=ROOT ccusage claude daily --instances --config ROOT/ccusage.json

Before the first session there is no receipt to export: such a run exports
nothing, says that no session has written a receipt yet, and ccusage has no
usage data of this store's to price until one has — launch a session with
ccmorph run <profile> and run the export again.

A turn the gateway billed carries that cost; a turn the shim priced itself carries
usage.estimated_cost, a models.dev list price without context tiers, and is marked
costSource "estimate"; ccusage prices every other turn at its list price (a model
ccusage has no price for shows as missingPricing there). Days are local-time days.
Omit --since for a complete historical export: each run is a snapshot of its range, so an
owned daily file no receipt supports any more is removed, while earlier days and other
files stay; the receipts themselves are never touched. No transcript or credential is read.
"""
import argparse
from contextlib import nullcontext
import datetime as dt
import errno
import fcntl
import hashlib
import json
import math
import os
from pathlib import Path
import re
import shlex
import shutil
import stat
import tempfile
import time

BUCKETS = ("input_tokens", "cache_creation_input_tokens", "cache_read_input_tokens", "output_tokens")
# The profile name is the project label ccusage prints, cut to its head at a narrow
# terminal, and the folder name; anything else in it is replaced (#383).
UNSAFE = re.compile(r"[^A-Za-z0-9._-]")
# The file that marks a projects/ folder as this exporter's own: the folder name is
# the profile alone now (#383), so ownership can no longer be read from the name, and
# the output is a ccusage config dir a live Claude Code may write its own project
# folders into — those must never be reconciled. ccusage reads day files only, so a
# file with another name is invisible to it.
MARKER = ".ccmorph-export"
DAY_FILE = re.compile(r"\d{4}-\d{2}-\d{2}\.jsonl")
# A sharded receipt folder: one UTC date, the receipt's own stamp's day (#227).
DAY_DIR = re.compile(r"\d{4}-\d{2}-\d{2}")
# The largest dollar amount a float still holds to the cent, shim's own
# COST_LIMIT: its bucket filter keeps a receipt's cost only below it, so this reader
# refuses the same range instead of billing a number the writer would never store.
COST_LIMIT = 2 ** 53 / 100

# How long the export waits for the store's shared lock. A compaction holds the
# exclusive lock across its whole run, and a year export queued behind it is the
# hang INTENT 8 forbids: past this bound the export refuses with a named reason
# (paths.UsageLockWait is the Go readers' same bound, #654).
LOCK_WAIT = 1.0


def lock_shared(file):
    """Take the store's shared lock within LOCK_WAIT, or refuse a busy store."""
    deadline = time.monotonic() + LOCK_WAIT
    while True:
        try:
            fcntl.flock(file.fileno(), fcntl.LOCK_SH | fcntl.LOCK_NB)
            return
        except OSError as exc:
            if exc.errno not in (errno.EWOULDBLOCK, errno.EAGAIN):
                raise
            if time.monotonic() >= deadline:
                raise ValueError("usage store busy; retry after compaction finishes") from exc
            time.sleep(0.01)


def finite(value):
    # math.isfinite raises OverflowError for an int too large for a float; such a
    # number is no billable number (the shim's bucket filter drops it, #313), so a
    # stored one is damage, never a crash.
    try:
        return math.isfinite(value)
    except OverflowError:
        return False


def convert(row):
    if not row.get("complete"):
        return None
    if row.get("schema") != 1 or not isinstance(row.get("response_id"), str) or not row["response_id"]:
        raise ValueError("invalid complete receipt")
    stamp = dt.datetime.fromisoformat(row["timestamp"].replace("Z", "+00:00"))
    if stamp.tzinfo is None:
        raise ValueError("receipt timestamp needs a timezone")
    requested, served, answered = (row.get("requested_model"), row.get("served_model"),
                                   row.get("response_model"))
    # A mapped profile answers with the picker's alias while the recorded served id is
    # what actually ran: only when those differ past one trailing [1m] either side does
    # the served model carry the cost and the grouping. Every other row keeps the
    # response/requested identity it has always exported with.
    requested_bare = requested[:-4] if isinstance(requested, str) and requested.endswith("[1m]") else requested
    served_bare = served[:-4] if isinstance(served, str) and served.endswith("[1m]") else served
    if (isinstance(served_bare, str) and served_bare and isinstance(requested_bare, str) and requested_bare
            and served_bare != requested_bare):
        model = served_bare
    else:
        model = answered or requested
    if not isinstance(model, str) or not model:
        raise ValueError("receipt model is missing")
    if row.get("profile") is not None and not isinstance(row.get("profile"), str):
        raise ValueError("receipt profile is not a name")
    usage = row.get("usage") or {}
    tokens = {k: usage.get(k) or 0 for k in BUCKETS}
    if any(type(v) not in (int, float) or not finite(v) or v < 0 for v in tokens.values()):
        raise ValueError("invalid token count")
    cost = usage.get("cost")
    source = "gateway"
    if cost is None:
        # The shim priced this turn itself, at the provider's models.dev list
        # price (no context tiers): its own key, named as an estimate, never billed.
        cost = usage.get("estimated_cost")
        # Neither kind of price: ccusage prices it from its own list prices,
        # which is what a key at the provider would be charged.
        source = "estimate" if cost is not None else "list"
    if cost is not None and (type(cost) not in (int, float) or not finite(cost) or cost < 0
                             or cost >= COST_LIMIT):
        # A price no writer would store, in either field. The shim's bucket filter
        # keeps a receipt's cost only as a finite number below COST_LIMIT (#313), so
        # anything else a receipt carries — an int too large for a float, a value at
        # or past the limit (a reference price this high takes a token count no turn
        # produced), not a number at all, or a negative one — was damaged after the
        # fact. One guard for both fields, so a check added for one cannot miss its
        # sibling: #68 had the too-large check on the billed cost alone, so the same
        # damage in estimated_cost, the field #51 added, took the whole export down
        # where cost was counted unpriced. Report the row unpriced — never bill
        # a corrupt value, never lose the export to it — and a bound on every
        # exported cost is what keeps the total inside the float range, however
        # many such rows arrive.
        return stamp, None
    # A turn token distinguishes recycled ids even when timestamps collide.
    # Keep the historical identity unchanged for receipts without a token.
    # The join itself is util.ResponseKey's spelling (util/identity.go),
    # mirrored here in Python: id, stamp as written, and turn only when it has
    # one, joined by NUL. The Go side owns the definition — a change there is
    # a change here — so this export counts a response the store holds under
    # two names once, the way the Go readers do.
    identity = row["response_id"] + "\0" + row["timestamp"]
    if isinstance(row.get("turn_id"), str) and row["turn_id"]:
        identity += "\0" + row["turn_id"]
    key = hashlib.sha256(identity.encode()).hexdigest()
    record = {
        # ccusage reads only a UTC `Z` stamp; an offset spelling drops the row unread.
        "timestamp": stamp.astimezone(dt.timezone.utc).strftime("%Y-%m-%dT%H:%M:%S.")
                     + f"{stamp.microsecond // 1000:03d}Z",
        "sessionId": row.get("task") or "unknown",
        "requestId": key, "type": "assistant",
        "message": {"role": "assistant", "id": key, "model": model, "usage": tokens},
        # The recorded identities are copied verbatim, so a mapped row keeps the
        # picker's id next to what actually answered.
        "ccmorph": {"profile": row.get("profile"), "task": row.get("task"),
                     "attempt": row.get("attempt"), "costSource": source,
                     "requestedModel": requested if isinstance(requested, str) else None,
                     "servedModel": served if isinstance(served, str) else None,
                     "responseModel": answered if isinstance(answered, str) else None},
    }
    if cost is not None:
        record["costUSD"] = cost
    return stamp, record


def atomic_write(path, text):
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    fd, name = tempfile.mkstemp(dir=path.parent, prefix=".usage-")
    try:
        with os.fdopen(fd, "w") as out:
            out.write(text)
        os.replace(name, path)
    finally:
        if os.path.exists(name):
            os.unlink(name)


def is_ours(folder):
    """The marker file, not the folder's name, says a folder is this exporter's: the
    name is the profile alone (#383), and a config dir may hold a live Claude Code's
    own project folders, which are never ours to reconcile. A symlinked marker is
    not read: only a regular file this exporter wrote counts."""
    marker = folder / MARKER
    return not marker.is_symlink() and marker.is_file()


def own(folder):
    """Mark a profile folder as this exporter's before its first day file lands: the
    marker, not the name, is what a later run reconciles by (#383)."""
    folder.mkdir(parents=True, exist_ok=True, mode=0o700)
    try:
        os.close(os.open(folder / MARKER, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
    except FileExistsError:
        pass  # ours already, or another run marked it first


def claimed(folder):
    """A folder this exporter treats as its own to reconcile: one that carries its
    marker, or the `ccmorph-<profile>` naming an export before #383 wrote. The folders
    a run may write into are exactly the folders it would reconcile, so a folder that
    is neither — a live Claude Code's own project folder in the config dir, or anything
    a hand placed there — is never written into either, however much it looks like a
    destination (#383)."""
    return folder.name.startswith("ccmorph-") or is_ours(folder)


def owned_days(projects):
    """The day files this exporter owns, each with the stamp it had: a regular file named
    YYYY-MM-DD.jsonl for a real calendar date, directly in a folder this exporter claims,
    so a rerun reconciles what earlier naming left behind. A symlink, another name or
    another folder is never ours, however much it looks like an export."""
    days = {}
    try:
        folders = list(projects.iterdir())
    except OSError:
        return days  # no projects dir yet, or one this run cannot read: nothing to reconcile
    for folder in folders:
        if folder.is_symlink() or not folder.is_dir():
            continue
        if not claimed(folder):
            continue
        for entry in os.scandir(folder):
            if not DAY_FILE.fullmatch(entry.name) or not entry.is_file(follow_symlinks=False):
                continue
            try:
                dt.date.fromisoformat(entry.name[:10])
                stamp = entry.stat().st_mtime_ns
            except (ValueError, OSError):
                continue  # not a calendar date, or gone before it could be stamped
            days[(folder.name, entry.name[:10])] = stamp
    return days


def plain(exc):
    """An OSError as a person reads it: the path and what is wrong with it, never
    Python's own "[Errno N] ..." spelling (#647). A move names both paths, and
    the destination is the one that blocked the write, so it is kept last (#647)."""
    what = exc.strerror or "cannot be read"
    where = exc.filename if exc.filename is not None else "a receipt file"
    destination = getattr(exc, "filename2", None)
    if destination is not None:
        return f"{where} -> {destination}: {what}"
    if isinstance(exc, FileNotFoundError):
        return f"{where} is missing"
    return f"{where}: {what}"


def read_regular(path):
    """A store file's bytes, opened without ever waiting on the open: O_NONBLOCK
    keeps a FIFO or device left under a receipt's name from holding the run and
    its store lock (INTENT 8, #654), and anything but a regular file is refused
    by name — the refusal util/paths.OpenRegular gives the Go readers. A name
    that is gone still raises FileNotFoundError, the store's relocation."""
    fd = os.open(path, os.O_RDONLY | os.O_NONBLOCK | getattr(os, "O_CLOEXEC", 0))
    try:
        if not stat.S_ISREG(os.fstat(fd).st_mode):
            raise OSError(errno.EINVAL, "not a regular file", str(path))
        chunks = []
        while True:
            chunk = os.read(fd, 1 << 20)
            if not chunk:
                return b"".join(chunks)
            chunks.append(chunk)
    finally:
        os.close(fd)


def archive_rows(path):
    """Raw rows and original filenames from one hash-bound archive generation."""
    try:
        data = read_regular(path)
        index = json.loads(read_regular(Path(str(path) + ".idx")).decode("utf-8"))
        lines = data.split(b"\n") if data else []
        if data:
            if lines[-1] != b"":
                raise ValueError("missing final newline")
            lines.pop()
        if index["v"] != 1:
            raise ValueError("unsupported index version")
        digest = hashlib.sha256(data).hexdigest()
        generation = index if index["sha256"] == digest else index.get("previous", {})
        if generation.get("sha256") != digest:
            raise ValueError("index does not match content")
        files = generation["files"]
        if len(files) != len(lines):
            raise ValueError("index does not match row count")
        names = [f["name"] for f in files]
        if any(not isinstance(n, str) or Path(n).name != n or not n.endswith(".json") for n in names) or names != sorted(set(names)):
            raise ValueError("invalid receipt names")
        if any(not isinstance(f["mtime_ns"], int) or isinstance(f["mtime_ns"], bool) for f in files):
            raise ValueError("invalid receipt modification times")
        return {name: (line, f["mtime_ns"]) for name, line, f in zip(names, lines, files)}
    except OSError as exc:
        raise ValueError(f"archive {path.name}: {plain(exc)}") from exc
    except (ValueError, KeyError, TypeError) as exc:
        raise ValueError(f"archive {path.name}: {exc}") from exc


def same_named_rows(old_data, new_data):
    """util/paths.SameNamedRows is the store's one merge rule, mirrored here
    (#654, #804): two rows that share a file name are one turn, and the newer
    one wins, only when their identity agrees — a non-empty response_id both
    hold, a turn_id that must match whenever it is there, and an empty turn
    only when both rows carry equal string timestamps. A non-finite token
    parses as a number no member string can equal — the Go readers normalize it
    to null before comparing, and a member that is not a string is not a
    match — so it keeps both. A side that does not parse to a JSON object at
    all — bytes that are truncated, or a bare scalar a crashed write left — is
    not the same turn as anything either: the owner checks that shape once, and
    so does this mirror, instead of calling a member accessor on whatever came
    back and raising here inside the generator, where export's per-receipt
    handler cannot see it."""
    if old_data == new_data:
        return True  # util/paths' bytes.Equal first check: no parse needed
    try:
        old = json.loads(old_data, parse_constant=float)
        new = json.loads(new_data, parse_constant=float)
    except (ValueError, TypeError):
        return False
    if not isinstance(old, dict) or not isinstance(new, dict):
        return False
    rid, turn = old.get("response_id"), old.get("turn_id", "")
    new_turn = new.get("turn_id", "")
    return (isinstance(rid, str) and bool(rid) and rid == new.get("response_id")
            and isinstance(turn, str) and isinstance(new_turn, str) and turn == new_turn
            and (turn or (isinstance(old.get("timestamp"), str)
                          and old.get("timestamp") == new.get("timestamp"))))


def receipt_rows(root, since):
    """Folder and archived receipts in original path order, under the store move lock.
    A listed receipt whose name is gone by its read comes back with data None (#583);
    one still there that cannot be read comes back with its OSError as data (#654)."""
    first = since.astimezone(dt.timezone.utc).strftime("%Y-%m-%d") if since else ""
    def create_lock():
        try:
            return os.fdopen(os.open(root / ".move.lock", os.O_CREAT | os.O_RDWR, 0o600), "rb")
        except OSError as exc:
            if exc.errno not in (errno.EACCES, errno.EROFS):
                raise
            return None  # A read-only legacy store cannot start a compactor either.

    try:
        lock = open(root / ".move.lock", "rb")
    except FileNotFoundError:
        try:
            lock = create_lock()
        except FileNotFoundError:
            # Before the first session the store folder itself does not exist (#647):
            # nothing to read, and a reader leaves no trace, so this is an empty store.
            return
    except OSError as exc:
        if exc.errno not in (errno.EACCES, errno.EROFS):
            raise
        # A lock file this run cannot open — a root-owned one a sudo'd
        # compaction left — must not poison every export forever. It is never
        # unlinked: a permission failure cannot show the holder is stale, and a
        # replacement inode would let readers and a live compactor stop
        # excluding each other. The export reads without a lock, as the Go
        # readers do; the archives are hash-bound and merged with the folder.
        lock = None
    with lock if lock is not None else nullcontext():
        if lock is not None:
            lock_shared(lock)
        days, flat = set(), []
        with os.scandir(root) as entries:
            for entry in entries:
                name = entry.name
                if entry.is_dir(follow_symlinks=False) and DAY_DIR.fullmatch(name):
                    if name >= first:
                        days.add(name)
                elif entry.is_file(follow_symlinks=False):
                    if (DAY_FILE.fullmatch(name) or (name.endswith(".jsonl.idx") and DAY_FILE.fullmatch(name[:-4]))) and name[:10] >= first:
                        days.add(name[:10])
                    elif name.endswith(".json"):
                        flat.append(Path(entry.path))
        # Day folders first, flat receipts last: a response the store holds under both
        # names counts by its day folder's copy, the copy quota and the report count
        # too (#654). A plain name sort put a flat name such as 0abc.json first.
        sources = [(day, True) for day in sorted(days)] + [(p.name, False) for p in sorted(flat)]
        for name, is_day in sources:
            if not is_day:
                path = root / name
                try:
                    data = read_regular(path)
                except FileNotFoundError:
                    # A listed name that is gone by its read was relocated, not lost —
                    # the pre-shard move's link-then-remove (#513) — so it comes back
                    # with no bytes and export counts it and skips it, the skip #552
                    # taught the Go readers (#583).
                    yield path, None
                    continue
                except OSError as exc:
                    # Still there and not readable (mode 0, a FIFO under its name):
                    # handed to export, which names it and writes nothing (#654).
                    yield path, exc
                    continue
                yield path, data
                continue
            path = root / (name + ".jsonl")
            if path.exists():
                rows = archive_rows(path)
            elif not Path(str(path) + ".idx").exists():
                rows = {}  # no archive at all: the folder is the day
            elif (root / name).is_dir():
                # A first publication that died between its index and its content leaves
                # an index over no content: the folder holds that day whole, so the
                # index is garbage, not a promise — the same heal the Go readers apply.
                rows = {}
            else:
                rows = archive_rows(path)  # An index over no content and no folder is damage, named.
            folder = root / name
            conflicts = []
            if folder.is_dir():
                with os.scandir(folder) as entries:
                    for entry in entries:
                        # A FIFO or device under a receipt's name is not skipped
                        # in silence: read_regular names it, as the Go readers do
                        # (#654). A symlink stays outside the store, as before.
                        if (entry.name.endswith(".json") and not entry.is_dir(follow_symlinks=False)
                                and not entry.is_symlink()):
                            try:
                                data = read_regular(entry.path)
                                mtime = entry.stat().st_mtime_ns
                            except FileNotFoundError:
                                # Compaction (#642) removed this name after the listing: skipped as above (#583).
                                yield Path(entry.path), None
                                continue
                            except OSError as exc:
                                yield Path(entry.path), exc  # not readable: named by export (#654)
                                continue
                            previous = rows.get(entry.name)
                            if previous is not None:
                                old_data, old_mtime = previous
                                if not same_named_rows(old_data, data):
                                    # A row that is not the same turn is kept beside its
                                    # sibling and skipped when the export reads it, the Go
                                    # readers' reading (#654).
                                    conflicts.append((entry.name, previous))
                                elif old_mtime > mtime:
                                    continue
                            rows[entry.name] = (data, mtime)
            for receipt_name, (data, _) in sorted(list(rows.items()) + conflicts):
                yield folder / receipt_name, data


def export(root, output, since=None):
    days, seen = {}, set()
    unpriced = 0
    moved = 0
    unreadable = []
    # The days this rerun reconciles are the ones already exported when it started, each with
    # the stamp it had then: a day another run writes while this one reads receipts belongs to
    # that run's snapshot, so it is not this run's to remove.
    projects = output / "projects"
    marked = owned_days(projects)
    for path, data in receipt_rows(root, since):
        if data is None:
            # The listing named this receipt and the store moved it before its read: a
            # relocation, not damage, so the run skips it and counts it (#583).
            moved += 1
            continue
        if isinstance(data, OSError):
            # A receipt still there that this run cannot read is named and left out of
            # every count, the reading quota and the report give the same store (#654).
            unreadable.append(plain(data))
            continue
        # A Python writer wrote a bad cost as a bare NaN/Infinity token; parsing it
        # as the float it stands for lets convert's damaged-cost guard count the
        # turn unpriced, instead of the parser refusing the token and the whole
        # export with it — the reading the Go readers give the same row (#654).
        try:
            row = json.loads(data, parse_constant=float)
        except ValueError:
            continue  # truncated, zero-byte or otherwise unparseable: one row, never the run
        if not isinstance(row, dict):
            # A bare scalar is not a receipt either: util/paths.parseDoc's one
            # rule for every Go reader — nil unless the bytes are a JSON object
            # — so it is skipped as the same unparseable row, never read for
            # members it does not have (#804).
            continue
        try:  # every receipt in range is parsed: its own stamp decides the range
            converted = convert(row)
        except (ValueError, KeyError, TypeError) as exc:
            raise ValueError(f"{os.path.relpath(path, root)}: {exc}") from exc
        if converted is None:
            continue
        stamp, record = converted
        # The requested day range is a property of the receipt, so it is applied to
        # every outcome before any statistic counts it.
        if since and stamp < since:
            continue
        if record is None:
            # A damaged cost: no record to export, only a count.
            unpriced += 1
            continue
        key = record["requestId"]
        if key in seen:
            continue
        seen.add(key)
        # The profile name is the whole label, so nothing constant eats the width a
        # narrow terminal leaves it (#383); a profile that is no folder (only damage
        # writes one — a name is letters, digits and underscores) lands with the
        # profile-less.
        folder = UNSAFE.sub("_", record["ccmorph"]["profile"] or "unknown")
        if folder in (".", ".."):
            folder = "unknown"
        days.setdefault((folder, stamp.astimezone().strftime("%Y-%m-%d")), []).append(record)
    # Validate the whole input before replacing any prior export — and the output too:
    # a destination folder that is already there and not this exporter's is never taken
    # over by being written into, because the marker the write leaves would make a later
    # run remove that folder's other day files too (#383). The collision fails the whole
    # export before anything is written, naming the folder as a malformed receipt is
    # named: the folder keeps its owner.
    for folder in dict.fromkeys(folder for folder, _ in days):
        target = projects / folder
        if target.is_symlink() or (target.exists() and not claimed(target)):
            raise ValueError(f"projects/{folder} already exists and is not this exporter's")
    rows = [r for records in days.values() for r in records]
    # The three priced kinds are the whole export, so a reader can reconcile the
    # counts: gateway + estimate + list is rows (#382).
    stats = {"rows": len(seen), "days": len({d for _, d in days}), "unpriced": unpriced,
             "moved": moved, "unreadable": unreadable,
             # usd is what a gateway itself billed; an estimate is its own total.
             "usd": sum(r.get("costUSD", 0) for r in rows if r["ccmorph"]["costSource"] == "gateway"),
             "estimated_usd": sum(r.get("costUSD", 0) for r in rows if r["ccmorph"]["costSource"] == "estimate"),
             "gateway_rows": sum(r["ccmorph"]["costSource"] == "gateway" for r in rows),
             "estimated_rows": sum(r["ccmorph"]["costSource"] == "estimate" for r in rows),
             "list_rows": sum(r["ccmorph"]["costSource"] == "list" for r in rows)}
    if unreadable:
        # A day file is rewritten whole and a day no receipt supports is removed, so a
        # run that could not read every receipt would drop the unread turns from the
        # export already there. It writes nothing: that export stands, and the counts
        # are what this run could read (#654).
        return stats
    for (folder, day), records in days.items():
        own(projects / folder)
        atomic_write(projects / folder / f"{day}.jsonl",
                     "".join(json.dumps(r, separators=(",", ":")) + "\n" for r in sorted(records, key=lambda r: r["timestamp"])))
    # A snapshot of this run's range: an owned day no usable receipt supports any more goes,
    # so the summary and what the consumer reads agree. Earlier days, days another run has
    # written since, and every file this exporter does not own are left alone.
    first = since.strftime("%Y-%m-%d") if since else ""
    for (folder, day), stamp in marked.items():
        if (folder, day) in days or day < first:
            continue
        path = projects / folder / f"{day}.jsonl"
        try:
            if path.stat().st_mtime_ns == stamp:
                path.unlink()
        except FileNotFoundError:
            pass  # another run removed it first: the wanted state is already there
    # ccusage refuses a config dir without projects/, even for an empty range.
    projects.mkdir(parents=True, exist_ok=True, mode=0o700)
    # mode auto: a billed or estimated cost is used as is, every other turn is priced
    # by ccusage.
    config = {"defaults": {"mode": "auto", "breakdown": True}}
    atomic_write(output / "ccusage.json", json.dumps(config, indent=2) + "\n")
    return stats


def report(stats, output, source, first_session=False):
    """The end of an export, for the person who ran it: which folder was read and
    where the files went, every count by a name that adds up, money at cents, and
    the exact command that reads the result — not a machine's JSON line (#382).
    The source is printed beside the destination (GH-843): an export of the wrong
    folder and an export of an empty one looked identical without it. And when
    ccusage is not on PATH, the summary says it is missing — no install route
    provides it (README, Requirements), so printing its command was a printed
    step that could not run (GH-843). first_session marks the third state
    GH-843 left silent: the store folder does not exist because no session
    has ever run, and the summary names that cause and the launch instead of
    a confident zero (GH-1033)."""
    root = os.path.abspath(output)
    # The source is resolved by following symlinks, not collapsed lexically: the
    # exporter walks a `..` through any symlink before it, and the printed folder
    # must name the very store the run read, not a lexical cousin that may not
    # exist (GH-843).
    read = os.path.realpath(source)

    def count(n, word):
        return f"{n} {word}" if n == 1 else f"{n} {word}s"

    unreadable = stats.get("unreadable") or []
    # GH-1033: the never-launched machine, and only it. An absent folder that
    # wrote no rows is the state the guide itself distinguishes — no session
    # has metered anything yet — while a present store that reads empty (or
    # empties out under --since) keeps GH-843's zero report: those zeros are
    # true readings, and a mid-run session that made rows makes this one true
    # too. The caller marks the flag for its resolved default source; an
    # explicit --source never reaches it, because a missing named folder is
    # the refusal, not the store.
    first_session = (bool(first_session) and not unreadable
                     and stats["rows"] == 0 and stats["days"] == 0)
    if unreadable:
        head = [f"Nothing written from {read} to {root}: {count(len(unreadable), 'receipt')} "
                "not readable, so the export already there stands",
                f"Read {count(stats['rows'], 'turn')} over {count(stats['days'], 'day')}; "
                "fix the receipts' permissions and run it again"]
    elif first_session:
        head = [f"Nothing exported from {read} to {root}: no session has written "
                "a receipt there yet",
                "launch one: ccmorph run <profile>, then run this export again",
                "one folder per profile under projects/, ccusage.json beside it"]
    else:
        head = [f"Exported {count(stats['rows'], 'turn')} over {count(stats['days'], 'day')} "
                f"from {read} to {root}",
                "one folder per profile under projects/, ccusage.json beside it"]
        if stats["days"]:
            # The one place a person reconciles the two stores: a receipt sits
            # under its UTC day and the day file under the local one, so the
            # same turn's numbers can read as two different dates (GH-971).
            # Said only when a day was written, and nothing is renamed.
            head.append("day files are named by local date, the receipt folders by UTC date: "
                        "a turn near midnight can sit under a different date in each")
    # Both paths shell-quoted, so a folder with spaces in its name does not
    # tear the command apart at the first space (#382).
    ccusage_cmd = (f"CLAUDE_CONFIG_DIR={shlex.quote(root)} ccusage claude daily --instances "
                   f"--config {shlex.quote(os.path.join(root, 'ccusage.json'))}")
    if shutil.which("ccusage") is None:
        tail = ["ccusage is not installed: no ccmorph install provides it; see the "
                "README's cost-reporting note, and --help prints the command to run"]
    elif first_session:
        # The command is not dead — this run merely had nothing to give it,
        # and the tail says so (GH-1033): the sentence is scoped to what this
        # run exported, because --output may still hold days an earlier
        # export wrote and this run's --since skipped (GH-971) — then where
        # the data will come from, and when to come back. The command stays
        # whole: it is the one line a person copies.
        tail = ["ccusage has no data from this run: no session has written a receipt yet",
                "launch one: ccmorph run <profile>, then run this export again",
                ccusage_cmd]
    else:
        tail = ["Then, with ccusage installed:", ccusage_cmd]
    return "\n".join(head + [
        f"{count(stats['gateway_rows'], 'turn')} the gateway billed, ${stats['usd']:.2f}",
        f"{count(stats['estimated_rows'], 'turn')} ccmorph estimated, ${stats['estimated_usd']:.2f}",
        f"{count(stats['list_rows'], 'turn')} left for ccusage to price at its list price",
        f"{count(stats['unpriced'], 'turn')} unpriced (a damaged cost, not exported)",
        f"{count(stats['moved'], 'receipt')} moved by the store mid-run, skipped",
    ] + tail)


def main():
    # RawDescriptionHelpFormatter keeps the authored lines: the ccusage command
    # stays on its own line, ready to copy, instead of reflowing into one
    # paragraph (#382).
    # #731: the default resolves against the XDG state root — the same root
    # paths.StateDir() gives the Go reader — which CCMORPH_STATE_DIR does not
    # move, so --help prints the folder a run would actually read instead of
    # naming "the state root", a phrase a CCMORPH_STATE_DIR user read as their
    # own root and found no receipts under. The path rides the description,
    # which the formatter keeps as authored: in option help argparse breaks a
    # long path mid-word, and a path that cannot be copied names no folder —
    # #382's lesson for the ccusage command line, applied to this one.
    default_source = (Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
                      / "ccmorph" / "usage")
    parser = argparse.ArgumentParser(
        description=__doc__ + f"\nDefault --source: {default_source}",
        formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--output", type=Path, required=True, metavar="ROOT",
                        help="directory the export lands in")
    # The default is resolved, not argparse's: a --source the person named must
    # exist (GH-843), while the default folder may be absent — before the first
    # session there is no store at all, and that is an empty one, not a mistake (#647).
    parser.add_argument("--source", type=Path, metavar="ROOT", default=None,
                        help="ccmorph receipt store to read; the default folder is named above")
    parser.add_argument("--since", metavar="YYYYMMDD",
                        help="first local date to export; default all history")
    args = parser.parse_args()
    since = None
    if args.since is not None:
        try:
            # Exactly eight digits before the calendar is read: strptime alone
            # accepts unpadded fields (2026111 as 2026-11-01), and an explicitly
            # empty value must not slip through as all history either (#382).
            if not re.fullmatch(r"[0-9]{8}", args.since):
                raise ValueError
            since = dt.datetime.strptime(args.since, "%Y%m%d").astimezone()
        except ValueError:
            # Name the format the person is asked for, not strptime's own.
            parser.exit(1, f"usage-export: --since '{args.since}' must be a date as "
                           "YYYYMMDD, for example 20261110\n")
    first_session = False
    if args.source is None:
        source = default_source  # a default folder that is absent is the empty store of #647
        # GH-1033: that empty store has a cause worth naming — no session has
        # ever run — and the default folder is the one state the guide's own
        # fresh install describes. Only true when the resolved default is
        # simply not a folder: a file at the path and a folder behind an
        # unsearchable parent keep export()'s named exit-1 refusal, and a
        # symlink through to a real folder reads as the present empty store,
        # because is_dir() follows it. The probe cannot be allowed to raise
        # the errno it is standing guard against — is_dir() propagates
        # EACCES — so the #843 guard shape covers it: when asking fails, this
        # is not the named state, and export() answers with its own refusal.
        try:
            first_session = not default_source.is_dir()
        except OSError:
            first_session = False
    else:
        try:
            folder = args.source.is_dir()
        except OSError as exc:
            # A parent that cannot be searched makes the probe itself fail: the
            # refusal names the folder the way every other OSError here is told
            # (#647), and the probe never becomes the traceback it stands guard
            # against (GH-843).
            parser.exit(1, f"usage-export: {plain(exc)}\n")
        if folder:
            source = args.source
        else:
            # A source named on the command line that is not a folder is a wrong path,
            # not an empty store: read as one it printed a successful "Exported 0 turns",
            # byte-identical to a store that genuinely holds nothing (GH-843).
            parser.exit(1, f"usage-export: no receipts folder at {args.source}\n")
    try:
        stats = export(source, args.output, since)
    except OSError as exc:
        parser.exit(1, f"usage-export: {plain(exc)}\n")
    except ValueError as exc:
        parser.exit(1, f"usage-export: {exc}\n")
    print(report(stats, args.output, source, first_session))
    if stats["unreadable"]:
        # Each receipt by name, the way every other refusal here is told (#647).
        parser.exit(1, "".join(f"usage-export: {name}\n" for name in stats["unreadable"]))


if __name__ == "__main__":
    main()
