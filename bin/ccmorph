#!/usr/bin/env zsh
# The one command. ccmorph is an ordinary executable on PATH: it sources its own
# library in its own process, launches Claude Code, and exits.
#
# It deliberately does NOT touch the user's shell. An earlier design shipped the
# whole tool as zsh functions, which meant the package could not put a working
# command on PATH — an installer must not edit a startup file, so a fresh install
# answered its own first documented step with "command not found". Overriding
# `claude` was the same mistake one level up: a switcher that shadows the tool it
# switches makes every session's behaviour depend on whether one file was sourced.
# Anyone who wants `claude` to mean "launch through ccmorph" can write that
# alias themselves; it is a personal convention, not this product.
#
# The library is found relative to this script (../lib) — or, for install.sh's
# layout, in the config roots the search below names — so it works from
# ~/.config/ccmorph and from a source checkout, with no wiring.
emulate -L zsh
set -eu

# Help, version and doctor must not source host opt-ins: local.sh is executable
# zsh and may mutate state. Detect read-only requests before loading the library.
# A help flag anywhere is a help request, except after a run profile, where the
# words are Claude Code's (ccmorph run <profile> --help is Claude's help).
case "${1:-}" in
  doctor|''|-h|--help|help|-v|-V|--version|version) export CCMORPH_DOCTOR_READONLY=1 ;;
  run)
    if [[ "${2:-}" == (-h|--help) ]]; then
      export CCMORPH_DOCTOR_READONLY=1
    fi
    ;;
  _*) ;;
  *)
    if (( ${@[(Ie)-h]} || ${@[(Ie)--help]} )); then
      export CCMORPH_DOCTOR_READONLY=1
    fi
    ;;
esac

# Follow a link on PATH back to the script itself.
self="${(%):-%x}"
while [[ -L "$self" ]]; do
  link="$(readlink "$self")"
  case "$link" in
    /*) self="$link" ;;
    *)  self="${self:h}/$link" ;;
  esac
done
here="${self:h:A}"

# An explicit CCMORPH_LIB_DIR is authoritative and FAILS when wrong, rather than
# quietly running a different library than the caller named. This is also the seam
# a running Claude Code session inherits, so `! ccmorph hop <account>` from inside
# a session reaches the same library that launched it.
if [[ -n "${CCMORPH_LIB_DIR:-}" ]]; then
  lib="$CCMORPH_LIB_DIR/ccmorph.sh"
  [[ -r "$lib" ]] || {
    print -u2 -- "ccmorph: CCMORPH_LIB_DIR is set but has no readable ccmorph.sh"
    print -u2 -- "  looked for: $lib"
    exit 1
  }
else
  lib=""
  # Where the runtime can live, in order: a source checkout or one-directory
  # install (lib/ beside bin/); install.sh's layout under the config dir the
  # CURRENT environment names; the lib dir the installer RECORDED beside this
  # command (`.ccmorph-libdir`); and the documented default $HOME/.config root.
  # The environment still goes first — exporting XDG_CONFIG_HOME and moving the
  # root is a real move — but it cannot be the only config root searched: the
  # installer wrote the runtime under the config dir as it saw it AT INSTALL
  # time, so a later run exporting the variable elsewhere searched a root
  # holding nothing and never the one holding everything, and every command —
  # even `ccmorph --version` — died before it could say anything (#834). The
  # record answers the mirrored case (an install made under an exported root,
  # run without it); the fixed default carries installs that predate the
  # record. CCMORPH_STATE_DIR names STATE, never code (see the two-directory
  # header of lib/ccmorph.sh), so it stays out of this search.
  typeset -a ccm_roots=(
    "$here/../lib"
    "${XDG_CONFIG_HOME:-$HOME/.config}/ccmorph/lib"
  )
  if [[ -r "$here/.ccmorph-libdir" ]]; then
    typeset ccm_recorded=""
    { read -r ccm_recorded < "$here/.ccmorph-libdir" } 2>/dev/null || :
    # Only an absolute path is a root: the installer writes one, and anything
    # else in this file is a mistake or a tamper, not a path to chase.
    [[ "$ccm_recorded" == /* ]] && ccm_roots+=( "$ccm_recorded" )
  fi
  ccm_roots+=( "$HOME/.config/ccmorph/lib" )
  for ccm_root in "${ccm_roots[@]}"; do
    [[ -r "$ccm_root/ccmorph.sh" ]] && { lib="${ccm_root}/ccmorph.sh"; lib="${lib:A}"; break }
  done
  [[ -n "$lib" ]] || {
    # Honest by construction: every root the loop above searched, in order,
    # each named once — roots spelling ONE directory (XDG_CONFIG_HOME unset:
    # the environment's root and the default root; a record pointing at the
    # environment's root) are ONE search and get one line, by their first
    # spelling, which is the environment's view.
    print -u2 -- "ccmorph: cannot find ccmorph.sh near $here"
    print -u2 -- "  looked in:"
    typeset -A ccm_named=()
    for ccm_root in "${ccm_roots[@]}"; do
      if [[ -z "${ccm_named[${ccm_root:A}]:-}" ]]; then
        ccm_named[${ccm_root:A}]=1
        print -u2 -- "             $ccm_root"
      fi
    done
    print -u2 -- "  Set CCMORPH_LIB_DIR to the directory holding ccmorph.sh."
    exit 1
  }
fi

# Hand the library its own directory explicitly, so a child session's `hop`
# reaches the same library that launched it.
CCMORPH_LIB_DIR="${lib:h}"
export CCMORPH_LIB_DIR

# `set -eu` belongs to this preamble only: the library and the launch it runs are
# long-lived interactive code with their own error handling, and inheriting -e
# would turn every non-zero probe into an aborted launch.
unsetopt err_exit nounset
source "$lib" || {
  print -u2 -- "ccmorph: failed to load $lib"
  exit 1
}

ccmorph "$@"
