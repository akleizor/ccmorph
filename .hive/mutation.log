            f"fpath=({site} $fpath)\nautoload -Uz compinit && compinit\nsleep 30\n")
        started = time.monotonic()
        result, _, _ = run_doctor(tmp_path, conf, claude=False,
                                  env_extra={"SHELL": shell, "ZDOTDIR": str(home),
